<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**;artifacts\**</DefaultItemExcludes>

    <!-- Audiophile Windows 11 Desktop Metadata -->
    <AssemblyName>AuraAudio</AssemblyName>
    <Product>AuraAudio Desktop Music Player</Product>
    <Company>AuraAudio SoundLab</Company>
    <Description>Bit-Perfect WASAPI Exclusive Audiophile Desktop Music Player for Windows 11</Description>
    <Version>2.0.1</Version>
    <FileVersion>2.0.1.0</FileVersion>
    <AssemblyVersion>2.0.1.0</AssemblyVersion>

    <!-- Application Icon (Win32 Executable & Taskbar) -->
    <ApplicationIcon>Assets\AuraAudio.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Standalone Single-File Deployment Configuration (enable via -p:AuraStandalonePublish=true) -->
  <PropertyGroup Condition="'$(AuraStandalonePublish)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AuraAudio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\AuraAudio.ico" />
    <Resource Include="Assets\AuraAudio.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BunLabs.NAudio.Flac" Version="2.0.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
