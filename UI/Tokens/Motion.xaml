<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =======================================================================
         MOTION & SPRING TIMING TOKENS (apple-design + 03_design_spec.md)
         ======================================================================= -->

    <Duration x:Key="Duration.Instant">0:0:0.10</Duration>
    <Duration x:Key="Duration.Fast">0:0:0.15</Duration>
    <Duration x:Key="Duration.Normal">0:0:0.20</Duration>
    <Duration x:Key="Duration.Slow">0:0:0.30</Duration>

    <sys:Double x:Key="Spring.Damping.Critical">1.0</sys:Double>
    <sys:Double x:Key="Spring.Response.Press">0.12</sys:Double>
    <sys:Double x:Key="Spring.Response.Release">0.22</sys:Double>
    <sys:Double x:Key="Spring.Response.Sheet">0.24</sys:Double>
    <sys:Double x:Key="Spring.Response.Rail">0.26</sys:Double>
    <sys:Double x:Key="Spring.Response.Panel">0.28</sys:Double>
    <sys:Double x:Key="Spring.Response.Stage">0.34</sys:Double>
    <sys:Double x:Key="Spring.Response.ReducedCrossFade">0.14</sys:Double>
    <sys:Double x:Key="Spring.Response.LyricsScroll">0.42</sys:Double>
    <sys:Double x:Key="Spring.Response.LyricsEmphasis">0.26</sys:Double>
    <sys:Double x:Key="Spring.Response.LyricsWheel">0.18</sys:Double>

</ResourceDictionary>
