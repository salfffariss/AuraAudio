<UserControl x:Class="AuraAudio.UI.Views.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AuraAudio.UI.ViewModels"
             x:Name="Root"
             AutomationProperties.AutomationId="Aura.Lyrics.List"
             AutomationProperties.Name="Lyrics"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- =================================================================
             STATE 1: NO SONG PLAYING
             ================================================================= -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Visibility="{Binding Lyrics.IsNoSong, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="44" Height="44"
                    CornerRadius="22"
                    Background="{StaticResource Brush.Elevated}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <Path Width="18" Height="18" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{StaticResource Brush.Icon.Muted}"
                      StrokeThickness="1.5"
                      Data="M6,14 A2,2 0 1 1 2,14 A2,2 0 1 1 6,14 M6,14 L6,3 L15,1.5 L15,12 M15,12 A2,2 0 1 1 11,12 A2,2 0 1 1 15,12" />
            </Border>
            <TextBlock Text="No Track Playing"
                       Style="{StaticResource Text.Headline}"
                       Foreground="{StaticResource Brush.Text.Primary}"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,4" />
            <TextBlock Text="Play a track to display synced or embedded lyrics."
                       Style="{StaticResource Text.Callout}"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="260" />
        </StackPanel>

        <!-- =================================================================
             STATE 2: LOADING LYRICS
             ================================================================= -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Visibility="{Binding Lyrics.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Width="28" Height="28" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform Angle="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="LoadingSpinStory">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="LoadingSpinStory" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Ellipse Stroke="{StaticResource Brush.Border.Hairline}" StrokeThickness="2" />
                <Path Stroke="{StaticResource Brush.Icon.Active}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M14,2 A12,12 0 0 1 26,14" />
            </Grid>
            <TextBlock Text="Loading lyrics..."
                       Style="{StaticResource Text.Callout}"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
        </StackPanel>

        <!-- =================================================================
             STATE 3: NO LYRICS AVAILABLE
             ================================================================= -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Visibility="{Binding Lyrics.IsNoLyrics, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="44" Height="44"
                    CornerRadius="22"
                    Background="{StaticResource Brush.Elevated}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <Path Width="18" Height="16" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{StaticResource Brush.Icon.Muted}"
                      StrokeThickness="1.4"
                      Data="M2,2 L16,2 L16,11.5 L8,11.5 L4.5,14.5 L4.5,11.5 L2,11.5 Z M5.5,5.5 L12.5,5.5 M5.5,8.5 L10.5,8.5" />
            </Border>
            <TextBlock Text="No lyrics available for this track"
                       Style="{StaticResource Text.Headline}"
                       Foreground="{StaticResource Brush.Text.Primary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,12,0,6" />
            <TextBlock Text="Place a matching .lrc file beside the audio track or import a .lrc / .txt file."
                       Style="{StaticResource Text.Callout}"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="280" />
            <Button Style="{StaticResource Style.Button.Secondary}"
                    Height="32"
                    Padding="14,0"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="Aura.Lyrics.Import"
                    Command="{Binding ImportLyricsFileCommand}"
                    CommandParameter="{Binding CurrentTrack}"
                    Content="Import .lrc / Lyrics..." />
        </StackPanel>

        <!-- =================================================================
             STATE 4: STATIC / PLAIN-TEXT FALLBACK (Unsynced, No Highlight/Seek)
             ================================================================= -->
        <Grid Grid.Row="0"
              Visibility="{Binding Lyrics.IsStaticLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0,4,10">
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Padding="8,3"
                        CornerRadius="{StaticResource Radius.Badge}"
                        Background="{StaticResource Brush.Elevated}"
                        BorderBrush="{StaticResource Brush.Border.Control}"
                        BorderThickness="1">
                    <TextBlock Text="Unsynced Lyrics"
                               Style="{StaticResource Text.Footnote}"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                </Border>
                <Button HorizontalAlignment="Right"
                        Style="{StaticResource Style.Button.Ghost}"
                        Height="26"
                        Padding="8,0"
                        FontSize="11"
                        Command="{Binding ImportLyricsFileCommand}"
                        CommandParameter="{Binding CurrentTrack}"
                        Content="Import .lrc..." />
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Focusable="False"
                          FocusVisualStyle="{x:Null}"
                          Cursor="Arrow"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding Lyrics.PlainLyricsText}"
                           FontFamily="{StaticResource Font.Primary}"
                           FontSize="15"
                           LineHeight="24"
                           FontWeight="Normal"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           TextWrapping="Wrap"
                           Padding="8,8,12,32" />
            </ScrollViewer>
        </Grid>

        <!-- =================================================================
             STATE 5: TIME-BASED SYNCED LYRICS (Distance Tiers, Pulse, Click-Seek)
             ================================================================= -->
        <Grid Grid.Row="0"
              Visibility="{Binding Lyrics.IsTimeBasedLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Source Badge + Seek Hint + Import -->
            <Grid Grid.Row="0" Margin="4,0,4,8">
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Padding="8,3"
                        CornerRadius="{StaticResource Radius.Badge}"
                        Background="{StaticResource Brush.Elevated}"
                        BorderBrush="{StaticResource Brush.Border.Control}"
                        BorderThickness="1">
                    <TextBlock Text="{Binding Lyrics.SourceLabel}"
                               Style="{StaticResource Text.Footnote}"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Click line to seek"
                               Style="{StaticResource Text.Footnote}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               VerticalAlignment="Center"
                               Margin="0,0,6,0" />
                    <Button Style="{StaticResource Style.Button.Ghost}"
                            Height="24"
                            Padding="6,0"
                            FontSize="11"
                            Command="{Binding ImportLyricsFileCommand}"
                            CommandParameter="{Binding CurrentTrack}"
                            Content="Import"
                            ToolTip="Import or replace .lrc / lyrics file" />
                </StackPanel>
            </Grid>

            <!-- UI-Virtualized Pixel-Scrolled Synced Lyrics List (Recycling containers: zero 100-line spike on open) -->
            <ListBox x:Name="SyncedLinesList"
                     Grid.Row="1"
                     ItemsSource="{Binding Lyrics.Lines}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,8,4,88"
                     Focusable="False"
                     FocusVisualStyle="{x:Null}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.CacheLength="1,1"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     PreviewMouseWheel="SyncedScrollViewer_UserInteraction"
                     PreviewMouseDown="SyncedScrollViewer_UserInteraction">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LyricsLineItem}">
                        <Grid Margin="0,2">
                            <!-- Normal Click-to-Seek Lyric Line -->
                            <Button x:Name="LyricLineButton"
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    Cursor="Hand"
                                    FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                                    Command="{Binding DataContext.Lyrics.SeekToLineCommand, ElementName=Root}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding TimestampText}"
                                    Visibility="{Binding IsInstrumentalGap, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="LineBg"
                                                Padding="12,12,12,12"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Background="Transparent"
                                                SnapsToDevicePixels="True">
                                            <TextBlock x:Name="LineText"
                                                       Text="{Binding Text}"
                                                       FontFamily="{StaticResource Font.Display}"
                                                       FontSize="{Binding InactiveFontSize, ElementName=Root}"
                                                       FontWeight="SemiBold"
                                                       LineHeight="{Binding InactiveLineHeight, ElementName=Root}"
                                                       Foreground="{StaticResource Brush.Lyrics.Past}"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Tier}" Value="{x:Static vm:LyricsLineTier.Future1}">
                                                <Setter TargetName="LineText" Property="Foreground" Value="{StaticResource Brush.Lyrics.Next}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tier}" Value="{x:Static vm:LyricsLineTier.Current}">
                                                <Setter TargetName="LineText" Property="Foreground" Value="{StaticResource Brush.Lyrics.Current}" />
                                                <Setter TargetName="LineText" Property="FontWeight" Value="Bold" />
                                                <Setter TargetName="LineText" Property="FontSize" Value="{Binding ActiveFontSize, ElementName=Root}" />
                                                <Setter TargetName="LineText" Property="LineHeight" Value="{Binding ActiveLineHeight, ElementName=Root}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    <Condition Binding="{Binding IsCurrent}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="LineBg" Property="Background" Value="{StaticResource Brush.Hover.Dark}" />
                                                <Setter TargetName="LineText" Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                                            </MultiDataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Instrumental Break 3-Dot Pulse Marker (>= 5.0s gap) -->
                            <StackPanel x:Name="InstrumentalPulsePanel"
                                        Orientation="Horizontal"
                                        Margin="12,14,12,14"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding IsInstrumentalGap, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Ellipse x:Name="Dot1"
                                         Width="7" Height="7"
                                         Margin="0,0,8,0"
                                         Fill="{StaticResource Brush.Lyrics.Past}"
                                         Opacity="0.45" />
                                <Ellipse x:Name="Dot2"
                                         Width="7" Height="7"
                                         Margin="0,0,8,0"
                                         Fill="{StaticResource Brush.Lyrics.Past}"
                                         Opacity="0.45" />
                                <Ellipse x:Name="Dot3"
                                         Width="7" Height="7"
                                         Fill="{StaticResource Brush.Lyrics.Past}"
                                         Opacity="0.45" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Dot1" Property="Fill" Value="{StaticResource Brush.Lyrics.Current}" />
                                <Setter TargetName="Dot2" Property="Fill" Value="{StaticResource Brush.Lyrics.Current}" />
                                <Setter TargetName="Dot3" Property="Fill" Value="{StaticResource Brush.Lyrics.Current}" />
                                <Setter TargetName="Dot1" Property="Opacity" Value="1.0" />
                                <Setter TargetName="Dot2" Property="Opacity" Value="0.72" />
                                <Setter TargetName="Dot3" Property="Opacity" Value="0.48" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- =================================================================
             WRITERS / COMPOSER FOOTER (1px top hairline, visible when present)
             ================================================================= -->
        <Border Grid.Row="1"
                Margin="0,8,0,0"
                Padding="6,10,6,2"
                BorderBrush="{StaticResource Brush.Border.Hairline}"
                BorderThickness="0,1,0,0"
                Visibility="{Binding Lyrics.HasWriters, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding Lyrics.WritersText}"
                       FontFamily="{StaticResource Font.Primary}"
                       FontSize="11"
                       LineHeight="15"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
