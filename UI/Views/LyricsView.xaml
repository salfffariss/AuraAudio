<UserControl x:Class="AuraAudio.UI.Views.LyricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraAudio.UI.Controls"
             x:Name="Root"
             AutomationProperties.AutomationId="Aura.Lyrics.List"
             AutomationProperties.Name="Lyrics"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- =================================================================
             STATE 1: NO SONG PLAYING
             ================================================================= -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Visibility="{Binding Lyrics.IsNoSong, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="44" Height="44"
                    CornerRadius="22"
                    Background="{StaticResource Brush.Elevated}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <Path Width="18" Height="18" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{StaticResource Brush.Icon.Muted}"
                      StrokeThickness="1.5"
                      Data="M6,14 A2,2 0 1 1 2,14 A2,2 0 1 1 6,14 M6,14 L6,3 L15,1.5 L15,12 M15,12 A2,2 0 1 1 11,12 A2,2 0 1 1 15,12" />
            </Border>
            <TextBlock Text="No Track Playing"
                       Style="{StaticResource Text.Headline}"
                       Foreground="{StaticResource Brush.Text.Primary}"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,4" />
            <TextBlock Text="Play a track to display synced or embedded lyrics."
                       Style="{StaticResource Text.Callout}"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="260" />
        </StackPanel>

        <!-- =================================================================
             STATE 2: LOADING LYRICS
             ================================================================= -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Visibility="{Binding Lyrics.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Width="28" Height="28" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform Angle="0" />
                </Grid.RenderTransform>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsVisible" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="LoadingSpinStory">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                             From="0" To="360" Duration="0:0:0.9" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="LoadingSpinStory" />
                                </Trigger.ExitActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Ellipse Stroke="{StaticResource Brush.Border.Hairline}" StrokeThickness="2" />
                <Path Stroke="{StaticResource Brush.Icon.Active}"
                      StrokeThickness="2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Data="M14,2 A12,12 0 0 1 26,14" />
            </Grid>
            <TextBlock Text="Loading lyrics..."
                       Style="{StaticResource Text.Callout}"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0" />
        </StackPanel>

        <!-- =================================================================
             STATE 3: NO LYRICS AVAILABLE
             ================================================================= -->
        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="24"
                    Visibility="{Binding Lyrics.IsNoLyrics, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="44" Height="44"
                    CornerRadius="22"
                    Background="{StaticResource Brush.Elevated}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <Path Width="18" Height="16" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{StaticResource Brush.Icon.Muted}"
                      StrokeThickness="1.4"
                      Data="M2,2 L16,2 L16,11.5 L8,11.5 L4.5,14.5 L4.5,11.5 L2,11.5 Z M5.5,5.5 L12.5,5.5 M5.5,8.5 L10.5,8.5" />
            </Border>
            <TextBlock Text="No lyrics available for this track"
                       Style="{StaticResource Text.Headline}"
                       Foreground="{StaticResource Brush.Text.Primary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,12,0,6" />
            <TextBlock Text="Place a matching .lrc file beside the audio track or import a .lrc / .txt file."
                       Style="{StaticResource Text.Callout}"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="280" />
            <Button Style="{StaticResource Style.Button.Secondary}"
                    Height="32"
                    Padding="14,0"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.AutomationId="Aura.Lyrics.Import"
                    Command="{Binding ImportLyricsFileCommand}"
                    CommandParameter="{Binding CurrentTrack}"
                    Content="Import .lrc / Lyrics..." />
        </StackPanel>

        <!-- =================================================================
             STATE 4: STATIC / PLAIN-TEXT FALLBACK (Unsynced, Cardless, Scrollable)
             ================================================================= -->
        <ScrollViewer x:Name="PlainLyricsScroll"
                      Grid.Row="0"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      Cursor="Arrow"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      OpacityMask="{Binding EdgeMaskBrush, ElementName=Root}"
                      Visibility="{Binding Lyrics.IsStaticLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding Lyrics.PlainLyricsText}"
                       FontFamily="{Binding PlainFontFamily, ElementName=Root}"
                       FontSize="{Binding PlainFontSize, ElementName=Root}"
                       LineHeight="{Binding PlainLineHeight, ElementName=Root}"
                       FontWeight="{Binding PlainFontWeight, ElementName=Root}"
                       Foreground="{StaticResource Brush.Text.Primary}"
                       TextWrapping="Wrap"
                       Padding="{Binding PlainTextPadding, ElementName=Root}" />
        </ScrollViewer>

        <!-- =================================================================
             STATE 5: TIME-BASED SYNCED LYRICS (Cardless, Pooled 165Hz RenderTransform)
             ================================================================= -->
        <controls:SyncedLyricsViewport x:Name="SyncedViewport"
                                       Grid.Row="0"
                                       Visibility="{Binding Lyrics.IsTimeBasedLoaded, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- =================================================================
             WRITERS / COMPOSER FOOTER (Cardless credit line, visible when present)
             ================================================================= -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Lyrics.WritersText}"
                   FontFamily="{StaticResource Font.Primary}"
                   FontSize="11"
                   LineHeight="15"
                   Foreground="{StaticResource Brush.Text.Tertiary}"
                   TextWrapping="Wrap"
                   Padding="12,6,96,4"
                   Visibility="{Binding Lyrics.HasWriters, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- =================================================================
             UNOBTRUSIVE IMPORT ACTION (Reveals on hover OR keyboard Tab focus)
             ================================================================= -->
        <Button x:Name="FooterImportButton"
                Grid.Row="0"
                Grid.RowSpan="2"
                Panel.ZIndex="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,6,4"
                Height="26"
                Padding="10,0"
                Cursor="Hand"
                Focusable="True"
                IsTabStop="True"
                AutomationProperties.AutomationId="Aura.Lyrics.FooterImport"
                AutomationProperties.Name="Import .lrc lyrics file"
                FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                Command="{Binding ImportLyricsFileCommand}"
                CommandParameter="{Binding CurrentTrack}"
                Content="Import .lrc"
                ToolTip="Import or replace .lrc / lyrics file"
                Visibility="{Binding Lyrics.HasLyrics, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Opacity" Value="0.0" />
                    <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ImportPill"
                                        Padding="{TemplateBinding Padding}"
                                        CornerRadius="{StaticResource Radius.Badge}"
                                        Background="{StaticResource Brush.DockBackground}"
                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ImportPill" Property="Background" Value="{StaticResource Brush.Hover.Elevated}" />
                                        <Setter TargetName="ImportPill" Property="BorderBrush" Value="{StaticResource Brush.Border.ControlHover}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ImportPill" Property="Background" Value="{StaticResource Brush.Pressed.Dark}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                            <Setter Property="Opacity" Value="1.0" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Opacity" Value="1.0" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="Opacity" Value="1.0" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</UserControl>
