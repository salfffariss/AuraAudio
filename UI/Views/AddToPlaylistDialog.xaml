<Window x:Class="AuraAudio.UI.Views.AddToPlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AuraAudio.Core.Models"
        mc:Ignorable="d"
        Title="{DynamicResource Str_AddPl_WindowTitle}" 
        Height="470" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Background.Window}"
        Foreground="{StaticResource Brush.Text.Primary}">

    <Window.Resources>
        <ResourceDictionary Source="/UI/Styles/ModernTheme.xaml" />
    </Window.Resources>

    <Border Background="{StaticResource Brush.Background.Window}" 
            BorderBrush="{StaticResource Brush.Border.Light}" 
            BorderThickness="1" 
            CornerRadius="12">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Track Info Banner -->
                <RowDefinition Height="*" />    <!-- Playlist Selection List -->
                <RowDefinition Height="Auto" /> <!-- Create New Playlist Box -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Str_AddPl_Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                    <TextBlock Text="{DynamicResource Str_AddPl_Desc}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Style.Button.ModalClose}" Click="Cancel_Click" AutomationProperties.Name="{DynamicResource Str_Btn_Close}" ToolTip="{DynamicResource Str_Btn_Close}">
                    <Path Data="{StaticResource Icon.Close}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- 2. Track Info Banner -->
            <Border Grid.Row="1" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding TargetTrack.Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding TargetTrack.Artist}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Tertiary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- 3. Existing Playlists List -->
            <Border Grid.Row="2" Background="{StaticResource Brush.Background.Card}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,0,12">
                <Grid>
                    <TextBlock Text="{DynamicResource Str_AddPl_Empty}" 
                               FontSize="11.5" Foreground="{StaticResource Brush.Text.Tertiary}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" 
                               TextWrapping="Wrap" TextAlignment="Center" Margin="14"
                               Visibility="{Binding HasPlaylists, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                    <ListBox ItemsSource="{Binding Playlists}" 
                             SelectedItem="{Binding SelectedExistingPlaylist}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding HasPlaylists, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="10,8" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#22222B" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Background.CardHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#252015" />
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Playlist}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource Icon.Playlist}" Stroke="{StaticResource Brush.Accent.Gold}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 4. Create New Playlist Input -->
            <Border Grid.Row="3" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_AddPl_OrNewHeader}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding NewPlaylistName, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="{StaticResource Brush.Background.Input}" Foreground="{StaticResource Brush.Text.Primary}" BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                 BorderThickness="1" Height="32" Padding="8,5" FontSize="12" />
                        <Button Grid.Column="1" Content="{DynamicResource Str_AddPl_CreateAndAddBtn}" 
                                Command="{Binding CreateAndAddCommand}"
                                Style="{StaticResource Style.Button.Transport}" 
                                Height="32" Padding="12,0" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. Footer Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="{DynamicResource Str_Btn_Cancel}" Style="{StaticResource Style.Button.Transport}" Width="80" Height="32" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="{DynamicResource Str_AddPl_AddBtn}" Command="{Binding AddToSelectedCommand}" Style="{StaticResource Style.Button.Primary}" Height="32" />
            </Grid>
        </Grid>
    </Border>
</Window>
