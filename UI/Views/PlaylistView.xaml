<UserControl x:Class="AuraAudio.UI.Views.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:AuraAudio.Core.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" /> <!-- Panel Kiri: Daftar Playlist -->
            <ColumnDefinition Width="*" />   <!-- Panel Kanan: Isi Trek Playlist Terpilih -->
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- KOLOM KIRI: DAFTAR KOLEKSI PLAYLIST                                       -->
        <!-- ========================================================================= -->
        <Border Grid.Column="0" 
                Background="{StaticResource Brush.Background.Card}" 
                BorderBrush="{StaticResource Brush.Border.Subtle}" 
                BorderThickness="1" 
                CornerRadius="10" 
                Margin="0,0,16,0"
                Padding="16,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Header -->
                    <RowDefinition Height="Auto" /> <!-- Buat Playlist Baru Input -->
                    <RowDefinition Height="*" />    <!-- List Playlist -->
                </Grid.RowDefinitions>

                <!-- 1. Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource Str_Playlist_Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                    <TextBlock Text="{DynamicResource Str_Playlist_Desc}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- 2. Form Cepat Buat Playlist Baru -->
                <Border Grid.Row="1" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Playlist_CreateNewHeader}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewPlaylistTextBox" 
                                     Background="{StaticResource Brush.Background.Input}" Foreground="{StaticResource Brush.Text.Primary}" BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                     BorderThickness="1" Height="30" Padding="8,4" FontSize="12"
                                     KeyDown="NewPlaylistTextBox_KeyDown" />
                            <Button Grid.Column="1" Content="{DynamicResource Str_Playlist_CreateBtn}" 
                                    Click="CreatePlaylist_Click"
                                    Style="{StaticResource Style.Button.Transport}" 
                                    Height="30" Padding="10,0" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. List Playlist Tersimpan -->
                <ListBox Grid.Row="2" 
                         ItemsSource="{Binding SavedPlaylists}" 
                         SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="{StaticResource Brush.Background.Sidebar}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="8" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource Brush.Background.CardHover}" />
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource Brush.Border.Light}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#25252E" />
                                                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Playlist}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Info Playlist -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Tombol Aksi Cepat -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Putar Playlist -->
                                    <Button Style="{StaticResource Style.Button.PlayerIcon}" 
                                            Width="26" Height="26" 
                                            Command="{Binding DataContext.PlaySavedPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                            CommandParameter="{Binding}" 
                                            AutomationProperties.Name="{DynamicResource Str_Playlist_PlayPlaylist}"
                                            ToolTip="{DynamicResource Str_Playlist_PlayPlaylist}">
                                        <Path Fill="{StaticResource Brush.Accent.Gold}" Data="{StaticResource Icon.Play}" Width="10" Height="10" Stretch="Uniform" />
                                    </Button>

                                    <!-- Ganti Nama -->
                                    <Button Style="{StaticResource Style.Button.PlayerIcon}" 
                                            Width="26" Height="26" 
                                            Command="{Binding DataContext.RenamePlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                            CommandParameter="{Binding}" 
                                            AutomationProperties.Name="{DynamicResource Str_Playlist_Rename}"
                                            ToolTip="{DynamicResource Str_Playlist_Rename}">
                                        <Path Data="{StaticResource Icon.Edit}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" />
                                    </Button>

                                    <!-- Hapus Playlist -->
                                    <Button Width="26" Height="26" 
                                            Command="{Binding DataContext.DeleteSavedPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                            CommandParameter="{Binding}" 
                                            AutomationProperties.Name="{DynamicResource Str_Playlist_Delete}"
                                            ToolTip="{DynamicResource Str_Playlist_Delete}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Style.Button.PlayerIcon}">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Red}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Path Data="{StaticResource Icon.Trash}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- KOLOM KANAN: ISI TREK PLAYLIST TERPILIH                                    -->
        <!-- ========================================================================= -->
        <Border Grid.Column="1" 
                Background="{StaticResource Brush.Background.Card}" 
                BorderBrush="{StaticResource Brush.Border.Subtle}" 
                BorderThickness="1" 
                CornerRadius="10" 
                Padding="0">
            <Grid>
                <!-- KONDISI 1: TIDAK ADA PLAYLIST YANG DIPILIH -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding SelectedPlaylist, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Path Data="{StaticResource Icon.Playlist}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Str_Playlist_EmptySelectTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{DynamicResource Str_Playlist_EmptySelectDesc}" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,4,0,0" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap" />
                </StackPanel>

                <!-- KONDISI 2: PLAYLIST DIPILIH -->
                <Grid Visibility="{Binding SelectedPlaylist, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- Header Banner & Actions -->
                        <RowDefinition Height="36" />   <!-- Table Column Headers -->
                        <RowDefinition Height="*" />    <!-- Tracks List -->
                    </Grid.RowDefinitions>

                    <!-- Header Banner & Action Bar -->
                    <Border Grid.Row="0" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Title & Subtitle -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedPlaylist.Name}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedPlaylistSummaryText}" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Putar Semua -->
                                <Button Style="{StaticResource Style.Button.Primary}" 
                                        Command="{Binding PlaySavedPlaylistCommand}" 
                                        CommandParameter="{Binding SelectedPlaylist}"
                                        Padding="16,0" Height="36" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Fill="#111114" Data="{StaticResource Icon.Play}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Str_Btn_PlayAll}" FontSize="12" FontWeight="Bold" Foreground="#111114" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Putar Acak -->
                                <Button Style="{StaticResource Style.Button.Transport}" 
                                        Command="{Binding ShuffleSavedPlaylistCommand}" 
                                        CommandParameter="{Binding SelectedPlaylist}"
                                        Padding="12,8" Height="36" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Shuffle}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Str_Btn_Shuffle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Ganti Nama -->
                                <Button Style="{StaticResource Style.Button.Transport}" 
                                        Command="{Binding RenamePlaylistCommand}" 
                                        CommandParameter="{Binding SelectedPlaylist}"
                                        Padding="12,8" Height="36" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Edit}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Str_Playlist_Rename}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Hapus Playlist -->
                                <Button Style="{StaticResource Style.Button.Transport}" 
                                        Command="{Binding DeleteSavedPlaylistCommand}" 
                                        CommandParameter="{Binding SelectedPlaylist}"
                                        Padding="12,8" Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Trash}" Stroke="{StaticResource Brush.Accent.Red}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Str_Playlist_Delete}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Red}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table Column Headers -->
                    <Border Grid.Row="1" Background="{StaticResource Brush.Background.Window}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />  <!-- # -->
                                <ColumnDefinition Width="4*" />  <!-- Title & Artist -->
                                <ColumnDefinition Width="3*" />  <!-- Album -->
                                <ColumnDefinition Width="140" /> <!-- Format -->
                                <ColumnDefinition Width="65" />  <!-- Duration -->
                                <ColumnDefinition Width="50" />  <!-- Remove Action -->
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Str_Table_TrackNo}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Str_Table_TitleAndArtist}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str_Table_Album}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                            <TextBlock Grid.Column="3" Text="{DynamicResource Str_Table_Format}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                            <TextBlock Grid.Column="4" Text="{DynamicResource Str_Table_Duration}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="5" Text="{DynamicResource Str_Table_Order}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Track List / Empty State -->
                    <Grid Grid.Row="2">
                        <!-- Pesan jika playlist kosong -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding SelectedPlaylistTracks.Count, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=Inverse}">
                            <Path Data="{StaticResource Icon.MusicNote}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="{DynamicResource Str_Playlist_EmptyTracksTitle}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="{DynamicResource Str_Playlist_EmptyTracksDesc}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- ListBox Lagu dalam Playlist -->
                        <ListBox ItemsSource="{Binding SelectedPlaylistTracks}" 
                                 AlternationCount="5000"
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MouseDoubleClick="PlaylistListBox_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                                    <Setter Property="BorderBrush" Value="#22222B" />
                                    <Setter Property="Height" Value="46" />
                                    <Setter Property="Padding" Value="16,0" />
                                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="{DynamicResource Str_Ctx_PlayNow}" Command="{Binding PlaySelectedTrackCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="{DynamicResource Str_Ctx_PlayNext}" Command="{Binding PlayNextCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <MenuItem Header="{DynamicResource Str_Ctx_AddToQueue}" Command="{Binding AddToQueueCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                <Separator />
                                                <MenuItem Header="{DynamicResource Str_Ctx_RemoveFromPlaylist}" Command="{Binding RemoveTrackFromCurrentPlaylistCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="{StaticResource Brush.Accent.Red}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder" 
                                                        Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource Brush.Background.CardHover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#25252E" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Track}">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />  <!-- # -->
                                            <ColumnDefinition Width="4*" />  <!-- Title & Artist -->
                                            <ColumnDefinition Width="3*" />  <!-- Album -->
                                            <ColumnDefinition Width="140" /> <!-- Format -->
                                            <ColumnDefinition Width="65" />  <!-- Duration -->
                                            <ColumnDefinition Width="50" />  <!-- Remove Button -->
                                        </Grid.ColumnDefinitions>

                                        <!-- # Sequential Index -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource OneBasedIndexConverter}}" 
                                                   FontSize="11.5" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" />

                                        <!-- Title & Artist dengan Cover Art Icon -->
                                        <DockPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True" Background="{StaticResource Brush.Background.Sidebar}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <Grid>
                                                    <Path Data="{StaticResource Icon.MusicNote}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                                                    <Image Source="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Album -->
                                        <TextBlock Grid.Column="2" Text="{Binding Album}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <!-- Format Badge -->
                                        <Border Grid.Column="3" Background="{StaticResource Brush.Background.CardHover}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="6,2">
                                            <TextBlock Text="{Binding StreamSpec.FormattedBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Gold}" />
                                        </Border>

                                        <!-- Duration -->
                                        <TextBlock Grid.Column="4" Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Right" VerticalAlignment="Center" />

                                        <!-- Tombol Hapus dari Playlist -->
                                        <Button Grid.Column="5" Width="24" Height="24" HorizontalAlignment="Center"
                                                Command="{Binding DataContext.RemoveTrackFromCurrentPlaylistCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{DynamicResource Str_Ctx_RemoveFromPlaylist}"
                                                ToolTip="{DynamicResource Str_Ctx_RemoveFromPlaylist}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Style.Button.PlayerIcon}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Red}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
