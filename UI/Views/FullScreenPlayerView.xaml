<UserControl x:Class="AuraAudio.UI.Views.FullScreenPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers"
             xmlns:views="clr-namespace:AuraAudio.UI.Views"
             x:Name="Root"
             Background="{StaticResource Brush.Rail}"
             SizeChanged="FullScreenPlayer_SizeChanged">

    <Grid x:Name="StageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Minimal Chrome (Draggable Empty Space + Lyrics Toggle / Mini / Exit) -->
        <Grid Grid.Row="0"
              Background="Transparent"
              Margin="20,0,16,0"
              MouseLeftButtonDown="TopChrome_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Now Playing"
                           Style="{StaticResource Text.Eyebrow}"
                           Foreground="{StaticResource Brush.Text.Tertiary}"
                           VerticalAlignment="Center" />
                <Border Margin="10,0,0,0"
                        Padding="7,2"
                        CornerRadius="{StaticResource Radius.Badge}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding LcdSpecBadge}"
                               Style="{StaticResource Text.TabularMono}"
                               FontSize="10"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Toggle Lyrics Split Column (only expands panel when track has lyrics) -->
                <ToggleButton Width="34" Height="34"
                              AutomationProperties.AutomationId="Aura.FullScreen.LyricsToggle"
                              IsChecked="{Binding Presentation.IsFullScreenLyricsOpen, Mode=TwoWay}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource Style.Toggle.Dock}">
                            <Setter Property="ToolTip" Value="Toggle Lyrics Split View (Ctrl+Shift+L)" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Lyrics.HasLyrics}" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="ToolTip" Value="No lyrics available for this track — import in Get Info or Lyrics pane" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                    <Path Width="15" Height="14" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                          StrokeThickness="1.4"
                          Data="M2,2 L14,2 L14,10.5 L7,10.5 L4,13 L4,10.5 L2,10.5 Z M5,5.2 L11,5.2 M5,7.8 L9.5,7.8" />
                </ToggleButton>

                <!-- Switch to Mini-Player -->
                <Button Style="{StaticResource Style.Button.Icon}"
                        Width="34" Height="34"
                        Margin="6,0,0,0"
                        Command="{Binding Presentation.ToggleMiniPlayerCommand}"
                        ToolTip="Switch to Mini-Player (Ctrl+Shift+M)">
                    <Path Width="15" Height="13" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4"
                          Data="M1.5,2 L14.5,2 L14.5,11.5 L1.5,11.5 Z M8,6.5 L13,6.5 L13,10 L8,10 Z" />
                </Button>

                <!-- Exit Full-Screen Stage -->
                <Button Style="{StaticResource Style.Button.Icon}"
                        Width="34" Height="34"
                        Margin="6,0,0,0"
                        AutomationProperties.AutomationId="Aura.FullScreen.Exit"
                        Command="{Binding Presentation.ExitFullScreenCommand}"
                        ToolTip="Exit Full-Screen (Esc)">
                    <Path Width="12" Height="12" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6"
                          Data="M1,1 L11,11 M11,1 L1,11" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 5-Column Symmetric Apple Music Stage (Centered <-> Split Lyrics) -->
        <Grid x:Name="FiveColumnStage"
              Grid.Row="1"
              Margin="24,8,24,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColLeftPad" Width="2*" />
                <ColumnDefinition x:Name="ColArtwork" Width="Auto" />
                <ColumnDefinition x:Name="ColMiddleGap" Width="0" />
                <ColumnDefinition x:Name="ColLyrics" Width="0" />
                <ColumnDefinition x:Name="ColRightPad" Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- COL 1: ARTWORK + TRACK METADATA + 8px SCRUBBER + TRANSPORT + VOLUME -->
            <StackPanel Grid.Column="1"
                        Width="{Binding ArtworkSize, ElementName=Root}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <!-- Large 1:1 Hero Cover Art (CornerRadius=14 via ImageBrush, ZERO Glow/Shadow) -->
                <Grid Width="{Binding ArtworkSize, ElementName=Root}"
                      Height="{Binding ArtworkSize, ElementName=Root}">
                    <Border CornerRadius="{StaticResource Radius.HeroArt}"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1">
                        <Path Width="64" Height="64" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{StaticResource Brush.Icon.Muted}"
                              StrokeThickness="1.3"
                              Data="M14,38 A6,6 0 1 1 2,38 A6,6 0 1 1 14,38 M14,38 L14,7 L40,2.5 L40,33.5 M40,33.5 A6,6 0 1 1 28,33.5 A6,6 0 1 1 40,33.5" />
                    </Border>

                    <Border CornerRadius="{StaticResource Radius.HeroArt}"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="{Binding CurrentTrack.CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Large}" />
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- Track Title (20px SemiBold) + Clickable Artist Link (18px Regular) -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CurrentTrack.Title, TargetNullValue='AuraAudio Ready', FallbackValue='AuraAudio Ready'}"
                                   FontFamily="{StaticResource Font.Display}"
                                   FontSize="20"
                                   LineHeight="26"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Peak}"
                                   TextTrimming="CharacterEllipsis" />
                        <Button HorizontalAlignment="Left"
                                Margin="0,2,0,0"
                                Cursor="Hand"
                                FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                                Click="ArtistLink_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock x:Name="ArtistText"
                                               Text="{Binding CurrentTrack.Artist, TargetNullValue='Select a track to begin playback', FallbackValue='Select a track to begin playback'}"
                                               FontFamily="{StaticResource Font.Primary}"
                                               FontSize="17"
                                               LineHeight="22"
                                               FontWeight="Normal"
                                               Foreground="{StaticResource Brush.Text.Secondary}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ArtistText" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                            <Setter TargetName="ArtistText" Property="TextDecorations" Value="Underline" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- Compact Info Button (opens Get Info for CurrentTrack above Full-Screen) -->
                    <Button Grid.Column="1"
                            Style="{StaticResource Style.Button.Icon}"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Aura.FullScreen.Info"
                            Command="{Binding OpenInfoForTrackCommand}"
                            CommandParameter="{Binding CurrentTrack}"
                            ToolTip="Get Info (Ctrl+I)">
                        <Path Width="15" Height="15" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Data="M8,1.5 A6.5,6.5 0 1 1 8,14.5 A6.5,6.5 0 1 1 8,1.5 M8,7 L8,11.2 M8,4.6 L8,5.2" />
                    </Button>
                </Grid>

                <!-- 8px Monochrome Scrubber + Tabular Timestamps -->
                <StackPanel Margin="0,14,0,0">
                    <Slider x:Name="FullScreenScrubber"
                            Style="{StaticResource Style.Slider.FullScreenScrubber}"
                            helpers:FluidBehaviors.EnableDirectScrub="True"
                            Minimum="0"
                            Maximum="{Binding SeekSliderMaximum}"
                            Value="{Binding SeekSliderValue, Mode=TwoWay}"
                            Thumb.DragStarted="FullScreenScrubber_DragStarted"
                            Thumb.DragCompleted="FullScreenScrubber_DragCompleted"
                            PreviewMouseLeftButtonDown="FullScreenScrubber_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="FullScreenScrubber_PreviewMouseLeftButtonUp" />

                    <Grid Margin="0,2,0,0">
                        <TextBlock HorizontalAlignment="Left"
                                   Style="{StaticResource Text.TabularMono}"
                                   FontSize="12"
                                   Text="{Binding CurrentTime, Converter={StaticResource TimeSpanToStringConverter}}" />
                        <TextBlock HorizontalAlignment="Right"
                                   Style="{StaticResource Text.TabularMono}"
                                   FontSize="12"
                                   Text="{Binding TotalTime, Converter={StaticResource TimeSpanToStringConverter}}" />
                    </Grid>
                </StackPanel>

                <!-- Transport Controls (Shuffle | Prev | 54px Play/Pause | Next | Repeat) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0">
                    <Button Style="{StaticResource Style.Button.Icon}"
                            Width="38" Height="38"
                            Command="{Binding ToggleShuffleCommand}"
                            ToolTip="{Binding ShuffleToolTip}">
                        <Grid>
                            <Path Width="16" Height="14" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Data="M1,3 L4.5,3 L10.5,10 L14,10 M11.5,7.8 L14,10 L11.5,12.2 M1,10 L4.5,10 L6.5,7.6 M8.8,5 L10.5,3 L14,3 M11.5,0.8 L14,3 L11.5,5.2" />
                            <Ellipse Width="4" Height="4"
                                     Margin="0,0,0,-9"
                                     VerticalAlignment="Bottom"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Brush.Icon.Active}"
                                     Visibility="{Binding IsShuffleEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource Style.Button.Icon}"
                            Width="42" Height="42"
                            Margin="10,0,0,0"
                            Command="{Binding PreviousTrackCommand}"
                            ToolTip="Previous Track (Ctrl+Left)">
                        <Path Width="18" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M0,1 L2.4,1 L2.4,13 L0,13 Z M15,1 L4.5,7 L15,13 Z" />
                    </Button>

                    <!-- Large 54x54 Solid White Play / Pause Circle -->
                    <Button Width="54" Height="54"
                            Margin="16,0"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                            helpers:FluidBehaviors.EnablePressScale="True"
                            Command="{Binding TogglePlayPauseCommand}"
                            ToolTip="Play / Pause (Space)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="PlayDisc"
                                        CornerRadius="27"
                                        Background="{StaticResource Brush.Button.PrimaryFill}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="PlayDisc" Property="Background" Value="{StaticResource Brush.Button.PrimaryHover}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="PlayDisc" Property="Background" Value="{StaticResource Brush.Button.PrimaryPressed}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Path Width="18" Height="20" Margin="3,0,0,0" Stretch="Uniform"
                                  Fill="{StaticResource Brush.Icon.OnWhite}"
                                  Data="M1,0.5 L16,9.5 L1,18.5 Z"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                            <Path Width="16" Height="19" Stretch="Uniform"
                                  Fill="{StaticResource Brush.Icon.OnWhite}"
                                  Data="M1,1 L5.5,1 L5.5,18 L1,18 Z M10.5,1 L15,1 L15,18 L10.5,18 Z"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource Style.Button.Icon}"
                            Width="42" Height="42"
                            Margin="0,0,10,0"
                            Command="{Binding NextTrackCommand}"
                            ToolTip="Next Track (Ctrl+Right)">
                        <Path Width="18" Height="15" Stretch="Uniform"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M1,1 L11.5,7 L1,13 Z M13.6,1 L16,1 L16,13 L13.6,13 Z" />
                    </Button>

                    <Button Style="{StaticResource Style.Button.Icon}"
                            Width="38" Height="38"
                            Command="{Binding ToggleRepeatCommand}"
                            ToolTip="{Binding RepeatToolTip}">
                        <Grid>
                            <Path Width="16" Height="14" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Data="M11.5,1 L14,3.2 L11.5,5.4 M2,6.5 L2,4.5 C2,3.7 2.7,3.2 3.5,3.2 L13.5,3.2 M3.5,12 L1,9.8 L3.5,7.6 M13,6.5 L13,8.5 C13,9.3 12.3,9.8 11.5,9.8 L1.5,9.8" />
                            <TextBlock Text="1"
                                       FontSize="7.5"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Icon.Active}"
                                       Visibility="{Binding IsRepeatOne, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Ellipse Width="4" Height="4"
                                     Margin="0,0,0,-9"
                                     VerticalAlignment="Bottom"
                                     HorizontalAlignment="Center"
                                     Fill="{StaticResource Brush.Icon.Active}"
                                     Visibility="{Binding IsRepeatActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Volume Row -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource Style.Button.Icon}"
                            Width="28" Height="28"
                            Command="{Binding ToggleMuteCommand}"
                            ToolTip="Mute / Unmute (M)">
                        <Path Width="14" Height="12" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Data="M1,4 L4,4 L8,1 L8,11 L4,8 L1,8 Z M11,3.5 C12.5,4.8 12.5,7.2 11,8.5" />
                    </Button>

                    <Slider Grid.Column="1"
                            Margin="10,0"
                            Style="{StaticResource Style.Slider.MonochromeVolume}"
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding Volume, Mode=TwoWay}" />

                    <TextBlock Grid.Column="2"
                               Style="{StaticResource Text.TabularMono}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Text="{Binding Volume, StringFormat={}{0:P0}}" />
                </Grid>
            </StackPanel>

            <!-- COL 3: SPLIT-SCREEN SYNCED / STATIC LYRICS HOST (Cardless, borderless) -->
            <Border x:Name="LyricsStageHost"
                    Grid.Column="3"
                    MaxWidth="620"
                    VerticalAlignment="Stretch"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="Collapsed">
                <views:LyricsView IsFullScreenMode="True"
                                  AutomationProperties.AutomationId="Aura.FullScreen.LyricsList" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
