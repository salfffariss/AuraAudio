<Window x:Class="AuraAudio.UI.Views.RenamePlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str_RenamePl_WindowTitle}" 
        Height="210" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Background.Window}"
        Foreground="{StaticResource Brush.Text.Primary}">

    <Window.Resources>
        <ResourceDictionary Source="/UI/Styles/ModernTheme.xaml" />
    </Window.Resources>

    <Border Background="{StaticResource Brush.Background.Window}" 
            BorderBrush="{StaticResource Brush.Border.Light}" 
            BorderThickness="1" 
            CornerRadius="12">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Input Box -->
                <RowDefinition Height="Auto" /> <!-- Footer Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Str_RenamePl_Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                    <TextBlock Text="{DynamicResource Str_RenamePl_Desc}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Style.Button.ModalClose}" Click="Cancel_Click" AutomationProperties.Name="{DynamicResource Str_Btn_Close}" ToolTip="{DynamicResource Str_Btn_Close}">
                    <Path Data="{StaticResource Icon.Close}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- 2. Text Input Box -->
            <TextBox x:Name="NameTextBox" Grid.Row="1" 
                     Text="{Binding PlaylistName, UpdateSourceTrigger=PropertyChanged}" 
                     Background="{StaticResource Brush.Background.Input}" Foreground="{StaticResource Brush.Text.Primary}" BorderBrush="{StaticResource Brush.Border.Subtle}" 
                     BorderThickness="1" Height="36" Padding="10,7" FontSize="12.5"
                     VerticalAlignment="Center" KeyDown="NameTextBox_KeyDown" />

            <!-- 3. Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="{DynamicResource Str_Btn_Cancel}" Style="{StaticResource Style.Button.Transport}" Width="80" Height="32" Margin="0,0,10,0" Click="Cancel_Click" />
                <Button Grid.Column="2" Content="{DynamicResource Str_Btn_Save}" Click="Save_Click" Style="{StaticResource Style.Button.Primary}" Height="32" />
            </Grid>
        </Grid>
    </Border>
</Window>
