<Window x:Class="AuraAudio.UI.Views.HardwareConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AuraAudio.Core.Models"
        mc:Ignorable="d"
        Title="{DynamicResource Str_Hw_WindowTitle}" 
        Height="640" Width="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Background.Window}"
        Foreground="{StaticResource Brush.Text.Primary}">

    <Window.Resources>
        <ResourceDictionary Source="/UI/Styles/ModernTheme.xaml" />
    </Window.Resources>

    <!-- Dialog Frame dengan Efek Sudut Membulat Modern -->
    <Border Background="{StaticResource Brush.Background.Window}" 
            BorderBrush="{StaticResource Brush.Border.Light}" 
            BorderThickness="1" 
            CornerRadius="12">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Form Controls Scrollable -->
                <RowDefinition Height="Auto" /> <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER MODAL -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.Sliders}" Stroke="{StaticResource Brush.Accent.Gold}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Hw_Title}" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource Brush.Text.Primary}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str_Hw_Desc}" 
                               FontSize="11.5" 
                               Foreground="{StaticResource Brush.Text.Secondary}" 
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Tombol Tutup X -->
                <Button Grid.Column="1" 
                        Style="{StaticResource Style.Button.ModalClose}" 
                        Command="{Binding CancelCommand}"
                        VerticalAlignment="Top" 
                        AutomationProperties.Name="{DynamicResource Str_Btn_Close}"
                        ToolTip="{DynamicResource Str_Btn_Close}">
                    <Path Data="{StaticResource Icon.Close}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- 2. SCROLLABLE FORM CONTROLS -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                <StackPanel Margin="0,0,10,0">

                    <!-- SEKSI 1: PERANGKAT OUTPUT AUDIO -->
                    <Border Background="{StaticResource Brush.Background.Card}" 
                            BorderBrush="{StaticResource Brush.Border.Subtle}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="14" 
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Hw_ActiveDeviceHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" 
                                        Style="{StaticResource Style.Button.Transport}" 
                                        Command="{Binding RefreshDevicesCommand}"
                                        Padding="10,4" Height="28"
                                        ToolTip="{DynamicResource Str_Hw_RescanTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Refresh}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Str_Hw_RescanBtn}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Dropdown ComboBox Perangkat -->
                            <ComboBox ItemsSource="{Binding AvailableDevices}" 
                                      SelectedItem="{Binding SelectedDevice}"
                                      Height="36"
                                      Background="{StaticResource Brush.Background.Input}"
                                      Foreground="{StaticResource Brush.Text.Primary}"
                                      BorderBrush="{StaticResource Brush.Border.Subtle}"
                                      BorderThickness="1"
                                      Padding="8,6"
                                      Margin="0,0,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                                            <TextBlock Text=" [DAC]" Foreground="{StaticResource Brush.Accent.Gold}" FontWeight="Bold" FontSize="10" Margin="6,0,0,0" 
                                                       Visibility="{Binding IsDedicatedDac, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock Text=" (Default)" Foreground="{StaticResource Brush.Text.Tertiary}" FontSize="10" Margin="6,0,0,0" 
                                                       Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Ringkasan Kemampuan Hardware Terpilih -->
                            <Border Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="6" Padding="10">
                                <TextBlock Text="{Binding DeviceDetailsText}" 
                                           FontSize="11" 
                                           FontFamily="{StaticResource FontFamily.Mono}" 
                                           Foreground="{StaticResource Brush.Text.Secondary}" 
                                           LineHeight="17" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SEKSI 2: MODE DRIVER AUDIO -->
                    <Border Background="{StaticResource Brush.Background.Card}" 
                            BorderBrush="{StaticResource Brush.Border.Subtle}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="14" 
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Hw_DriverModeHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,0,0,10" />

                            <!-- Radio Button WASAPI Exclusive -->
                            <Border BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.Background.Sidebar}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Background.CardHover}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton IsChecked="{Binding IsExclusiveMode}" GroupName="DriverModeGroup">
                                    <StackPanel Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource Str_Hw_ExclusiveTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Gold}" VerticalAlignment="Center" />
                                            <Border Background="{StaticResource Brush.Background.CardHover}" BorderBrush="{StaticResource Brush.Accent.Gold}" BorderThickness="1" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0">
                                                <TextBlock Text="{DynamicResource Str_Hw_AudiophileStandardBadge}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Gold}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource Str_Hw_ExclusiveDesc}" 
                                                   FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Radio Button WASAPI Shared -->
                            <Border BorderThickness="1" CornerRadius="6" Padding="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.Background.Sidebar}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Background.CardHover}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton IsChecked="{Binding IsSharedMode}" GroupName="DriverModeGroup">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="{DynamicResource Str_Hw_SharedTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Text="{DynamicResource Str_Hw_SharedDesc}" 
                                                   FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- SEKSI 3: HARDWARE LATENCY BUFFER -->
                    <Border Background="{StaticResource Brush.Background.Card}" 
                            BorderBrush="{StaticResource Brush.Border.Subtle}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="14" 
                            Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str_Hw_BufferLatencyHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{Binding LatencyColorHex, Converter={StaticResource HexToBrushConverter}}" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                    <TextBlock Text="{Binding BufferSafetyBadge}" FontSize="10" FontWeight="Bold" Foreground="{Binding LatencyColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding LatencyDescription}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding LatencyColorHex, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,0,8" />

                            <!-- Slider Latensi -->
                            <Slider Minimum="20" Maximum="250" SmallChange="5" LargeChange="20"
                                    Value="{Binding LatencyMs, Mode=TwoWay}"
                                    Style="{StaticResource Style.Slider.AudioScrubber}" 
                                    ToolTip="{Binding LatencyMs, StringFormat={}{0} ms}"
                                    Margin="0,0,0,6" />

                            <Grid>
                                <TextBlock Text="{DynamicResource Str_Hw_LatencyLowHint}" FontSize="10.5" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Left" />
                                <TextBlock Text="{DynamicResource Str_Hw_LatencyOptimalHint}" FontSize="10.5" Foreground="{StaticResource Brush.Accent.Green}" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str_Hw_LatencySafeHint}" FontSize="10.5" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SEKSI 4: FORMAT ALIRAN DSD -->
                    <Border Background="{StaticResource Brush.Background.Card}" 
                            BorderBrush="{StaticResource Brush.Border.Subtle}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str_Hw_DsdHeader}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,0,0,10" />

                            <!-- DoP Radio -->
                            <Border BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.Background.Sidebar}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Background.CardHover}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton IsChecked="{Binding IsDsdDoP}" GroupName="DsdModeGroup">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="{DynamicResource Str_Hw_DsdDopTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Cyan}" />
                                        <TextBlock Text="{DynamicResource Str_Hw_DsdDopDesc}" 
                                                   FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>

                            <!-- Decimation Radio -->
                            <Border BorderThickness="1" CornerRadius="6" Padding="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush.Background.Sidebar}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Subtle}" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush.Background.CardHover}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <RadioButton IsChecked="{Binding IsDsdDecimation}" GroupName="DsdModeGroup">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="{DynamicResource Str_Hw_DsdDecimTitle}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Text="{DynamicResource Str_Hw_DsdDecimDesc}" 
                                                   FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. ACTION FOOTER -->
            <Border Grid.Row="2" 
                    Background="{StaticResource Brush.Background.Sidebar}" 
                    BorderBrush="{StaticResource Brush.Border.Subtle}" 
                    BorderThickness="0,1,0,0" 
                    Padding="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{DynamicResource Str_Hw_FooterNote}" 
                                FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" />

                    <Button Grid.Column="1" 
                            Content="{DynamicResource Str_Btn_Cancel}" 
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource Style.Button.Transport}" 
                            Width="90" Height="32" 
                            Margin="0,0,10,0" />

                    <Button Grid.Column="2" 
                            Content="{DynamicResource Str_Hw_ApplyBtn}" 
                            Command="{Binding ApplyCommand}"
                            Style="{StaticResource Style.Button.Primary}"
                            Height="32" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
