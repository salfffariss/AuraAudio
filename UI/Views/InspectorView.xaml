<UserControl x:Class="AuraAudio.UI.Views.InspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraAudio.UI.Controls"
             x:Name="Root"
             AutomationProperties.AutomationId="Aura.Inspector.Root"
             Background="{StaticResource Brush.Canvas}">

    <UserControl.Resources>
        <Style x:Key="Style.DiagnosticCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <!-- Monochrome Verdict Container Frame -->
        <Style x:Key="Style.VerdictBannerFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
            <Setter Property="Padding" Value="18,16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Caution">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Fake">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Monochrome Verdict Pill (Shape + Fill Inversion + Weight — Zero Hue) -->
        <Style x:Key="Style.VerdictBadgePill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Elevated}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
            <Setter Property="Padding" Value="10,4" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Genuine">
                    <Setter Property="Background" Value="{StaticResource Brush.Selected.PillFill}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Selected.PillFill}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Caution">
                    <Setter Property="Background" Value="{StaticResource Brush.Elevated}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Fake">
                    <Setter Property="Background" Value="{StaticResource Brush.Canvas}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Style.VerdictBadgeText" TargetType="TextBlock" BasedOn="{StaticResource Text.Subheadline}">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Genuine">
                    <Setter Property="Foreground" Value="{StaticResource Brush.Selected.PillInk}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Focusable="False"
                  FocusVisualStyle="{x:Null}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="{StaticResource Padding.PageContent}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1240" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- ===============================================================
                     PAGE HEADER + FORENSIC ACTIONS
                     =============================================================== -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="Audio Inspector"
                                   Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Text="Nyquist FFT spectral authenticity, ultrasonic cutoff &amp; 24-bit LSB entropy workstation."
                                   Style="{StaticResource Text.Callout}"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource Style.Button.Primary}"
                                AutomationProperties.AutomationId="Aura.Inspector.AnalyzeCurrent"
                                Command="{Binding AnalyzeTrackCommand}"
                                Content="Analyze Current Track"
                                Margin="0,0,10,0" />
                        <Button Style="{StaticResource Style.Button.Secondary}"
                                AutomationProperties.AutomationId="Aura.Inspector.OpenFile"
                                Command="{Binding OpenInspectFileDialogCommand}"
                                Content="Open External File..." />
                    </StackPanel>
                </Grid>

                <!-- ===============================================================
                     INSPECTED TRACK CONTEXT STRIP
                     =============================================================== -->
                <Border Style="{StaticResource Style.DiagnosticCard}"
                        Padding="14,12"
                        Margin="0,0,0,16"
                        Visibility="{Binding InspectedTrack, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="52" Height="52">
                            <Border CornerRadius="{StaticResource Radius.Card}"
                                    Background="{StaticResource Brush.Elevated}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1">
                                <Path Width="18" Height="18" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{StaticResource Brush.Icon.Muted}"
                                      StrokeThickness="1.5"
                                      Data="M6,14 A2,2 0 1 1 2,14 A2,2 0 1 1 6,14 M6,14 L6,3 L15,1.5 L15,12 M15,12 A2,2 0 1 1 11,12 A2,2 0 1 1 15,12" />
                            </Border>
                            <Border CornerRadius="{StaticResource Radius.Card}"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill"
                                                ImageSource="{Binding InspectedTrack.CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,12,0">
                            <TextBlock Text="{Binding InspectedTrack.Title}"
                                       Style="{StaticResource Text.Headline}"
                                       Foreground="{StaticResource Brush.Text.Peak}" />
                            <TextBlock Style="{StaticResource Text.Callout}"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="0,2,0,0">
                                <Run Text="{Binding InspectedTrack.Artist, Mode=OneWay}" />
                                <Run Text="  ·  " />
                                <Run Text="{Binding InspectedTrack.Album, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <Border Grid.Column="2"
                                VerticalAlignment="Center"
                                Padding="8,4"
                                Margin="0,0,10,0"
                                CornerRadius="{StaticResource Radius.Badge}"
                                Background="{StaticResource Brush.Elevated}"
                                BorderBrush="{StaticResource Brush.Border.Control}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding InspectedTrack.StreamSpec.FormattedBadge}"
                                       Style="{StaticResource Text.TabularMono}"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       FontWeight="SemiBold" />
                        </Border>

                        <Button Grid.Column="3"
                                Style="{StaticResource Style.Button.Ghost}"
                                VerticalAlignment="Center"
                                Command="{Binding OpenFileLocationCommand}"
                                CommandParameter="{Binding InspectedTrack}"
                                Content="Show in Explorer" />
                    </Grid>
                </Border>

                <!-- ===============================================================
                     ANALYZING PROGRESS BANNER
                     =============================================================== -->
                <Border Style="{StaticResource Style.DiagnosticCard}"
                        Margin="0,0,0,16"
                        Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="18" Height="18" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform Angle="0" />
                            </Grid.RenderTransform>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <Trigger Property="IsVisible" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard x:Name="AnalyzeSpinStory">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:0.9" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="AnalyzeSpinStory" />
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Ellipse Stroke="{StaticResource Brush.Border.Hairline}" StrokeThickness="2" />
                            <Path Stroke="{StaticResource Brush.Text.Peak}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M9,1 A8,8 0 0 1 17,9" />
                        </Grid>
                        <TextBlock Text="Analyzing Nyquist FFT spectrum and lower-bit entropy..."
                                   Style="{StaticResource Text.BodyEmph}"
                                   Foreground="{StaticResource Brush.Text.Peak}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ===============================================================
                     ERROR BANNER (Monochrome Heavy Frame — Zero Red)
                     =============================================================== -->
                <Border Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border.Strong}"
                        BorderThickness="2"
                        CornerRadius="{StaticResource Radius.Card}"
                        Padding="16,14"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasAnalysisError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22"
                                CornerRadius="11"
                                BorderBrush="{StaticResource Brush.Border.Strong}"
                                BorderThickness="1.5"
                                Margin="0,0,12,0">
                            <TextBlock Text="!"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.Peak}" />
                        </Border>
                        <TextBlock Text="{Binding AnalysisErrorMessage}"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.Text.Peak}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- ===============================================================
                     MONOCHROME VERDICT BANNER (Icon + Weight + Border — Zero Hue)
                     =============================================================== -->
                <Border Style="{StaticResource Style.VerdictBannerFrame}"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasActiveIntegrityReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Style.VerdictBadgePill}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Distinct Monochrome Glyph per Verdict Category -->
                                    <TextBlock FontSize="12" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Style.VerdictBadgeText}">
                                                <Setter Property="Text" Value="•" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Genuine">
                                                        <Setter Property="Text" Value="✓" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Caution">
                                                        <Setter Property="Text" Value="⚠" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Fake">
                                                        <Setter Property="Text" Value="!" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Info">
                                                        <Setter Property="Text" Value="i" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding CurrentIntegrityReport.VerdictBadge}"
                                               Style="{StaticResource Style.VerdictBadgeText}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Text.TabularMono}"
                                       Foreground="{StaticResource Brush.Text.Tertiary}"
                                       Text="{Binding CurrentIntegrityReport.SourceSpec.FormattedBadge}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Margin="0,10,0,0"
                                   Text="{Binding CurrentIntegrityReport.LocalizedExplanation}"
                                   Style="{StaticResource Text.Body}"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- ===============================================================
                     FULL-WIDTH PURE-MONOCHROME SPECTRUM CANVAS
                     Always rendered so Aura.Inspector.Spectrum is live & ready.
                     =============================================================== -->
                <Border Style="{StaticResource Style.DiagnosticCard}"
                        Padding="16,14"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="NYQUIST FFT SPECTRUM (dBFS vs kHz)"
                                       Style="{StaticResource Text.Eyebrow}"
                                       VerticalAlignment="Center" />

                            <!-- Pure-Monochrome Dash Pattern Legend -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Line X1="0" Y1="5" X2="16" Y2="5" Stroke="{StaticResource Brush.Neutral.100}" StrokeThickness="2" />
                                    <TextBlock Text="FFT Curve" Style="{StaticResource Text.Footnote}" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Line X1="0" Y1="5" X2="16" Y2="5" Stroke="{StaticResource Brush.Neutral.65}" StrokeThickness="1.2" StrokeDashArray="3 3" />
                                    <TextBlock Text="CD 22.05k" Style="{StaticResource Text.Footnote}" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Line X1="0" Y1="5" X2="16" Y2="5" Stroke="{StaticResource Brush.Neutral.100}" StrokeThickness="1.6" StrokeDashArray="6 2" />
                                    <TextBlock Text="Cutoff" Style="{StaticResource Text.Footnote}" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Line X1="0" Y1="5" X2="16" Y2="5" Stroke="{StaticResource Brush.Neutral.80}" StrokeThickness="1.2" StrokeDashArray="5 2 2 2" />
                                    <TextBlock Text="16-Bit Dither" Style="{StaticResource Text.Footnote}" Margin="6,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <controls:SpekSpectrumControl Report="{Binding CurrentIntegrityReport}"
                                                      Height="310"
                                                      AutomationProperties.AutomationId="Aura.Inspector.Spectrum" />
                    </StackPanel>
                </Border>

                <!-- ===============================================================
                     2x2 NUMERIC DIAGNOSTICS CARDS (Container / Freq / BitDepth / Output)
                     =============================================================== -->
                <UniformGrid Columns="2"
                             Margin="-6,0,-6,10"
                             Visibility="{Binding HasActiveIntegrityReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Style="{StaticResource Style.DiagnosticCard}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="CONTAINER &amp; CODEC" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock Text="{Binding CurrentIntegrityReport.SpecContainerValue}"
                                       Style="{StaticResource Text.Headline}"
                                       Foreground="{StaticResource Brush.Text.Peak}"
                                       Margin="0,6,0,4" />
                            <TextBlock Text="{Binding CurrentIntegrityReport.SpecContainerMeaning}"
                                       Style="{StaticResource Text.Callout}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Style.DiagnosticCard}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="FREQUENCY BANDWIDTH" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock Text="{Binding CurrentIntegrityReport.SpecFrequencyValue}"
                                       Style="{StaticResource Text.Headline}"
                                       Foreground="{StaticResource Brush.Text.Peak}"
                                       Margin="0,6,0,4" />
                            <TextBlock Text="{Binding CurrentIntegrityReport.SpecFrequencyMeaning}"
                                       Style="{StaticResource Text.Callout}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Style.DiagnosticCard}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="BIT DEPTH &amp; LSB ENTROPY" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock Text="{Binding CurrentIntegrityReport.SpecBitDepthValue}"
                                       Style="{StaticResource Text.Headline}"
                                       Foreground="{StaticResource Brush.Text.Peak}"
                                       Margin="0,6,0,4" />
                            <TextBlock Text="{Binding CurrentIntegrityReport.SpecBitDepthMeaning}"
                                       Style="{StaticResource Text.Callout}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Style.DiagnosticCard}" Margin="6">
                        <StackPanel>
                            <TextBlock Text="HARDWARE OUTPUT PATH" Style="{StaticResource Text.Eyebrow}" />
                            <TextBlock Text="{Binding CurrentIntegrityReport.SpecOutputValue}"
                                       Style="{StaticResource Text.Headline}"
                                       Foreground="{StaticResource Brush.Text.Peak}"
                                       Margin="0,6,0,4" />
                            <TextBlock Text="{Binding CurrentIntegrityReport.SpecOutputMeaning}"
                                       Style="{StaticResource Text.Callout}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ===============================================================
                     FORENSIC TELEMETRY SUMMARY STRIP
                     =============================================================== -->
                <Border Style="{StaticResource Style.DiagnosticCard}"
                        Padding="16,12"
                        Visibility="{Binding HasActiveIntegrityReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <UniformGrid Columns="5">
                        <StackPanel>
                            <TextBlock Text="NYQUIST LIMIT" Style="{StaticResource Text.Footnote}" />
                            <TextBlock Style="{StaticResource Text.TabularMono}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" Margin="0,4,0,0"
                                       Text="{Binding CurrentIntegrityReport.NyquistLimitHz, StringFormat='{}{0:N0} Hz'}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="DETECTED CUTOFF" Style="{StaticResource Text.Footnote}" />
                            <TextBlock Style="{StaticResource Text.TabularMono}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" Margin="0,4,0,0"
                                       Text="{Binding CurrentIntegrityReport.DetectedCutoffHz, StringFormat='{}{0:N0} Hz'}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="LSB ACTIVITY" Style="{StaticResource Text.Footnote}" />
                            <TextBlock Style="{StaticResource Text.TabularMono}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" Margin="0,4,0,0"
                                       Text="{Binding CurrentIntegrityReport.LsbActivityPercentage, StringFormat='{}{0:F1}%'}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="LSB ENTROPY" Style="{StaticResource Text.Footnote}" />
                            <TextBlock Style="{StaticResource Text.TabularMono}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" Margin="0,4,0,0"
                                       Text="{Binding CurrentIntegrityReport.LsbEntropy, StringFormat='{}{0:F2} / 8 bit'}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="SAMPLED AT" Style="{StaticResource Text.Footnote}" />
                            <TextBlock Style="{StaticResource Text.TabularMono}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="13" Margin="0,4,0,0"
                                       Text="{Binding CurrentIntegrityReport.AnalysisTimestamp, Converter={StaticResource TimeSpanToStringConverter}}" />
                        </StackPanel>
                    </UniformGrid>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
