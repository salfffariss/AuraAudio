<Window x:Class="AuraAudio.UI.Views.SignalPathDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AuraAudio.Core.Models"
        mc:Ignorable="d"
        Title="{DynamicResource Str_Sig_WindowTitle}" 
        Height="580" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Background.Window}"
        Foreground="{StaticResource Brush.Text.Primary}">

    <Window.Resources>
        <ResourceDictionary Source="/UI/Styles/ModernTheme.xaml" />
    </Window.Resources>

    <!-- Dialog Frame dengan Sudut Membulat & Border Halus -->
    <Border Background="{StaticResource Brush.Background.Window}" 
            BorderBrush="{StaticResource Brush.Border.Light}" 
            BorderThickness="1" 
            CornerRadius="12">
        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Quality Summary Pill Banner -->
                <RowDefinition Height="*" />    <!-- Timeline Steps List -->
                <RowDefinition Height="Auto" /> <!-- Footer Button -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER MODAL -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.WaveformCheck}" 
                              Stroke="{StaticResource Brush.Accent.Gold}" 
                              StrokeThickness="1.7" 
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Height="14" Width="16" 
                              Stretch="Uniform" 
                              Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Sig_Title}" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource Brush.Text.Primary}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str_Sig_Desc}" 
                               FontSize="11.5" 
                               Foreground="{StaticResource Brush.Text.Secondary}" 
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Tombol Tutup Dialog -->
                <Button Grid.Column="1" Style="{StaticResource Style.Button.ModalClose}" Width="30" Height="30" Click="CloseButton_Click" AutomationProperties.Name="{DynamicResource Str_Btn_Close}" ToolTip="{DynamicResource Str_Btn_Close}">
                    <Path Data="{StaticResource Icon.Close}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- 2. QUALITY SUMMARY PILL BANNER -->
            <Border Grid.Row="1" 
                    Background="{StaticResource Brush.Background.Card}" 
                    BorderBrush="{Binding SignalPathColorHex, Converter={StaticResource HexToBrushConverter}}" 
                    BorderThickness="1.5" 
                    CornerRadius="8" 
                    Padding="14,12" 
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="14" Height="14" 
                             Fill="{Binding SignalPathColorHex, Converter={StaticResource HexToBrushConverter}}" 
                             Margin="0,0,12,0" 
                             VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SignalPathBadge}" 
                                   FontSize="13" 
                                   FontWeight="Bold" 
                                   Foreground="{Binding SignalPathColorHex, Converter={StaticResource HexToBrushConverter}}" />
                        <TextBlock FontSize="11" 
                                   Foreground="{StaticResource Brush.Text.Secondary}" 
                                   Margin="0,2,0,0">
                            <Run Text="{DynamicResource Str_Sig_OutputLocked}" />
                            <Run Text=" " />
                            <Run Text="{Binding OutputDeviceName, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. TIMELINE STEPS LIST (ROON / UAPP STYLE) -->
            <Border Grid.Row="2" 
                    Background="{StaticResource Brush.Background.Card}" 
                    BorderBrush="{StaticResource Brush.Border.Subtle}" 
                    BorderThickness="1" 
                    CornerRadius="10" 
                    Padding="12,12,12,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding CurrentSignalPath.Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SignalStep}">
                                <!-- Satu Simpul Langkah Rantai Audio -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" /> <!-- Bullet Point & Line -->
                                        <ColumnDefinition Width="*" />  <!-- Node Information -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Indikator Bulat & Garis Penghubung Vertikal -->
                                    <Grid Grid.Column="0">
                                        <!-- Garis Penghubung Vertikal -->
                                        <Rectangle Width="2" Fill="{StaticResource Brush.Border.Light}" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,14,0,-12" />
                                        <!-- Titik Lingkaran Node -->
                                        <Ellipse Width="10" Height="10" 
                                                 Fill="{StaticResource Brush.Accent.Gold}" 
                                                 Stroke="{StaticResource Brush.Background.Window}" StrokeThickness="2" 
                                                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,3,0,0" />
                                    </Grid>

                                    <!-- Konten Detail Node -->
                                    <Border Grid.Column="1" 
                                            Background="{StaticResource Brush.Background.Sidebar}" 
                                            BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="10,8" 
                                            Margin="4,0,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StepType, StringFormat='[{0}]'}" 
                                                           FontSize="10" 
                                                           FontWeight="Bold" 
                                                           Foreground="{StaticResource Brush.Accent.Gold}" 
                                                           Margin="0,0,6,0" 
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" 
                                                           FontSize="12.5" 
                                                           FontWeight="SemiBold" 
                                                           Foreground="{StaticResource Brush.Text.Primary}" 
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" 
                                                       FontSize="11.5" 
                                                       Foreground="{StaticResource Brush.Text.Secondary}" 
                                                       TextWrapping="Wrap" 
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 4. FOOTER & TOMBOL TUTUP -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource Style.Button.Transport}" Padding="24,0" Height="36" Click="CloseButton_Click">
                    <TextBlock Text="{DynamicResource Str_Btn_Close}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
