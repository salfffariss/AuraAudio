<UserControl x:Class="AuraAudio.UI.Views.AddToPlaylistSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             AutomationProperties.AutomationId="Aura.Sheet.AddToPlaylist">

    <Grid x:Name="SheetScrim"
          Background="{StaticResource Brush.Overlay.Scrim}"
          MouseLeftButtonDown="Scrim_MouseLeftButtonDown">

        <Border x:Name="SheetCard"
                Width="440"
                MaxHeight="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource Radius.Sheet}"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border.Control}"
                BorderThickness="1"
                Padding="20,18"
                MouseLeftButtonDown="SheetCard_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Add to Playlist"
                               Style="{StaticResource Text.Title2}"
                               Foreground="{StaticResource Brush.Text.Peak}"
                               VerticalAlignment="Center" />
                    <Button Style="{StaticResource Style.Button.Icon}"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="Aura.AddToPlaylist.Close"
                            Command="{Binding CloseAddToPlaylistSheetCommand}"
                            ToolTip="Close (Esc)">
                        <Path Width="10" Height="10" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.5"
                              Data="M1,1 L9,9 M9,1 L1,9" />
                    </Button>
                </Grid>

                <!-- Target Track Strip -->
                <Border Grid.Row="1"
                        Padding="10,8"
                        Margin="0,0,0,14"
                        CornerRadius="{StaticResource Radius.Card}"
                        Background="{StaticResource Brush.Elevated}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="42" Height="42">
                            <Border CornerRadius="{StaticResource Radius.Control}"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1" />
                            <Border CornerRadius="{StaticResource Radius.Control}"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill"
                                                ImageSource="{Binding AddToPlaylistTargetTrack.CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="{Binding AddToPlaylistTargetTrack.Title}"
                                       Style="{StaticResource Text.Subheadline}"
                                       Foreground="{StaticResource Brush.Text.Peak}" />
                            <TextBlock Text="{Binding AddToPlaylistTargetTrack.Artist}"
                                       Style="{StaticResource Text.Callout}"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="0,1,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Existing Playlists List (Virtualized for 100+ playlists) -->
                <Grid Grid.Row="2"
                      MaxHeight="240"
                      Margin="0,0,0,14">
                    <ListBox ItemsSource="{Binding SavedPlaylists}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Focusable="False"
                             FocusVisualStyle="{x:Null}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             Visibility="{Binding SavedPlaylists.Count, Converter={StaticResource NumberToVisibilityConverter}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Style.Button.Ghost}"
                                        Height="42"
                                        Margin="0,0,0,4"
                                        Padding="10,0"
                                        HorizontalContentAlignment="Stretch"
                                        Command="{Binding DataContext.AddTargetTrackToPlaylistCommand, ElementName=Root}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="24" Height="24"
                                                CornerRadius="{StaticResource Radius.Small}"
                                                Background="{StaticResource Brush.Elevated}"
                                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                BorderThickness="1"
                                                HorizontalAlignment="Left">
                                            <Path Width="10" Height="10" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{StaticResource Brush.Icon.Default}"
                                                  StrokeThickness="1.3"
                                                  Data="M1,2 L9,2 M1,5 L9,5 M1,8 L6,8" />
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource Text.Body}"
                                                   Foreground="{StaticResource Brush.Text.Primary}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,8,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TrackCount, StringFormat='{}{0} tracks'}"
                                                   Style="{StaticResource Text.TabularMono}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="No saved playlists yet. Create one below."
                               Style="{StaticResource Text.Callout}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               HorizontalAlignment="Center"
                               Margin="0,12"
                               Visibility="{Binding SavedPlaylists.Count, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=Inverse}" />
                </Grid>

                <!-- Quick Create New Playlist & Add -->
                <Border Grid.Row="3"
                        Padding="0,14,0,0"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="NewPlaylistNameBox"
                                     Height="34"
                                     AutomationProperties.AutomationId="Aura.AddToPlaylist.NewNameInput"
                                     KeyDown="NewPlaylistNameBox_KeyDown" />
                            <TextBlock Text="New playlist name..."
                                       Foreground="{StaticResource Brush.Text.Tertiary}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Callout}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=NewPlaylistNameBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="1"
                                Style="{StaticResource Style.Button.Primary}"
                                Height="34"
                                Padding="14,0"
                                Content="Create &amp; Add"
                                Click="CreateAndAdd_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
