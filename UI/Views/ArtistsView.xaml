<UserControl x:Class="AuraAudio.UI.Views.ArtistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraAudio.UI.Controls"
             xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers"
             x:Name="Root"
             Background="{StaticResource Brush.Canvas}">

    <UserControl.Resources>
        <!-- Master Index Row Style (52px, Inverted #FFFFFF Pill / #000000 Bold when Selected) -->
        <Style x:Key="Style.ArtistMasterItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusVisual.Monochrome}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Card}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 36x36 Circular Artist Avatar -->
                                <Grid Grid.Column="0" Width="36" Height="36">
                                    <Border CornerRadius="18"
                                            Background="{StaticResource Brush.Surface}"
                                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                                            BorderThickness="1">
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{StaticResource Brush.Icon.Muted}"
                                              StrokeThickness="1.4"
                                              Data="M8,2 A3,3 0 1 1 8,8 A3,3 0 1 1 8,2 M2.5,14.5 C2.5,11.2 5,9.5 8,9.5 C11,9.5 13.5,11.2 13.5,14.5" />
                                    </Border>
                                    <Border CornerRadius="18"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                                            BorderThickness="1">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill"
                                                        ImageSource="{Binding SampleCoverKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ArtistNameTxt"
                                               Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{TemplateBinding Foreground}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ArtistMetaTxt"
                                               Text="{Binding SummaryText}"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.Text.Tertiary}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover.Dark}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selected.PillFill}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Selected.PillInk}" />
                                <Setter TargetName="ArtistNameTxt" Property="FontWeight" Value="Bold" />
                                <Setter TargetName="ArtistMetaTxt" Property="Foreground" Value="{StaticResource Brush.Selected.PillInk}" />
                                <Setter TargetName="ArtistMetaTxt" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left 280px Master Artist Index -->
            <ColumnDefinition Width="280" />
            <!-- Right Live Discography Detail Pane -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===============================================================
             LEFT PANE: 280px MASTER ARTIST INDEX (Spec B.4)
             =============================================================== -->
        <Border Grid.Column="0"
                Background="{StaticResource Brush.Canvas}"
                BorderBrush="{StaticResource Brush.Border.Hairline}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header + Inline Artist Filter -->
                <StackPanel Grid.Row="0" Margin="16,20,16,12">
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding DisplayedArtists.Count}"
                                   Style="{StaticResource Text.TabularMono}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Artists" Style="{StaticResource Text.Title2}" />
                    </DockPanel>

                    <Border Height="32"
                            CornerRadius="{StaticResource Radius.SearchPill}"
                            Background="{StaticResource Brush.Elevated}"
                            BorderBrush="{StaticResource Brush.Border.Control}"
                            BorderThickness="1">
                        <Grid Margin="10,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Filter artists..."
                                       Style="{StaticResource Text.Callout}"
                                       Foreground="{StaticResource Brush.Text.Tertiary}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding ArtistFilterQuery, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}" />
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource Style.TextBox.SearchPill}"
                                     Text="{Binding ArtistFilterQuery, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource Style.Button.Icon}"
                                    Width="20" Height="20"
                                    Click="ClearArtistFilter_Click"
                                    Visibility="{Binding ArtistFilterQuery, Converter={StaticResource NullToVisibilityConverter}}">
                                <Path Width="7" Height="7" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      Data="M1,1 L6,6 M6,1 L1,6" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Virtualized Master Artist List -->
                <ListBox x:Name="ArtistMasterList"
                         Grid.Row="1"
                         AutomationProperties.AutomationId="Aura.Artists.MasterList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,0,0,104"
                         ItemsSource="{Binding DisplayedArtists}"
                         SelectedItem="{Binding SelectedArtist, Mode=OneWay}"
                         ItemContainerStyle="{StaticResource Style.ArtistMasterItem}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ArtistMasterList_SelectionChanged" />
            </Grid>
        </Border>

        <!-- ===============================================================
             RIGHT PANE: LIVE SELECTED ARTIST DISCOGRAPHY (Spec B.4)
             =============================================================== -->
        <ScrollViewer Grid.Column="1"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="1340" Margin="30,24,30,104">
                <!-- Empty Selection Hint -->
                <Border Padding="28,24"
                        VerticalAlignment="Top"
                        CornerRadius="{StaticResource Radius.Sheet}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        Visibility="{Binding SelectedArtist, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBlock Text="Select an artist from the left index to browse their albums and tracks."
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                </Border>

                <!-- Active Selected Artist Content -->
                <StackPanel Visibility="{Binding SelectedArtist, Converter={StaticResource NullToVisibilityConverter}}">
                    <!-- Artist Header: 80x80 Circle Portrait + Title + Play/Shuffle + Open Full Page -->
                    <Grid Margin="0,0,0,28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="80" Height="80" VerticalAlignment="Center">
                            <Border CornerRadius="40"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1" />
                            <Border CornerRadius="40"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    BorderBrush="{StaticResource Brush.Border.Control}"
                                    BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill"
                                                ImageSource="{Binding SelectedArtist.SampleCoverKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Grid}" />
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedArtist.Name}"
                                       Style="{StaticResource Text.LargeTitle}" />
                            <TextBlock Text="{Binding ArtistStatsSummary}"
                                       Style="{StaticResource Text.Callout}"
                                       Foreground="{StaticResource Brush.Text.Tertiary}"
                                       Margin="0,3,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Style.Button.Primary}"
                                        Content="Play"
                                        Command="{Binding PlayArtistAllCommand}" />
                                <Button Style="{StaticResource Style.Button.Secondary}"
                                        Margin="8,0,0,0"
                                        Content="Shuffle"
                                        Command="{Binding ShuffleArtistAllCommand}" />
                                <Button Style="{StaticResource Style.Button.Ghost}"
                                        Margin="10,0,0,0"
                                        Content="Open Full Artist Page ›"
                                        Command="{Binding OpenFullArtistPageCommand}"
                                        CommandParameter="{Binding SelectedArtist}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Grouped Discography: Album Cover (120x120) + Inline 40px Tracklist -->
                    <ItemsControl ItemsSource="{Binding ArtistAlbumGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,28">
                                    <!-- Album Subheader Row -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 120x120 Rounded Album Cover (Click -> AlbumDetail, Drag -> Playlist) -->
                                        <Grid Grid.Column="0"
                                              Width="120" Height="120"
                                              Cursor="Hand"
                                              helpers:FluidBehaviors.EnablePressScale="True"
                                              PreviewMouseLeftButtonDown="Draggable_PreviewMouseLeftButtonDown"
                                              MouseMove="AlbumGroupArt_MouseMove"
                                              MouseLeftButtonUp="AlbumGroupArt_MouseLeftButtonUp">
                                            <Border CornerRadius="{StaticResource Radius.Card}"
                                                    Background="{StaticResource Brush.Surface}"
                                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                    BorderThickness="1" />
                                            <Border CornerRadius="{StaticResource Radius.Card}"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                    BorderThickness="1">
                                                <Border.Background>
                                                    <ImageBrush Stretch="UniformToFill"
                                                                ImageSource="{Binding Album.CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Grid}" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Bottom">
                                            <Button HorizontalAlignment="Left"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.OpenAlbumDetailCommand, ElementName=Root}"
                                                    CommandParameter="{Binding Album}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <TextBlock x:Name="AlbTitle"
                                                                   Text="{Binding Album.Title}"
                                                                   Style="{StaticResource Text.Title2}" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="AlbTitle" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                                                <Setter TargetName="AlbTitle" Property="TextDecorations" Value="Underline" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <TextBlock Text="{Binding SummaryText}"
                                                       Style="{StaticResource Text.Callout}"
                                                       Foreground="{StaticResource Brush.Text.Tertiary}"
                                                       Margin="0,4,0,12" />

                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource Style.Button.Secondary}"
                                                        Height="30"
                                                        Padding="14,0"
                                                        Content="Play Album"
                                                        Command="{Binding DataContext.PlayArtistAlbumGroupCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hairline Tracklist (40px rows) -->
                                    <Border BorderBrush="{StaticResource Brush.Border.Hairline}"
                                            BorderThickness="0,1,0,0">
                                        <ItemsControl ItemsSource="{Binding Tracks}" AlternationCount="2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="TrackRowBd"
                                                            Height="{StaticResource Height.Row}"
                                                            Padding="8,0"
                                                            Background="Transparent"
                                                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                            BorderThickness="0,0,0,0.5"
                                                            CornerRadius="{StaticResource Radius.Small}"
                                                            Cursor="Hand"
                                                            Tag="{Binding DataContext, ElementName=Root}"
                                                            PreviewMouseLeftButtonDown="Draggable_PreviewMouseLeftButtonDown"
                                                            MouseMove="TrackRow_MouseMove"
                                                            MouseLeftButtonDown="TrackRow_MouseLeftButtonDown">
                                                        <Border.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="Play"
                                                                          Command="{Binding PlacementTarget.Tag.PlayTrackInArtistContextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="Play Next"
                                                                          Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="Add to Queue"
                                                                          Command="{Binding PlacementTarget.Tag.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="Add to Playlist..."
                                                                          Command="{Binding PlacementTarget.Tag.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <Separator />
                                                                <MenuItem Header="Get Info"
                                                                          InputGestureText="Ctrl+I"
                                                                          Command="{Binding PlacementTarget.Tag.OpenInfoForTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="Inspect Audio Authenticity"
                                                                          Command="{Binding PlacementTarget.Tag.InspectTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                                <MenuItem Header="Show in Explorer"
                                                                          Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}" />
                                                            </ContextMenu>
                                                        </Border.ContextMenu>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="60" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Track # / BouncyBar / Hover Play -->
                                                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <controls:BouncyBarControl>
                                                                    <controls:BouncyBarControl.IsActive>
                                                                        <MultiBinding Converter="{StaticResource ActiveTrackPlayingMultiConverter}">
                                                                            <Binding Path="FilePath" />
                                                                            <Binding Path="DataContext.CurrentTrack.FilePath" ElementName="Root" />
                                                                            <Binding Path="DataContext.IsPlaying" ElementName="Root" />
                                                                        </MultiBinding>
                                                                    </controls:BouncyBarControl.IsActive>
                                                                    <controls:BouncyBarControl.Visibility>
                                                                        <MultiBinding Converter="{StaticResource ActiveTrackPlayingMultiConverter}">
                                                                            <Binding Path="FilePath" />
                                                                            <Binding Path="DataContext.CurrentTrack.FilePath" ElementName="Root" />
                                                                            <Binding Path="DataContext.IsPlaying" ElementName="Root" />
                                                                        </MultiBinding>
                                                                    </controls:BouncyBarControl.Visibility>
                                                                </controls:BouncyBarControl>

                                                                <TextBlock x:Name="NumTxt"
                                                                           Text="{Binding TrackNumber}"
                                                                           Style="{StaticResource Text.TabularMono}"
                                                                           VerticalAlignment="Center">
                                                                    <TextBlock.Visibility>
                                                                        <MultiBinding Converter="{StaticResource ActiveTrackPlayingMultiConverter}" ConverterParameter="Inverse">
                                                                            <Binding Path="FilePath" />
                                                                            <Binding Path="DataContext.CurrentTrack.FilePath" ElementName="Root" />
                                                                            <Binding Path="DataContext.IsPlaying" ElementName="Root" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Visibility>
                                                                </TextBlock>

                                                                <Button x:Name="HoverPlayBtn"
                                                                        Style="{StaticResource Style.Button.Icon}"
                                                                        Width="26" Height="26"
                                                                        Visibility="Collapsed"
                                                                        Command="{Binding DataContext.PlayTrackInArtistContextCommand, ElementName=Root}"
                                                                        CommandParameter="{Binding}">
                                                                    <Path Width="10" Height="11" Margin="2,0,0,0" Stretch="Uniform"
                                                                          Fill="{StaticResource Brush.Icon.Active}"
                                                                          Data="M1,0.5 L10,5.5 L1,10.5 Z" />
                                                                </Button>
                                                            </Grid>

                                                            <!-- Track Title -->
                                                            <TextBlock x:Name="TitleTxt"
                                                                       Grid.Column="1"
                                                                       Margin="8,0"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding Title}"
                                                                       Style="{StaticResource Text.Body}" />

                                                            <!-- Compact Monochrome Spec Badge -->
                                                            <Border Grid.Column="2"
                                                                    Margin="8,0"
                                                                    Padding="5,2"
                                                                    VerticalAlignment="Center"
                                                                    CornerRadius="{StaticResource Radius.Badge}"
                                                                    Background="{StaticResource Brush.Surface}"
                                                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{Binding StreamSpec.FormattedBadge}"
                                                                           Style="{StaticResource Text.TabularMono}"
                                                                           FontSize="10" />
                                                            </Border>

                                                            <!-- Duration -->
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding FormattedDuration}"
                                                                       Style="{StaticResource Text.TabularMono}"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TrackRowBd" Property="Background" Value="{StaticResource Brush.Hover.Dark}" />
                                                            <Setter TargetName="NumTxt" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="HoverPlayBtn" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                                                    <Binding Path="FilePath" />
                                                                    <Binding Path="DataContext.CurrentTrack.FilePath" ElementName="Root" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter TargetName="TitleTxt" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                                            <Setter TargetName="TitleTxt" Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
