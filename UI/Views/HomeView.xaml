<UserControl x:Class="AuraAudio.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraAudio.UI.Controls"
             xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers"
             AutomationProperties.AutomationId="Aura.Home.Root">

    <UserControl.Resources>
        <!-- Reusable Frameless 164x164 Album SquareLockup Template (Spec B.1 & B.3) -->
        <DataTemplate x:Key="HomeAlbumLockupTemplate">
            <Grid Width="164"
                  Margin="0,0,12,0"
                  Background="Transparent"
                  Cursor="Hand"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  PreviewMouseLeftButtonDown="DraggableCard_PreviewMouseLeftButtonDown"
                  MouseMove="AlbumCard_MouseMove"
                  MouseLeftButtonUp="AlbumCard_MouseLeftButtonUp">
                <Grid.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Play Album"
                                  Command="{Binding PlacementTarget.Tag.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Shuffle Album"
                                  Command="{Binding PlacementTarget.Tag.ShuffleAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Play Next"
                                  Command="{Binding PlacementTarget.Tag.PlayAlbumNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Add to Queue"
                                  Command="{Binding PlacementTarget.Tag.AddAlbumToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Open Album"
                                  Command="{Binding PlacementTarget.Tag.OpenAlbumDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Go to Artist"
                                  Command="{Binding PlacementTarget.Tag.NavigateToArtistLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding Artist}" />
                    </ContextMenu>
                </Grid.ContextMenu>

                <Grid.RowDefinitions>
                    <RowDefinition Height="164" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 164x164 Artwork Surface (ImageBrush respects CornerRadius=8 cleanly) -->
                <Grid x:Name="ArtContainer"
                      Grid.Row="0"
                      Width="164" Height="164"
                      helpers:FluidBehaviors.EnablePressScale="True">
                    <Border CornerRadius="{StaticResource Radius.Card}"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1">
                        <Path Width="34" Height="34" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{StaticResource Brush.Icon.Muted}"
                              StrokeThickness="1.3"
                              Data="M8,22 A3.5,3.5 0 1 1 1,22 A3.5,3.5 0 1 1 8,22 M8,22 L8,4 L24,1.5 L24,19.5 M24,19.5 A3.5,3.5 0 1 1 17,19.5 A3.5,3.5 0 1 1 24,19.5" />
                    </Border>

                    <Border x:Name="ArtFrame"
                            CornerRadius="{StaticResource Radius.Card}"
                            RenderOptions.BitmapScalingMode="Linear"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Grid}" />
                        </Border.Background>
                    </Border>

                    <!-- Hover Overlay: Scrim + Bottom-Left White Play + Bottom-Right Neutral More -->
                    <Border x:Name="HoverOverlay"
                            CornerRadius="{StaticResource Radius.Card}"
                            Background="{StaticResource Brush.Overlay.ArtworkScrim}"
                            Opacity="0">
                        <Grid Margin="10">
                            <Button Width="32" Height="32"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource Style.Button.RoundPlay}"
                                    Command="{Binding DataContext.Home.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Play Album">
                                <Path Width="11" Height="12" Margin="2,0,0,0" Stretch="Uniform"
                                      Fill="{StaticResource Brush.Icon.OnWhite}"
                                      Data="M1,0.5 L11,6 L1,11.5 Z" />
                            </Button>

                            <Button Width="32" Height="32"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Cursor="Hand"
                                    FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                                    Click="MoreButton_Click"
                                    ToolTip="More Options">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="MoreBd"
                                                CornerRadius="16"
                                                Background="{StaticResource Brush.Surface}"
                                                BorderBrush="{StaticResource Brush.Border.Control}"
                                                BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Active}" Margin="1,0" />
                                                <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Active}" Margin="1,0" />
                                                <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Active}" Margin="1,0" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MoreBd" Property="Background" Value="{StaticResource Brush.Elevated}" />
                                                <Setter TargetName="MoreBd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Frameless Metadata Below Artwork -->
                <StackPanel Grid.Row="1" Margin="2,8,2,2">
                    <TextBlock Text="{Binding Title}"
                               Style="{StaticResource Text.BodyEmph}"
                               Foreground="{StaticResource Brush.Text.Primary}" />
                    <DockPanel Margin="0,2,0,0">
                        <Border DockPanel.Dock="Right"
                                Margin="6,0,0,0"
                                Padding="4,1"
                                CornerRadius="{StaticResource Radius.Badge}"
                                BorderBrush="{StaticResource Brush.Border.Control}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                Visibility="{Binding IsHiRes, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="HI-RES"
                                       Style="{StaticResource Text.Footnote}"
                                       FontSize="9"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                        </Border>
                        <TextBlock Text="{Binding Artist}"
                                   Style="{StaticResource Text.Callout}"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                    </DockPanel>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                    <Setter TargetName="ArtFrame" Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 128x128 Circular Artist Lockup Template (Spec B.1) -->
        <DataTemplate x:Key="HomeArtistLockupTemplate">
            <Grid Width="136"
                  Margin="0,0,14,0"
                  Background="Transparent"
                  Cursor="Hand"
                  MouseLeftButtonUp="ArtistCard_MouseLeftButtonUp">
                <Grid.RowDefinitions>
                    <RowDefinition Height="128" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Width="128" Height="128" HorizontalAlignment="Center"
                      helpers:FluidBehaviors.EnablePressScale="True">
                    <Border CornerRadius="64"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1">
                        <Path Width="34" Height="34" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{StaticResource Brush.Icon.Muted}"
                              StrokeThickness="1.3"
                              Data="M12,3 A5,5 0 1 1 12,13 A5,5 0 1 1 12,3 M3,23 C3,17.5 7,15 12,15 C17,15 21,17.5 21,23" />
                    </Border>

                    <Border x:Name="ArtistArtFrame"
                            CornerRadius="64"
                            RenderOptions.BitmapScalingMode="Linear"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="{Binding SampleCoverKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Grid}" />
                        </Border.Background>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="1" Margin="2,8,2,0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               Style="{StaticResource Text.BodyEmph}"
                               TextAlignment="Center"
                               MaxWidth="132" />
                    <TextBlock Text="{Binding SummaryText}"
                               Style="{StaticResource Text.Footnote}"
                               TextAlignment="Center"
                               Margin="0,2,0,0"
                               MaxWidth="132" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ArtistArtFrame" Property="BorderBrush" Value="{StaticResource Brush.Border.ControlHover}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Focusable="False"
                  FocusVisualStyle="{x:Null}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{StaticResource Width.MaxContent}"
                    Margin="{StaticResource Padding.PageContent}">
            <!-- Page Title Header -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Home" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{Binding LibraryStatsText}"
                       Style="{StaticResource Text.Callout}"
                       Foreground="{StaticResource Brush.Text.Tertiary}"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Empty-Library Onboarding CTA (Shown only when 0 tracks indexed) -->
        <Border Padding="36,32"
                CornerRadius="{StaticResource Radius.Sheet}"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border.Hairline}"
                BorderThickness="1"
                HorizontalAlignment="Left"
                MaxWidth="560"
                Visibility="{Binding Home.IsEmptyLibrary, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="No Music in Your Library Yet"
                           Style="{StaticResource Text.Title1}"
                           Margin="0,0,0,8" />
                <TextBlock Text="Add your local music folders to index FLAC, WAV, ALAC, DSD, and MP3 tracks for bit-perfect WASAPI playback."
                           Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20" />
                <Button Style="{StaticResource Style.Button.Primary}"
                        HorizontalAlignment="Left"
                        Content="Open Library Settings"
                        Command="{Binding OpenLibraryManagerCommand}" />
            </StackPanel>
        </Border>

        <!-- Active Editorial Shelves (Real SQLite Data Only) -->
        <StackPanel Visibility="{Binding Home.IsEmptyLibrary, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">

            <!-- Shelf 1: Recently Added -->
            <controls:ShelfCarousel HeaderTitle="Recently Added"
                                    HeaderCommand="{Binding NavigateCommand}"
                                    HeaderCommandParameter="Albums"
                                    ItemsSource="{Binding Home.RecentlyAddedAlbums}"
                                    ItemTemplate="{StaticResource HomeAlbumLockupTemplate}"
                                    Margin="0,0,0,28" />

            <!-- Shelf 2: Jump Back In (Recently Played — Hidden if play_history is empty) -->
            <StackPanel Margin="0,0,0,28"
                        Visibility="{Binding Home.HasRecentlyPlayed, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button HorizontalAlignment="Left"
                        Margin="0,0,0,12"
                        Cursor="Hand"
                        FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="Songs">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <TextBlock x:Name="JumpTitle"
                                           Text="Jump Back In"
                                           Style="{StaticResource Text.Title2}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="JumpChev"
                                           Text="›"
                                           Margin="6,-1,0,0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text.Tertiary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="JumpTitle" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                    <Setter TargetName="JumpTitle" Property="TextDecorations" Value="Underline" />
                                    <Setter TargetName="JumpChev" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Width Probe for responsive Jump Back In columns -->
                <Border x:Name="RecentGridProbe"
                        Height="0"
                        HorizontalAlignment="Stretch"
                        SizeChanged="RecentGridProbe_SizeChanged" />

                <!-- Responsive Edge-to-Edge HorizontalLockup Cards (UniformGrid) -->
                <ItemsControl ItemsSource="{Binding Home.RecentlyPlayedTracks}"
                              HorizontalAlignment="Stretch"
                              Margin="-6,0,-6,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding RecentColumns, ElementName=Root}"
                                         VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="TrackCardBd"
                                    HorizontalAlignment="Stretch"
                                    Height="64"
                                    Margin="6,0,6,12"
                                    Padding="8"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    helpers:FluidBehaviors.EnablePressScale="True"
                                    PreviewMouseLeftButtonDown="DraggableCard_PreviewMouseLeftButtonDown"
                                    MouseMove="TrackCard_MouseMove"
                                    MouseLeftButtonUp="TrackCard_MouseLeftButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="48" Height="48">
                                        <Border CornerRadius="{StaticResource Radius.Control}"
                                                Background="{StaticResource Brush.Elevated}"
                                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                BorderThickness="1" />
                                        <Border CornerRadius="{StaticResource Radius.Control}"
                                                RenderOptions.BitmapScalingMode="Linear"
                                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                BorderThickness="1">
                                            <Border.Background>
                                                <ImageBrush Stretch="UniformToFill"
                                                            ImageSource="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                            </Border.Background>
                                        </Border>
                                        <Border x:Name="PlayOverlay"
                                                CornerRadius="{StaticResource Radius.Control}"
                                                Background="{StaticResource Brush.Overlay.Scrim}"
                                                Opacity="0">
                                            <Path Width="12" Height="13" Margin="2,0,0,0" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Fill="{StaticResource Brush.Icon.Active}"
                                                  Data="M1,0.5 L11,6.5 L1,12.5 Z" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   Style="{StaticResource Text.Subheadline}"
                                                   Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding Artist}"
                                                   Style="{StaticResource Text.Callout}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding FormattedDuration}"
                                               Style="{StaticResource Text.TabularMono}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TrackCardBd" Property="Background" Value="{StaticResource Brush.Elevated}" />
                                    <Setter TargetName="TrackCardBd" Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
                                    <Setter TargetName="PlayOverlay" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Shelf 3: Hi-Res & Lossless Masters (Hidden if no Hi-Res albums exist) -->
            <controls:ShelfCarousel HeaderTitle="Hi-Res &amp; Lossless Masters"
                                    HeaderCommand="{Binding NavigateCommand}"
                                    HeaderCommandParameter="Albums"
                                    ItemsSource="{Binding Home.HiResAlbums}"
                                    ItemTemplate="{StaticResource HomeAlbumLockupTemplate}"
                                    Visibility="{Binding Home.HasHiResAlbums, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="0,0,0,28" />

            <!-- Shelf 4: Your Artists -->
            <controls:ShelfCarousel HeaderTitle="Your Artists"
                                    HeaderCommand="{Binding NavigateCommand}"
                                    HeaderCommandParameter="Artists"
                                    ItemsSource="{Binding Home.FeaturedArtists}"
                                    ItemTemplate="{StaticResource HomeArtistLockupTemplate}"
                                    Margin="0,0,0,12" />
        </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
