<UserControl x:Class="AuraAudio.UI.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraAudio.UI.Controls"
             xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers"
             x:Name="Root"
             AutomationProperties.AutomationId="Aura.Search.Root"
             Background="{StaticResource Brush.Canvas}">

    <UserControl.Resources>
        <!-- Scope Filter Pill RadioButton (Height=28, CornerRadius=14) -->
        <Style x:Key="Style.SearchScopePill" TargetType="RadioButton">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusVisual.Monochrome}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Elevated}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selected.PillFill}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Selected.PillFill}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Selected.PillInk}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search Album Tile Template (164x164 Frameless Lockup) -->
        <DataTemplate x:Key="SearchAlbumTileTemplate">
            <Grid Width="164"
                  Margin="0,0,14,16"
                  Background="Transparent"
                  Cursor="Hand"
                  MouseLeftButtonUp="SearchAlbum_MouseLeftButtonUp">
                <Grid.RowDefinitions>
                    <RowDefinition Height="164" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Width="164" Height="164" helpers:FluidBehaviors.EnablePressScale="True">
                    <Border CornerRadius="{StaticResource Radius.Card}"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1" />
                    <Border CornerRadius="{StaticResource Radius.Card}"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Grid}" />
                        </Border.Background>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="1" Margin="2,8,2,0">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.BodyEmph}" Foreground="{StaticResource Brush.Text.Primary}" />
                    <TextBlock Text="{Binding Artist}" Style="{StaticResource Text.Callout}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Search Artist Circle Template (128x128) -->
        <DataTemplate x:Key="SearchArtistCircleTemplate">
            <StackPanel Width="136"
                        Margin="0,0,16,16"
                        Background="Transparent"
                        Cursor="Hand"
                        MouseLeftButtonUp="SearchArtist_MouseLeftButtonUp">
                <Grid Width="128" Height="128" HorizontalAlignment="Center" helpers:FluidBehaviors.EnablePressScale="True">
                    <Border CornerRadius="64"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1" />
                    <Border CornerRadius="64"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="{Binding SampleCoverKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Grid}" />
                        </Border.Background>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Name}"
                           Style="{StaticResource Text.Subheadline}"
                           Foreground="{StaticResource Brush.Text.Primary}"
                           TextAlignment="Center"
                           Margin="0,8,0,0" />
                <TextBlock Text="{Binding SummaryText}"
                           Style="{StaticResource Text.Footnote}"
                           TextAlignment="Center"
                           Margin="0,2,0,0" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Focusable="False"
                  FocusVisualStyle="{x:Null}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="{StaticResource Width.MaxContent}"
                    Margin="{StaticResource Padding.PageContent}">

            <!-- Page Header -->
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Search" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Style="{StaticResource Text.Callout}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               Margin="0,2,0,0"
                               Text="{Binding Search.Query, StringFormat='Results for &quot;{0}&quot;'}"
                               Visibility="{Binding Search.HasQuery, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <!-- Segmented Scope Bar (All | Songs | Albums | Artists | Playlists) -->
            <WrapPanel Orientation="Horizontal" Margin="0,0,0,24">
                <RadioButton Style="{StaticResource Style.SearchScopePill}"
                             GroupName="SearchScopes"
                             AutomationProperties.AutomationId="Aura.Search.Scope.All"
                             Content="All"
                             IsChecked="{Binding Search.SelectedScope, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource Style.SearchScopePill}"
                             GroupName="SearchScopes"
                             AutomationProperties.AutomationId="Aura.Search.Scope.Songs"
                             Content="Songs"
                             IsChecked="{Binding Search.SelectedScope, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Songs}" />
                <RadioButton Style="{StaticResource Style.SearchScopePill}"
                             GroupName="SearchScopes"
                             AutomationProperties.AutomationId="Aura.Search.Scope.Albums"
                             Content="Albums"
                             IsChecked="{Binding Search.SelectedScope, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Albums}" />
                <RadioButton Style="{StaticResource Style.SearchScopePill}"
                             GroupName="SearchScopes"
                             AutomationProperties.AutomationId="Aura.Search.Scope.Artists"
                             Content="Artists"
                             IsChecked="{Binding Search.SelectedScope, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Artists}" />
                <RadioButton Style="{StaticResource Style.SearchScopePill}"
                             GroupName="SearchScopes"
                             AutomationProperties.AutomationId="Aura.Search.Scope.Playlists"
                             Content="Playlists"
                             IsChecked="{Binding Search.SelectedScope, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Playlists}" />
            </WrapPanel>

            <!-- =================================================================
                 STATE 1: EMPTY QUERY — LOCAL LIBRARY BROWSE BRICKS (16:9)
                 ================================================================= -->
            <StackPanel Visibility="{Binding Search.ShowBrowseLanding, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Browse Local Library"
                           Style="{StaticResource Text.Title2}"
                           Margin="0,0,0,14" />

                <Border x:Name="BricksWidthProbe"
                        Height="0"
                        HorizontalAlignment="Stretch"
                        SizeChanged="BricksWidthProbe_SizeChanged" />

                <ItemsControl ItemsSource="{Binding Search.BrowseBricks}"
                              HorizontalAlignment="Stretch"
                              Margin="-8,0,-8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding BrowseBrickColumns, ElementName=Root}"
                                         VerticalAlignment="Top" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button HorizontalAlignment="Stretch"
                                    Height="138"
                                    Margin="8,0,8,16"
                                    Cursor="Hand"
                                    FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                                    helpers:FluidBehaviors.EnablePressScale="True"
                                    Command="{Binding DataContext.Search.OpenBrowseBrickCommand, ElementName=Root}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BrickBd"
                                                Padding="18,16"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Background="{StaticResource Brush.Surface}"
                                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Border Grid.Row="0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Padding="8,3"
                                                        CornerRadius="{StaticResource Radius.Badge}"
                                                        Background="{StaticResource Brush.Elevated}"
                                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding CountBadge}"
                                                               Style="{StaticResource Text.TabularMono}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource Brush.Text.Secondary}" />
                                                </Border>

                                                <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontFamily="{StaticResource Font.Display}"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource Brush.Text.Peak}" />
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Style="{StaticResource Text.Callout}"
                                                               Foreground="{StaticResource Brush.Text.Tertiary}"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BrickBd" Property="Background" Value="{StaticResource Brush.Elevated}" />
                                                <Setter TargetName="BrickBd" Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- =================================================================
                 STATE 2: NO RESULTS FOR QUERY
                 ================================================================= -->
            <Border Padding="28,24"
                    CornerRadius="{StaticResource Radius.Sheet}"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    Visibility="{Binding Search.ShowNoResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="No matching results"
                               Style="{StaticResource Text.Title2}" />
                    <TextBlock Text="Try a different keyword or switch the scope pill above."
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- =================================================================
                 STATE 3: CATEGORIZED MULTI-ENTITY SEARCH RESULTS
                 ================================================================= -->
            <!-- Top Result Card (360px) + Songs Split -->
            <Grid Margin="0,0,0,28"
                  Visibility="{Binding Search.ShowSongsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Top Result Card -->
                <StackPanel Grid.Column="0"
                            Width="340"
                            Margin="0,0,24,0"
                            Visibility="{Binding Search.ShowTopResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Top Result" Style="{StaticResource Text.Title2}" Margin="0,0,0,12" />
                    <Border Padding="18"
                            CornerRadius="{StaticResource Radius.Card}"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1"
                            Cursor="Hand"
                            MouseLeftButtonUp="TopResultCard_MouseLeftButtonUp">
                        <StackPanel>
                            <Grid Width="96" Height="96" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <Border CornerRadius="{StaticResource Radius.Card}"
                                        Background="{StaticResource Brush.Elevated}"
                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                        BorderThickness="1" />
                                <Border CornerRadius="{StaticResource Radius.Card}"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{Binding Search.TopResult.CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Grid}" />
                                    </Border.Background>
                                </Border>
                            </Grid>

                            <TextBlock Text="{Binding Search.TopResult.Title}"
                                       Style="{StaticResource Text.Title1}"
                                       FontSize="20"
                                       LineHeight="26" />
                            <TextBlock Text="{Binding Search.TopResult.Artist}"
                                       Style="{StaticResource Text.Body}"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Search.TopResult.Album}"
                                       Style="{StaticResource Text.Callout}"
                                       Foreground="{StaticResource Brush.Text.Tertiary}"
                                       Margin="0,2,0,14" />

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Style.Button.Primary}"
                                        Height="32"
                                        Padding="16,0"
                                        Content="Play"
                                        Command="{Binding PlaySelectedTrackCommand}"
                                        CommandParameter="{Binding Search.TopResult}" />
                                <Button Style="{StaticResource Style.Button.Secondary}"
                                        Height="32"
                                        Margin="8,0,0,0"
                                        Padding="12,0"
                                        Content="Get Info"
                                        Command="{Binding OpenInfoForTrackCommand}"
                                        CommandParameter="{Binding Search.TopResult}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Matching Songs List (Inline non-scrolling ListBox) -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Songs" Style="{StaticResource Text.Title2}" Margin="0,0,0,12" />
                    <Border BorderBrush="{StaticResource Brush.Border.Hairline}" BorderThickness="0,1,0,0">
                        <ListBox Style="{StaticResource Style.ListBox.Inline}"
                                 ItemsSource="{Binding Search.MatchingTracks}"
                                 AlternationCount="2"
                                 MouseDoubleClick="SearchTrackList_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Height" Value="{StaticResource Height.Row}" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusVisual.Monochrome}" />
                                    <Setter Property="Tag" Value="{Binding DataContext, ElementName=Root}" />
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Play"
                                                          Command="{Binding PlacementTarget.Tag.PlaySelectedTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Play Next"
                                                          Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Add to Queue"
                                                          Command="{Binding PlacementTarget.Tag.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Add to Playlist..."
                                                          Command="{Binding PlacementTarget.Tag.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Go to Artist"
                                                          Command="{Binding PlacementTarget.Tag.NavigateToArtistLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Go to Album"
                                                          Command="{Binding PlacementTarget.Tag.NavigateToAlbumLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Get Info"
                                                          InputGestureText="Ctrl+I"
                                                          Command="{Binding PlacementTarget.Tag.OpenInfoForTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Inspect Audio Authenticity"
                                                          Command="{Binding PlacementTarget.Tag.InspectTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Show in Explorer"
                                                          Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="RowBd"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                        BorderThickness="0,0,0,0.5"
                                                        CornerRadius="{StaticResource Radius.Small}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                        <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.Overlay.ZebraRow}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.Hover.Dark}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.SelectedRow}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="32" Height="32">
                                            <Border CornerRadius="{StaticResource Radius.Small}"
                                                    Background="{StaticResource Brush.Elevated}"
                                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                    BorderThickness="1" />
                                            <Border CornerRadius="{StaticResource Radius.Small}"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                    BorderThickness="1">
                                                <Border.Background>
                                                    <ImageBrush Stretch="UniformToFill"
                                                                ImageSource="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                                </Border.Background>
                                            </Border>
                                            <Button x:Name="HoverPlayBtn"
                                                    Visibility="Collapsed"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.PlaySelectedTrackCommand, ElementName=Root}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border CornerRadius="{StaticResource Radius.Small}" Background="{StaticResource Brush.Overlay.Scrim}">
                                                            <Path Width="10" Height="11" Margin="2,0,0,0" Stretch="Uniform"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Fill="{StaticResource Brush.Icon.Active}"
                                                                  Data="M1,0.5 L10,5.5 L1,10.5 Z" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subheadline}" />
                                            <TextBlock Text="{Binding Artist}" Style="{StaticResource Text.Footnote}" />
                                        </StackPanel>

                                        <Border Grid.Column="2"
                                                Margin="6,0"
                                                Padding="5,2"
                                                VerticalAlignment="Center"
                                                CornerRadius="{StaticResource Radius.Badge}"
                                                Background="{StaticResource Brush.Surface}"
                                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding StreamSpec.FormattedBadge}" Style="{StaticResource Text.TabularMono}" FontSize="10" />
                                        </Border>

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding FormattedDuration}"
                                                   Style="{StaticResource Text.TabularMono}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="HoverPlayBtn" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Matching Albums Shelf -->
            <controls:ShelfCarousel HeaderTitle="Albums"
                                    HeaderCommand="{Binding NavigateCommand}"
                                    HeaderCommandParameter="Albums"
                                    ItemsSource="{Binding Search.MatchingAlbums}"
                                    ItemTemplate="{StaticResource SearchAlbumTileTemplate}"
                                    Margin="0,0,0,28"
                                    Visibility="{Binding Search.ShowAlbumsSection, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Matching Artists Shelf -->
            <controls:ShelfCarousel HeaderTitle="Artists"
                                    HeaderCommand="{Binding NavigateCommand}"
                                    HeaderCommandParameter="Artists"
                                    ItemsSource="{Binding Search.MatchingArtists}"
                                    ItemTemplate="{StaticResource SearchArtistCircleTemplate}"
                                    Margin="0,0,0,28"
                                    Visibility="{Binding Search.ShowArtistsSection, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- Matching Playlists -->
            <StackPanel Visibility="{Binding Search.ShowPlaylistsSection, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Playlists" Style="{StaticResource Text.Title2}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Search.MatchingPlaylists}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,12,12"
                                    Padding="16,12"
                                    Cursor="Hand"
                                    FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                                    Command="{Binding DataContext.OpenPlaylistCommand, ElementName=Root}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="PlBd"
                                                Padding="{TemplateBinding Padding}"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Background="{StaticResource Brush.Surface}"
                                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.BodyEmph}" Foreground="{StaticResource Brush.Text.Peak}" />
                                                <TextBlock Text="{Binding SummaryText}" Style="{StaticResource Text.Footnote}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PlBd" Property="Background" Value="{StaticResource Brush.Elevated}" />
                                                <Setter TargetName="PlBd" Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
