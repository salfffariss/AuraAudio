<UserControl x:Class="AuraAudio.UI.Views.SongsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraAudio.UI.Controls"
             xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers"
             Background="{StaticResource Brush.Canvas}">

    <UserControl.Resources>
        <!-- Column Browser Compact ListBoxItem -->
        <Style x:Key="Style.BrowserItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusVisual.Monochrome}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Small}"
                                Margin="4,1"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover.Dark}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selected.PillFill}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Selected.PillInk}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monochrome DataGrid ColumnHeader (44px, Sortable, Reorderable, Right-Click Column Menu) -->
        <Style x:Key="Style.Songs.ColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="{StaticResource Height.GridHeader}" />
            <Setter Property="Background" Value="{StaticResource Brush.Canvas}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Hairline}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border x:Name="HdrBd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentPresenter VerticalAlignment="Center" />
                                    <TextBlock x:Name="SortGlyph"
                                               Margin="5,0,0,0"
                                               FontSize="9"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Text.Peak}"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            <Thumb x:Name="PART_RightHeaderGripper"
                                   HorizontalAlignment="Right"
                                   Width="6"
                                   Cursor="SizeWE"
                                   Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                <Setter TargetName="HdrBd" Property="Background" Value="{StaticResource Brush.Surface}" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter TargetName="SortGlyph" Property="Text" Value="▲" />
                                <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter TargetName="SortGlyph" Property="Text" Value="▼" />
                                <Setter TargetName="SortGlyph" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monochrome DataGridCell (No default blue focus border) -->
        <Style x:Key="Style.Songs.Cell" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Monochrome DataGridRow (40px, Zebra #08FFFFFF, Hover N20, Selected N25 + 3px Left White Bar) -->
        <Style x:Key="Style.Songs.Row" TargetType="DataGridRow">
            <Setter Property="Height" Value="{StaticResource Height.Row}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Play"
                                  Command="{Binding PlacementTarget.Tag.PlaySelectedTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Play Next"
                                  Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Add to Queue"
                                  Command="{Binding PlacementTarget.Tag.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Add to Playlist..."
                                  Command="{Binding PlacementTarget.Tag.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Go to Artist"
                                  Command="{Binding PlacementTarget.Tag.NavigateToArtistLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Go to Album"
                                  Command="{Binding PlacementTarget.Tag.NavigateToAlbumLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <Separator />
                        <MenuItem Header="Get Info"
                                  InputGestureText="Ctrl+I"
                                  Command="{Binding PlacementTarget.Tag.OpenInfoForTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Inspect Audio Authenticity"
                                  Command="{Binding PlacementTarget.Tag.InspectTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                        <MenuItem Header="Show in Explorer"
                                  Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                BorderThickness="0,0,0,0.5"
                                CornerRadius="{StaticResource Radius.Small}">
                            <Grid>
                                <!-- 3px Pure White Selected Left Bar -->
                                <Border x:Name="SelectedBar"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        CornerRadius="1.5"
                                        Margin="0,4"
                                        Background="{StaticResource Brush.Border.Strong}"
                                        Visibility="Collapsed" />
                                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.Overlay.ZebraRow}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.Hover.Dark}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.SelectedRow}" />
                                <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clickable Metadata Link Style (Artist / Album inside Rows) -->
        <Style x:Key="Style.RowMetaLink" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Primary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusVisual.Monochrome}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="LinkText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   TextTrimming="CharacterEllipsis" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkText" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                <Setter TargetName="LinkText" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="{StaticResource Width.MaxContent}" Margin="30,24,30,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Row: Songs Title + Play All / Shuffle / Column Browser Toggle -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Songs" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{Binding LibraryStatsText}"
                           Style="{StaticResource Text.Callout}"
                           Foreground="{StaticResource Brush.Text.Tertiary}"
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Style.Button.Primary}"
                        Content="Play All"
                        Command="{Binding PlayAllTracksCommand}" />
                <Button Style="{StaticResource Style.Button.Secondary}"
                        Margin="8,0,0,0"
                        Content="Shuffle"
                        Command="{Binding ShuffleAllTracksCommand}" />
                <ToggleButton Margin="10,0,0,0"
                              Height="36"
                              Padding="14,0"
                              AutomationProperties.AutomationId="Aura.Songs.ColumnBrowserToggle"
                              IsChecked="{Binding IsColumnBrowserVisible, Mode=TwoWay}"
                              Cursor="Hand"
                              FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                              ToolTip="Toggle 3-Column Library Browser (Format / Artist / Album)">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Bd"
                                    CornerRadius="{StaticResource Radius.ButtonPill}"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{StaticResource Brush.Button.SecondaryFill}"
                                    BorderBrush="{StaticResource Brush.Border.Control}"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path x:Name="IconPath" Width="14" Height="12" Stretch="Uniform"
                                          Margin="0,0,7,0"
                                          Stroke="{StaticResource Brush.Text.Primary}"
                                          StrokeThickness="1.3"
                                          Data="M1,1 L13,1 L13,11 L1,11 Z M5,1 L5,11 M9,1 L9,11" />
                                    <TextBlock x:Name="LabelText"
                                               Text="Column Browser"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text.Primary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Button.SecondaryHover}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.ControlHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selected.PillFill}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Selected.PillFill}" />
                                    <Setter TargetName="LabelText" Property="Foreground" Value="{StaticResource Brush.Selected.PillInk}" />
                                    <Setter TargetName="IconPath" Property="Stroke" Value="{StaticResource Brush.Selected.PillInk}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Optional 3-Pane Cascading ColumnBrowser (156px tall: Format | Artist | Album) -->
        <Border Grid.Row="1"
                Height="156"
                Margin="0,0,0,14"
                CornerRadius="{StaticResource Radius.Card}"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border.Hairline}"
                BorderThickness="1"
                Visibility="{Binding IsColumnBrowserVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Pane 1: Format / Codec -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="FORMAT / CODEC" Style="{StaticResource Text.Eyebrow}" Margin="12,8,8,4" />
                    <ListBox Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding ColumnBrowserFormats}"
                             SelectedItem="{Binding SelectedBrowserFormat, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource Style.BrowserItem}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" />
                </Grid>

                <!-- Pane 2: Artist -->
                <Border Grid.Column="1" BorderBrush="{StaticResource Brush.Border.Hairline}" BorderThickness="1,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="ARTIST" Style="{StaticResource Text.Eyebrow}" Margin="12,8,8,4" />
                        <ListBox Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding ColumnBrowserArtists}"
                                 SelectedItem="{Binding SelectedBrowserArtist, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource Style.BrowserItem}"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" />
                    </Grid>
                </Border>

                <!-- Pane 3: Album -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ALBUM" Style="{StaticResource Text.Eyebrow}" Margin="12,8,8,4" />
                    <ListBox Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding ColumnBrowserAlbums}"
                             SelectedItem="{Binding SelectedBrowserAlbum, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource Style.BrowserItem}"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" />
                </Grid>
            </Grid>
        </Border>

        <!-- Empty State -->
        <Border Grid.Row="2"
                VerticalAlignment="Top"
                Padding="28,24"
                CornerRadius="{StaticResource Radius.Sheet}"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border.Hairline}"
                BorderThickness="1"
                Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding EmptyLibraryTitle}" Style="{StaticResource Text.Title2}" />
                <TextBlock Text="{Binding EmptyLibraryDesc}"
                           Style="{StaticResource Text.Callout}"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- Virtualized Monochrome Songs DataGrid (44px Sticky Reorderable Header, 40px Rows) -->
        <DataGrid x:Name="SongsDataGrid"
                  Grid.Row="2"
                  AutomationProperties.AutomationId="Aura.Songs.DataGrid"
                  ItemsSource="{Binding DisplayedTracks}"
                  SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                  Visibility="{Binding IsLibraryEmpty, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                  Background="Transparent"
                  BorderThickness="0"
                  RowBackground="Transparent"
                  AlternatingRowBackground="{StaticResource Brush.Overlay.ZebraRow}"
                  AlternationCount="2"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="False"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ColumnHeaderStyle="{StaticResource Style.Songs.ColumnHeader}"
                  CellStyle="{StaticResource Style.Songs.Cell}"
                  RowStyle="{StaticResource Style.Songs.Row}"
                  DropLocationIndicatorStyle="{x:Null}"
                  Padding="0,0,0,104"
                  MouseDoubleClick="SongsDataGrid_MouseDoubleClick"
                  PreviewKeyDown="SongsDataGrid_PreviewKeyDown"
                  PreviewMouseLeftButtonDown="SongsDataGrid_PreviewMouseLeftButtonDown"
                  MouseMove="SongsDataGrid_MouseMove">

            <!-- Right-Click Column Header Visibility ContextMenu (Spec B.2) -->
            <DataGrid.Resources>
                <ContextMenu x:Key="ColumnVisibilityMenu">
                    <MenuItem Header="Artist" IsCheckable="True" IsChecked="True" Tag="ColArtist" Click="ToggleColumnVisibility_Click" />
                    <MenuItem Header="Album" IsCheckable="True" IsChecked="True" Tag="ColAlbum" Click="ToggleColumnVisibility_Click" />
                    <MenuItem Header="Year" IsCheckable="True" IsChecked="False" Tag="ColYear" Click="ToggleColumnVisibility_Click" />
                    <MenuItem Header="Format" IsCheckable="True" IsChecked="True" Tag="ColFormat" Click="ToggleColumnVisibility_Click" />
                    <MenuItem Header="Bitrate" IsCheckable="True" IsChecked="False" Tag="ColBitrate" Click="ToggleColumnVisibility_Click" />
                    <MenuItem Header="Time" IsCheckable="True" IsChecked="True" Tag="ColTime" Click="ToggleColumnVisibility_Click" />
                </ContextMenu>
                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource Style.Songs.ColumnHeader}">
                    <Setter Property="ContextMenu" Value="{StaticResource ColumnVisibilityMenu}" />
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <!-- Col 0: # / Hover Play / Active BouncyBar -->
                <DataGridTemplateColumn Header="#" Width="48" CanUserReorder="False" CanUserResize="False" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="28" Height="28">
                                <!-- Active Playing Equalizer -->
                                <controls:BouncyBarControl HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:BouncyBarControl.IsActive>
                                        <MultiBinding Converter="{StaticResource ActiveTrackPlayingMultiConverter}">
                                            <Binding Path="FilePath" />
                                            <Binding Path="DataContext.CurrentTrack.FilePath" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="DataContext.IsPlaying" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </controls:BouncyBarControl.IsActive>
                                    <controls:BouncyBarControl.Visibility>
                                        <MultiBinding Converter="{StaticResource ActiveTrackPlayingMultiConverter}">
                                            <Binding Path="FilePath" />
                                            <Binding Path="DataContext.CurrentTrack.FilePath" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="DataContext.IsPlaying" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </controls:BouncyBarControl.Visibility>
                                </controls:BouncyBarControl>

                                <!-- Track Number (hidden when playing or row hovered) -->
                                <TextBlock x:Name="TrackNumText"
                                           Text="{Binding TrackNumber}"
                                           Style="{StaticResource Text.TabularMono}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Visibility>
                                        <MultiBinding Converter="{StaticResource ActiveTrackPlayingMultiConverter}" ConverterParameter="Inverse">
                                            <Binding Path="FilePath" />
                                            <Binding Path="DataContext.CurrentTrack.FilePath" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="DataContext.IsPlaying" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </TextBlock.Visibility>
                                </TextBlock>

                                <!-- Hover Play Glyph -->
                                <Button x:Name="HoverPlayBtn"
                                        Style="{StaticResource Style.Button.Icon}"
                                        Width="26" Height="26"
                                        Visibility="Collapsed"
                                        Command="{Binding DataContext.PlaySelectedTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Play">
                                    <Path Width="10" Height="11" Margin="2,0,0,0" Stretch="Uniform"
                                          Fill="{StaticResource Brush.Icon.Active}"
                                          Data="M1,0.5 L10,5.5 L1,10.5 Z" />
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter TargetName="TrackNumText" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="HoverPlayBtn" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Col 1: 32x32 Art + Title + Hover More -->
                <DataGridTemplateColumn Header="TITLE" Width="2*" MinWidth="220" SortMemberPath="Title">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 32x32 Rounded 4px Art via ImageBrush -->
                                <Grid Grid.Column="0" Width="32" Height="32">
                                    <Border CornerRadius="{StaticResource Radius.Small}"
                                            Background="{StaticResource Brush.Elevated}"
                                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                                            BorderThickness="1" />
                                    <Border CornerRadius="{StaticResource Radius.Small}"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                                            BorderThickness="1">
                                        <Border.Background>
                                            <ImageBrush Stretch="UniformToFill"
                                                        ImageSource="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="TitleText"
                                           Grid.Column="1"
                                           Margin="10,0,8,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding Title}"
                                           Style="{StaticResource Text.Body}" />

                                <Button x:Name="RowMoreBtn"
                                        Grid.Column="2"
                                        Style="{StaticResource Style.Button.Icon}"
                                        Width="26" Height="26"
                                        Visibility="Collapsed"
                                        Click="RowMoreButton_Click"
                                        ToolTip="More Options">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Default}" Margin="1,0" />
                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Default}" Margin="1,0" />
                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Default}" Margin="1,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                    <Setter TargetName="RowMoreBtn" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                            <Binding Path="FilePath" />
                                            <Binding Path="DataContext.CurrentTrack.FilePath" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                    <Setter TargetName="TitleText" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Col 2: Artist Link -->
                <DataGridTemplateColumn x:Name="ColArtist" Header="ARTIST" Width="1.1*" MinWidth="120" SortMemberPath="Artist">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Style.RowMetaLink}"
                                    Content="{Binding Artist}"
                                    Command="{Binding DataContext.NavigateToArtistLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Col 3: Album Link -->
                <DataGridTemplateColumn x:Name="ColAlbum" Header="ALBUM" Width="1.2*" MinWidth="120" SortMemberPath="Album">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Style.RowMetaLink}"
                                    Content="{Binding Album}"
                                    Command="{Binding DataContext.NavigateToAlbumLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Col 4: Year (Toggleable via header context menu) -->
                <DataGridTextColumn x:Name="ColYear" Header="YEAR" Width="68" Visibility="Collapsed" Binding="{Binding Year}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.TabularMono}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Col 5: Pure-Monochrome Format Badge -->
                <DataGridTemplateColumn x:Name="ColFormat" Header="FORMAT" Width="140" SortMemberPath="StreamSpec.SampleRateHz">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border x:Name="FormatPill"
                                    HorizontalAlignment="Left"
                                    Padding="6,2"
                                    CornerRadius="{StaticResource Radius.Badge}"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1">
                                <TextBlock x:Name="FormatText"
                                           Text="{Binding StreamSpec.FormattedBadge}"
                                           Style="{StaticResource Text.TabularMono}"
                                           FontSize="10"
                                           Foreground="{StaticResource Brush.Text.Secondary}" />
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding StreamSpec.IsHiRes}" Value="True">
                                    <Setter TargetName="FormatPill" Property="Background" Value="{StaticResource Brush.Elevated}" />
                                    <Setter TargetName="FormatPill" Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
                                    <Setter TargetName="FormatText" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                    <Setter TargetName="FormatText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Col 6: Bitrate (Toggleable via header context menu) -->
                <DataGridTextColumn x:Name="ColBitrate" Header="BITRATE" Width="92" Visibility="Collapsed"
                                    Binding="{Binding StreamSpec.BitrateKbps, StringFormat={}{0} kbps}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.TabularMono}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Col 7: Time -->
                <DataGridTemplateColumn x:Name="ColTime" Header="TIME" Width="70" SortMemberPath="Duration">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FormattedDuration}"
                                       Style="{StaticResource Text.TabularMono}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
