<Window x:Class="AuraAudio.UI.Views.LibraryManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{DynamicResource Str_Fld_WindowTitle}" 
        Height="620" Width="680"
        MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Background.Window}"
        Foreground="{StaticResource Brush.Text.Primary}">

    <Window.Resources>
        <ResourceDictionary Source="/UI/Styles/ModernTheme.xaml" />
    </Window.Resources>

    <!-- Dialog Frame dengan Sudut Membulat -->
    <Border Background="{StaticResource Brush.Background.Window}" 
            BorderBrush="{StaticResource Brush.Border.Light}" 
            BorderThickness="1" 
            CornerRadius="12">
        <Grid Margin="22,18,22,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="*" />    <!-- Content Tab / Lists -->
                <RowDefinition Height="Auto" /> <!-- Fixed Action Panel (Rescan & Purge) -->
                <RowDefinition Height="Auto" /> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 1. HEADER MODAL -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.Folder}" Stroke="{StaticResource Brush.Accent.Gold}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Fld_Title}" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource Brush.Text.Primary}" />
                    </StackPanel>
                    <TextBlock Text="{DynamicResource Str_Fld_Desc}" 
                               FontSize="11.5" 
                               Foreground="{StaticResource Brush.Text.Secondary}" 
                               Margin="0,3,0,0" />
                </StackPanel>

                <!-- Tombol Tutup X -->
                <Button Grid.Column="1" 
                        Style="{StaticResource Style.Button.ModalClose}" 
                        Click="CloseButton_Click"
                        VerticalAlignment="Top" 
                        AutomationProperties.Name="{DynamicResource Str_Btn_Close}"
                        ToolTip="{DynamicResource Str_Btn_Close}">
                    <Path Data="{StaticResource Icon.Close}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- 2. CONTENT AREA: TAB KELOLA FOLDER & OPSI EKSPOR -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="tabBorder" 
                                                Background="Transparent" 
                                                BorderThickness="0,0,0,2" 
                                                BorderBrush="Transparent"
                                                Padding="12,6" 
                                                Margin="0,0,12,6"
                                                Cursor="Hand">
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Gold}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- TAB 1: FOLDER TERPANTAU (INCLUDED) -->
                    <TabItem Header="{DynamicResource Str_Fld_TabMonitored}">
                        <Border Background="{StaticResource Brush.Background.Card}" 
                                BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="14" 
                                Margin="0,4,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" 
                                           Text="{DynamicResource Str_Fld_TabMonitoredDesc}" 
                                           FontSize="11.5" 
                                           Foreground="{StaticResource Brush.Text.Tertiary}" 
                                           Margin="0,0,0,8" />

                                <!-- List Direktori Terpantau -->
                                <Border Grid.Row="1" Background="{StaticResource Brush.Background.Input}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                                    <ListBox x:Name="FoldersListBox" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             Foreground="{StaticResource Brush.Text.Primary}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4,4">
                                                    <Path Data="{StaticResource Icon.Folder}" Stroke="{StaticResource Brush.Accent.Gold}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <!-- Tombol Tambah & Hapus -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" 
                                            Style="{StaticResource Style.Button.Transport}"
                                            Click="AddFolder_Click"
                                            Height="32">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Plus}" Stroke="{StaticResource Brush.Text.Primary}" StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Str_Fld_AddFolderBtn}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" 
                                            Style="{StaticResource Style.Button.Transport}"
                                            Click="RemoveFolder_Click"
                                            Height="32">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Trash}" Stroke="{StaticResource Brush.Accent.Red}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Str_Fld_RemoveFolderBtn}" FontSize="11.5" Foreground="{StaticResource Brush.Accent.Red}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- TAB 2: FOLDER DIKECUALIKAN / BLACKLIST (EXCLUDED) -->
                    <TabItem Header="{DynamicResource Str_Fld_TabExcluded}">
                        <Border Background="{StaticResource Brush.Background.Card}" 
                                BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="14" 
                                Margin="0,4,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" 
                                           Text="{DynamicResource Str_Fld_TabExcludedDesc}" 
                                           FontSize="11" 
                                           Foreground="{StaticResource Brush.Text.Tertiary}" 
                                           Margin="0,0,0,8" />

                                <!-- List Direktori yang Dikecualikan -->
                                <Border Grid.Row="1" Background="{StaticResource Brush.Background.Input}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                                    <ListBox x:Name="ExcludedListBox" 
                                             Background="Transparent" 
                                             BorderThickness="0" 
                                             Foreground="{StaticResource Brush.Text.Primary}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="4,4">
                                                    <Path Data="{StaticResource Icon.Minus}" Stroke="{StaticResource Brush.Accent.Red}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <!-- Tombol Tambah & Hapus Pengecualian -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" 
                                            Style="{StaticResource Style.Button.Transport}"
                                            Click="AddExcludedFolder_Click"
                                            Height="32">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Plus}" Stroke="{StaticResource Brush.Text.Primary}" StrokeThickness="1.6" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Str_Fld_AddExcludedBtn}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" 
                                            Style="{StaticResource Style.Button.Transport}"
                                            Click="RemoveExcludedFolder_Click"
                                            Height="32">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Trash}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{DynamicResource Str_Fld_RemoveExcludedBtn}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </TabItem>

                    <!-- TAB 3: OPSI PEMINDAIAN & EKSPOR -->
                    <TabItem Header="{DynamicResource Str_Fld_TabOptions}">
                        <Border Background="{StaticResource Brush.Background.Card}" 
                                BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="16" 
                                Margin="0,4,0,0">
                            <StackPanel>
                                <CheckBox x:Name="AutoScanCheckBox" 
                                          Content="{DynamicResource Str_Fld_AutoScanLabel}" 
                                          Foreground="{StaticResource Brush.Text.Primary}" 
                                          FontSize="12" 
                                          Margin="0,4,0,16" 
                                          IsChecked="True" />

                                <TextBlock Text="{DynamicResource Str_Fld_ExportLabel}" 
                                           FontSize="11.5" 
                                           Foreground="{StaticResource Brush.Text.Secondary}" 
                                           Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ExportDirectoryTextBox" 
                                             Grid.Column="0" 
                                             Height="32" 
                                             Background="{StaticResource Brush.Background.Input}" 
                                             Foreground="{StaticResource Brush.Text.Primary}" 
                                             BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                             BorderThickness="1" 
                                             VerticalContentAlignment="Center" 
                                             Padding="8,0" 
                                             IsReadOnly="True" 
                                             FontSize="11.5" />
                                    <Button Grid.Column="2" 
                                            Style="{StaticResource Style.Button.Transport}"
                                            Click="BrowseExportDirectory_Click"
                                            Height="32" 
                                            Padding="14,0">
                                        <TextBlock Text="{DynamicResource Str_Fld_BrowseBtn}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Primary}" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- 3. FIXED MAINTENANCE & ACTION PANEL (SELALU TERLIHAT) -->
            <Border Grid.Row="2" 
                    Background="{StaticResource Brush.Background.Card}" 
                    BorderBrush="{StaticResource Brush.Border.Subtle}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14,12" 
                    Margin="0,0,0,12">
                <StackPanel>
                    <!-- Status Progres -->
                    <TextBlock x:Name="StatusTextBlock" 
                               Text="{DynamicResource Str_Fld_StatusReady}" 
                               FontSize="11.5" 
                               Foreground="{StaticResource Brush.Accent.Cyan}" 
                               Margin="0,0,0,5" />
                    <ProgressBar x:Name="ScanProgressBar" 
                                 Height="4" 
                                 Background="{StaticResource Brush.Background.Sidebar}" 
                                 Foreground="{StaticResource Brush.Accent.Gold}" 
                                 BorderThickness="0" 
                                 IsIndeterminate="False" 
                                 Margin="0,0,0,10" />

                    <!-- Tombol Aksi: Rescan dan Purge -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" 
                                x:Name="RescanButton"
                                Style="{StaticResource Style.Button.Transport}"
                                Click="RescanLibrary_Click"
                                Height="34">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Refresh}" Stroke="{StaticResource Brush.Accent.Gold}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="RescanButtonLabel" Text="{DynamicResource Str_Fld_RescanBtn}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" 
                                x:Name="PurgeButton"
                                Style="{StaticResource Style.Button.Transport}"
                                Click="PurgeLibrary_Click"
                                Height="34">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Trash}" Stroke="{StaticResource Brush.Accent.Red}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str_Fld_PurgeBtn}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Red}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. ACTION FOOTER -->
            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Brush.Border.Subtle}" Padding="0,10,0,0">
                <Grid>
                    <TextBlock Text="{DynamicResource Str_Fld_FooterNote}" 
                               VerticalAlignment="Center" 
                               FontSize="11" 
                               Foreground="{StaticResource Brush.Text.Tertiary}" />
                    <Button HorizontalAlignment="Right" 
                            Style="{StaticResource Style.Button.Primary}"
                            Click="SaveAndClose_Click"
                            Height="34" 
                            Padding="24,0">
                        <TextBlock Text="{DynamicResource Str_Fld_DoneBtn}" FontSize="12" FontWeight="Bold" Foreground="#111114" />
                    </Button>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
