<UserControl x:Class="AuraAudio.UI.Views.AuthenticityInspectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:views="clr-namespace:AuraAudio.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="950">

    <Grid Background="{StaticResource Brush.Background.Window}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,28">
                <!-- Header Halaman & Aksi -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="{DynamicResource Str_Inspect_Title}" 
                                   FontSize="22" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource Brush.Text.Primary}" />
                        <TextBlock Text="{DynamicResource Str_Inspect_Subtitle}" 
                                   TextWrapping="Wrap"
                                   FontSize="12.5" 
                                   Foreground="{StaticResource Brush.Text.Secondary}" 
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Style.Button.Transport}" 
                                Command="{Binding OpenInspectFileDialogCommand}"
                                Padding="14,0" Margin="0,0,10,0"
                                ToolTip="{DynamicResource Str_Inspect_OpenFile}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Folder}" 
                                      Stroke="{StaticResource Brush.Text.Secondary}" 
                                      StrokeThickness="1.6" 
                                      Width="13" Height="13" Stretch="Uniform" 
                                      Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str_Inspect_OpenFile}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource Style.Button.Transport}" 
                                Command="{Binding AnalyzeTrackCommand}"
                                IsEnabled="{Binding HasActiveIntegrityReport}"
                                Padding="14,0"
                                ToolTip="{DynamicResource Str_Inspect_Rescan}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Refresh}" 
                                      Stroke="{StaticResource Brush.Accent.Gold}" 
                                      StrokeThickness="1.7" 
                                      Width="13" Height="13" Stretch="Uniform" 
                                      Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str_Inspect_Rescan}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Gold}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- State 1: Empty State -->
                <Border Background="{StaticResource Brush.Background.Card}"
                        BorderBrush="{StaticResource Brush.Border.Subtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="36,44"
                        Visibility="{Binding IsInspectorEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="460">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#1E1E25" BorderBrush="#282832" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Path Data="{StaticResource Icon.WaveformCheck}"
                                  Stroke="{StaticResource Brush.Accent.Gold}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="22" Height="22" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{DynamicResource Str_Inspect_EmptyTitle}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Inspect_EmptyDesc}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,8,0,20" LineHeight="19" />
                        <Button Style="{StaticResource Style.Button.Primary}"
                                Command="{Binding OpenInspectFileDialogCommand}"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Folder}" Stroke="#111114" StrokeThickness="1.7" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str_Inspect_OpenFile}" FontWeight="Bold" Foreground="#111114" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- State 2: Error State -->
                <Border Background="{StaticResource Brush.Background.Card}"
                        BorderBrush="{StaticResource Brush.Accent.Red}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="28,32"
                        Visibility="{Binding HasAnalysisError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" MaxWidth="520">
                        <Path Data="{StaticResource Icon.AlertTriangle}"
                              Stroke="{StaticResource Brush.Accent.Red}"
                              StrokeThickness="1.8"
                              Width="28" Height="28" Stretch="Uniform"
                              HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="{DynamicResource Str_Inspect_ErrorTitle}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding AnalysisErrorMessage}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Margin="0,8,0,18" LineHeight="19" />
                        <Button Style="{StaticResource Style.Button.Transport}"
                                Command="{Binding OpenInspectFileDialogCommand}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_Inspect_ChooseAnother}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- State 3: Active Report -->
                <StackPanel Visibility="{Binding HasActiveIntegrityReport, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- Track Info Strip -->
                    <Border Background="{StaticResource Brush.Background.Card}" 
                            BorderBrush="{StaticResource Brush.Border.Subtle}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="16,12" 
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" ClipToBounds="True" Background="#1E1E25" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Grid>
                                    <Path Data="{StaticResource Icon.MusicNote}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image Source="{Binding InspectedTrack.CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding InspectedTrack.Title}" 
                                           FontSize="15" FontWeight="Bold" 
                                           Foreground="{StaticResource Brush.Text.Primary}" 
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding InspectedTrack.Artist}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" />
                                    <TextBlock Text=" • " FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                    <TextBlock Text="{Binding InspectedTrack.Album}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" />
                                </StackPanel>
                                <TextBlock Text="{Binding InspectedTrack.FilePath}" 
                                           FontFamily="{StaticResource FontFamily.Mono}"
                                           FontSize="10.5" 
                                           Foreground="{StaticResource Brush.Text.Tertiary}" 
                                           Margin="0,3,0,0" 
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="2" 
                                    Background="#1E1E25" 
                                    BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="10,6" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding InspectedTrack.StreamSpec.FormattedBadge}" 
                                           FontFamily="{StaticResource FontFamily.Mono}"
                                           FontSize="11.5" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource Brush.Text.Primary}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Primary Focal Block: Verdict + Spectrum Graph -->
                    <Border Background="{StaticResource Brush.Background.Card}" 
                            BorderBrush="{Binding CurrentIntegrityReport.VerdictColorHex, Converter={StaticResource HexToBrushConverter}}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Padding="20,18" 
                            Margin="0,0,0,18">
                        <StackPanel>
                            <!-- Verdict Header Row (Icon + Verdict + Explanation) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1E1E25" VerticalAlignment="Top" Margin="0,2,14,0">
                                    <Path Stroke="{Binding CurrentIntegrityReport.VerdictColorHex, Converter={StaticResource HexToBrushConverter}}"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource Icon.InfoCircle}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Genuine">
                                                        <Setter Property="Data" Value="{StaticResource Icon.CheckCircle}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Caution">
                                                        <Setter Property="Data" Value="{StaticResource Icon.AlertTriangle}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CurrentIntegrityReport.VerdictCategory}" Value="Fake">
                                                        <Setter Property="Data" Value="{StaticResource Icon.AlertTriangle}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding CurrentIntegrityReport.VerdictBadge}" 
                                               FontSize="17" 
                                               FontWeight="Bold" 
                                               Foreground="{Binding CurrentIntegrityReport.VerdictColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                    <TextBlock Text="{Binding CurrentIntegrityReport.LocalizedExplanation}" 
                                               FontSize="12.5" 
                                               Foreground="{StaticResource Brush.Text.Secondary}" 
                                               TextWrapping="Wrap" 
                                               LineHeight="19" 
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Spectrum Graph Header & Legend -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Str_Inspect_FftGraphTitle}" 
                                               FontSize="11.5" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource Brush.Text.Secondary}" 
                                               VerticalAlignment="Center" />
                                    <Border Background="#2A2215" BorderBrush="{StaticResource Brush.Accent.Warning}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                                            Visibility="{Binding CurrentIntegrityReport.IsSyntheticSpectrum, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{DynamicResource Str_Inspect_DsdNotice}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Warning}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Rectangle Width="10" Height="2" Fill="{StaticResource Brush.Accent.Gold}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Str_Inspect_LegendPowerSpectrum}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,0,14,0" />

                                    <Rectangle Width="10" Height="2" Fill="{StaticResource Brush.Accent.Red}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Str_Inspect_LegendCdLimit}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,0,14,0" />

                                    <Rectangle Width="10" Height="2" Fill="{StaticResource Brush.Accent.Green}" Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Str_Inspect_LegendDetectedCutoff}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                </StackPanel>
                            </Grid>

                            <!-- Spectrum Canvas -->
                            <views:SpekSpectrumControl Report="{Binding CurrentIntegrityReport}" 
                                                      Height="270" 
                                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- Plain-Language Specification Summary (2x2 Grid) -->
                    <TextBlock Text="{DynamicResource Str_Inspect_SpecsHeading}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Spec 1: Format & Compression -->
                        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource Brush.Background.Card}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_Inspect_SpecContainerTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                <TextBlock Text="{Binding CurrentIntegrityReport.SpecContainerValue}" 
                                           FontFamily="{StaticResource FontFamily.Mono}" FontSize="14" FontWeight="Bold" 
                                           Foreground="{StaticResource Brush.Text.Primary}" Margin="0,6,0,4" />
                                <TextBlock Text="{Binding CurrentIntegrityReport.SpecContainerMeaning}" 
                                           FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <!-- Spec 2: Frequency Bandwidth -->
                        <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource Brush.Background.Card}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_Inspect_SpecFreqTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                <TextBlock Text="{Binding CurrentIntegrityReport.SpecFrequencyValue}" 
                                           FontFamily="{StaticResource FontFamily.Mono}" FontSize="14" FontWeight="Bold" 
                                           Foreground="{StaticResource Brush.Accent.Cyan}" Margin="0,6,0,4" />
                                <TextBlock Text="{Binding CurrentIntegrityReport.SpecFrequencyMeaning}" 
                                           FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <!-- Spec 3: Bit Depth Integrity -->
                        <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource Brush.Background.Card}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_Inspect_SpecBitTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                <TextBlock Text="{Binding CurrentIntegrityReport.SpecBitDepthValue}" 
                                           FontFamily="{StaticResource FontFamily.Mono}" FontSize="14" FontWeight="Bold" 
                                           Foreground="{StaticResource Brush.Accent.Gold}" Margin="0,6,0,4" />
                                <TextBlock Text="{Binding CurrentIntegrityReport.SpecBitDepthMeaning}" 
                                           FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <!-- Spec 4: Hardware Output Path -->
                        <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource Brush.Background.Card}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str_Inspect_SpecOutputTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                <TextBlock Text="{Binding CurrentIntegrityReport.SpecOutputValue}" 
                                           FontSize="14" FontWeight="Bold" 
                                           Foreground="{Binding CurrentIntegrityReport.SpecOutputColorHex, Converter={StaticResource HexToBrushConverter}}" 
                                           Margin="0,6,0,2" />
                                <TextBlock Text="{Binding OutputDeviceName}" 
                                           FontFamily="{StaticResource FontFamily.Mono}" FontSize="11" 
                                           Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                <TextBlock Text="{Binding CurrentIntegrityReport.SpecOutputMeaning}" 
                                           FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" LineHeight="18" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Collapsible Technical Disclosure -->
                    <Expander Style="{StaticResource Style.Expander.Studio}" IsExpanded="False">
                        <Expander.Header>
                            <TextBlock Text="{DynamicResource Str_Inspect_TechnicalExpander}" 
                                       FontSize="12.5" FontWeight="SemiBold" 
                                       Foreground="{StaticResource Brush.Text.Primary}" />
                        </Expander.Header>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0 Left: Analyzed Segment -->
                            <Border Grid.Row="0" Grid.Column="0" BorderBrush="#282832" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{DynamicResource Str_Inspect_AnalyzedSegment}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CurrentIntegrityReport.AnalysisTimestamp, Converter={StaticResource TimeSpanToStringConverter}}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Accent.Gold}" />
                                            <TextBlock Text="{Binding CurrentIntegrityReport.AnalysisPositionPercentage, StringFormat=' ({0:F1}%)'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Secondary}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Str_Inspect_TechSegmentHint}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Row 0 Right: Spectral Knee -->
                            <Border Grid.Row="0" Grid.Column="2" BorderBrush="#282832" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{DynamicResource Str_Inspect_TechKnee}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding CurrentIntegrityReport.KneeHz, StringFormat='{}{0:N0} Hz', TargetNullValue='N/A'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Accent.Cyan}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Str_Inspect_TechKneeHint}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Row 1 Left: Spectral Slope -->
                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="#282832" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{DynamicResource Str_Inspect_SpectralSlope}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding CurrentIntegrityReport.SpectralSlopeDbPerOctave, StringFormat='{}{0:F1} dB/okt', TargetNullValue='N/A'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Str_Inspect_TechSlopeHint}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Row 1 Right: Drop Across Knee -->
                            <Border Grid.Row="1" Grid.Column="2" BorderBrush="#282832" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{DynamicResource Str_Inspect_TechDrop}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Text="{Binding CurrentIntegrityReport.DropAcrossKneeDb, StringFormat='{}{0:F1} dB', TargetNullValue='N/A'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Str_Inspect_TechDropHint}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Row 2 Left: Power @ 22.05 kHz & Nyquist -->
                            <Border Grid.Row="2" Grid.Column="0" BorderBrush="#282832" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{DynamicResource Str_Inspect_Power22k}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CurrentIntegrityReport.PowerAt22kDbFS, StringFormat='{}{0:F1} dBFS', TargetNullValue='N/A'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" />
                                            <TextBlock Text=" / " FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                            <TextBlock Text="{Binding CurrentIntegrityReport.PowerAtNyquistDbFS, StringFormat='{}{0:F1} dBFS', TargetNullValue='N/A'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Str_Inspect_TechPowersHint}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Row 2 Right: LSB Activity & Entropy -->
                            <Border Grid.Row="2" Grid.Column="2" BorderBrush="#282832" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="{DynamicResource Str_Inspect_TechLsb}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CurrentIntegrityReport.LsbActivityPercentage, StringFormat='{}{0:F1}%'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Accent.Gold}" />
                                            <TextBlock Text=" • " FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                            <TextBlock Text="{Binding CurrentIntegrityReport.LsbEntropy, StringFormat='{}{0:F2}/8 bit'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Str_Inspect_TechLsbHint}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Row 3 Left: Upper Noise Floor & Sigma -->
                            <StackPanel Grid.Row="3" Grid.Column="0">
                                <Grid>
                                    <TextBlock Text="{DynamicResource Str_Inspect_NoiseStdDev}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding CurrentIntegrityReport.UltrasonicNoiseFloorDbFS, StringFormat='{}{0:F1} dBFS', TargetNullValue='N/A'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Text=" • " FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                        <TextBlock Text="{Binding CurrentIntegrityReport.UltrasonicNoiseStdDevDb, StringFormat='{}σ={0:F1} dB', TargetNullValue='N/A'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{DynamicResource Str_Inspect_TechNoiseHint}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Row 3 Right: Resampler Imaging Correlation -->
                            <StackPanel Grid.Row="3" Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="{DynamicResource Str_Inspect_TechImaging}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding CurrentIntegrityReport.ImagingCorrelation, StringFormat='{}r={0:F2}', TargetNullValue='N/A'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" />
                                        <TextBlock Text=" • " FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                        <TextBlock Text="{Binding CurrentIntegrityReport.ImagingAttenuationDb, StringFormat='{}{0:F1} dB', TargetNullValue='N/A'}" FontFamily="{StaticResource FontFamily.Mono}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{DynamicResource Str_Inspect_TechImagingHint}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Expander>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading Overlay -->
        <Border Background="#DC111114" 
                Visibility="{Binding IsAnalyzing, Converter={StaticResource BooleanToVisibilityConverter}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="4" 
                             Background="#282832" Foreground="{StaticResource Brush.Accent.Gold}" Margin="0,0,0,16" />
                <TextBlock Text="{DynamicResource Str_Inspect_LoadingTitle}" 
                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource Str_Inspect_LoadingDesc}" 
                           FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
