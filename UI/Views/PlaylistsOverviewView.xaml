<UserControl x:Class="AuraAudio.UI.Views.PlaylistsOverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers"
             x:Name="Root"
             Background="{StaticResource Brush.Canvas}">

    <ScrollViewer Focusable="False"
                  FocusVisualStyle="{x:Null}"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ContentHost"
                    MaxWidth="{StaticResource Width.MaxContent}"
                    Margin="{StaticResource Padding.PageContent}">

            <!-- Header Bar: Playlists Title + Inline New Playlist / Import M3U -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Playlists" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock Style="{StaticResource Text.Callout}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               Margin="0,2,0,0"
                               Text="{Binding SavedPlaylists.Count, StringFormat={}{0} playlists · Drag tracks or albums onto sidebar playlists}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Style.Button.Primary}"
                            Content="+ New Playlist"
                            Click="ShowNewPlaylistBar_Click" />
                    <Button Style="{StaticResource Style.Button.Secondary}"
                            Margin="8,0,0,0"
                            Content="Import M3U"
                            Command="{Binding ImportM3uPlaylistCommand}" />
                </StackPanel>
            </Grid>

            <!-- Inline Create Playlist Bar (No modal dialog required) -->
            <Border x:Name="NewPlaylistBar"
                    Visibility="Collapsed"
                    Margin="0,0,0,20"
                    Padding="14,12"
                    CornerRadius="{StaticResource Radius.Card}"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border.Control}"
                    BorderThickness="1"
                    MaxWidth="520"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewPlaylistNameBox"
                             Grid.Column="0"
                             Height="34"
                             KeyDown="NewPlaylistNameBox_KeyDown" />
                    <Button Grid.Column="1"
                            Style="{StaticResource Style.Button.Primary}"
                            Height="34"
                            Margin="10,0,0,0"
                            Content="Create"
                            Click="ConfirmCreatePlaylist_Click" />
                    <Button Grid.Column="2"
                            Style="{StaticResource Style.Button.Ghost}"
                            Height="34"
                            Margin="6,0,0,0"
                            Content="Cancel"
                            Click="CancelCreatePlaylist_Click" />
                </Grid>
            </Border>

            <!-- Empty State -->
            <Border Padding="32,28"
                    HorizontalAlignment="Left"
                    MaxWidth="520"
                    CornerRadius="{StaticResource Radius.Sheet}"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    Visibility="{Binding SavedPlaylistCards.Count, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=Inverse}">
                <StackPanel>
                    <TextBlock Text="No Playlists Yet" Style="{StaticResource Text.Title2}" />
                    <TextBlock Text="Create a playlist or import an M3U/M3U8 file, then drag tracks or albums onto any playlist in the sidebar."
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,16" />
                    <Button Style="{StaticResource Style.Button.Primary}"
                            HorizontalAlignment="Left"
                            Content="+ Create Playlist"
                            Click="ShowNewPlaylistBar_Click" />
                </StackPanel>
            </Border>

            <!-- Width Probe (measures exact inner viewport width after margins & scrollbar) -->
            <Border x:Name="GridWidthProbe"
                    Height="0"
                    HorizontalAlignment="Stretch"
                    SizeChanged="GridWidthProbe_SizeChanged" />

            <!-- Responsive GridG Playlist Mosaic Overview (Edge-to-Edge UniformGrid) -->
            <ItemsControl x:Name="PlaylistsItemsControl"
                          HorizontalAlignment="Stretch"
                          Margin="-10,0,-10,0"
                          ItemsSource="{Binding SavedPlaylistCards}"
                          Visibility="{Binding SavedPlaylistCards.Count, Converter={StaticResource NumberToVisibilityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding GridColumns, ElementName=Root}"
                                     VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,0,10,24"
                              HorizontalAlignment="Stretch"
                              Background="Transparent"
                              Cursor="Hand"
                              Tag="{Binding DataContext, ElementName=Root}"
                              MouseLeftButtonUp="PlaylistTile_MouseLeftButtonUp">
                            <Grid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Play Playlist"
                                              Command="{Binding PlacementTarget.Tag.PlaySavedPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Shuffle Playlist"
                                              Command="{Binding PlacementTarget.Tag.ShuffleSavedPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Open Playlist"
                                              Command="{Binding PlacementTarget.Tag.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Rename Playlist"
                                              Command="{Binding PlacementTarget.Tag.RenamePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Delete Playlist"
                                              Command="{Binding PlacementTarget.Tag.DeleteSavedPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Square Cover Tile (Single-pass TileHeight + GPU Linear scaling) -->
                            <Grid Grid.Row="0"
                                  HorizontalAlignment="Stretch"
                                  Height="{Binding TileHeight, ElementName=Root}"
                                  helpers:FluidBehaviors.EnablePressScale="True">
                                <Border CornerRadius="{StaticResource Radius.Card}"
                                        Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                        BorderThickness="1">
                                    <Path Width="36" Height="30" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{StaticResource Brush.Icon.Muted}"
                                          StrokeThickness="1.5"
                                          Data="M2,4 L22,4 M2,12 L22,12 M2,20 L14,20" />
                                </Border>

                                <Border x:Name="ArtFrame"
                                        CornerRadius="{StaticResource Radius.Card}"
                                        RenderOptions.BitmapScalingMode="Linear"
                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Grid}" />
                                    </Border.Background>
                                </Border>

                                <!-- Hover Overlay -->
                                <Border x:Name="HoverOverlay"
                                        CornerRadius="{StaticResource Radius.Card}"
                                        Background="{StaticResource Brush.Overlay.ArtworkScrim}"
                                        Opacity="0">
                                    <Grid Margin="10">
                                        <Button Width="32" Height="32"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Style="{StaticResource Style.Button.RoundPlay}"
                                                Command="{Binding DataContext.PlaySavedPlaylistCommand, ElementName=Root}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Play Playlist">
                                            <Path Width="11" Height="12" Margin="2,0,0,0" Stretch="Uniform"
                                                  Fill="{StaticResource Brush.Icon.OnWhite}"
                                                  Data="M1,0.5 L11,6 L1,11.5 Z" />
                                        </Button>

                                        <Button Width="32" Height="32"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Cursor="Hand"
                                                FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                                                Click="MoreButton_Click"
                                                ToolTip="More Options">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="MoreBd"
                                                            CornerRadius="16"
                                                            Background="{StaticResource Brush.Surface}"
                                                            BorderBrush="{StaticResource Brush.Border.Control}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Active}" Margin="1,0" />
                                                            <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Active}" Margin="1,0" />
                                                            <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Active}" Margin="1,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="MoreBd" Property="Background" Value="{StaticResource Brush.Elevated}" />
                                                            <Setter TargetName="MoreBd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="2,8,2,0">
                                <TextBlock Text="{Binding Playlist.Name}"
                                           Style="{StaticResource Text.BodyEmph}"
                                           Foreground="{StaticResource Brush.Text.Primary}" />
                                <TextBlock Text="{Binding Playlist.SummaryText}"
                                           Style="{StaticResource Text.Callout}"
                                           Foreground="{StaticResource Brush.Text.Tertiary}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverOverlay" Property="Opacity" Value="1" />
                                <Setter TargetName="ArtFrame" Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
