<UserControl x:Class="AuraAudio.UI.Views.PlaylistDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraAudio.UI.Controls"
             xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers"
             x:Name="Root"
             Background="{StaticResource Brush.Canvas}">

    <Grid>
        <!-- Main Scrollable Content -->
        <ScrollViewer x:Name="DetailScroll"
                      Focusable="False"
                      FocusVisualStyle="{x:Null}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="DetailScroll_ScrollChanged">
            <StackPanel MaxWidth="{StaticResource Width.MaxContent}"
                        Margin="{StaticResource Padding.PageContent}">

                <!-- 270x270 Apple Music PlaylistDetailHeaderLockup (Spec B.5) -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 270x270 Hero Cover Art (CornerRadius=14px via ImageBrush, Zero DropShadowEffect) -->
                    <Grid Grid.Column="0" Width="270" Height="270">
                        <Border CornerRadius="{StaticResource Radius.HeroArt}"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                BorderThickness="1">
                            <Path Width="56" Height="46" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{StaticResource Brush.Icon.Muted}"
                                  StrokeThickness="1.4"
                                  Data="M2,5 L26,5 M2,15 L26,15 M2,25 L16,25" />
                        </Border>
                        <Border CornerRadius="{StaticResource Radius.HeroArt}"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                BorderThickness="1">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding SelectedPlaylistCoverKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Large}" />
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Right Metadata & Primary Action Cluster (Bottom-Anchored) -->
                    <StackPanel Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text="PLAYLIST" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6" />

                        <!-- Title Display OR Inline Rename Editor -->
                        <TextBlock x:Name="TitleDisplay"
                                   Text="{Binding SelectedPlaylist.Name, FallbackValue='Playlist'}"
                                   Style="{StaticResource Text.LargeTitle}" />

                        <StackPanel x:Name="InlineRenamePanel"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed"
                                    Margin="0,4,0,4">
                            <TextBox x:Name="RenameBox"
                                     Width="280"
                                     Height="34"
                                     KeyDown="RenameBox_KeyDown" />
                            <Button Style="{StaticResource Style.Button.Primary}"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Content="Save"
                                    Click="ConfirmRename_Click" />
                            <Button Style="{StaticResource Style.Button.Ghost}"
                                    Height="34"
                                    Margin="4,0,0,0"
                                    Content="Cancel"
                                    Click="CancelRename_Click" />
                        </StackPanel>

                        <TextBlock Text="{Binding SelectedPlaylistSummaryText}"
                                   Style="{StaticResource Text.Callout}"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                   Margin="0,6,0,20" />

                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Style.Button.Primary}"
                                    Margin="0,0,8,8"
                                    Content="Play"
                                    Command="{Binding PlaySavedPlaylistCommand}"
                                    CommandParameter="{Binding SelectedPlaylist}" />
                            <Button Style="{StaticResource Style.Button.Secondary}"
                                    Margin="0,0,8,8"
                                    Content="Shuffle"
                                    Command="{Binding ShuffleSavedPlaylistCommand}"
                                    CommandParameter="{Binding SelectedPlaylist}" />
                            <Button Style="{StaticResource Style.Button.Ghost}"
                                    Margin="4,0,4,8"
                                    Content="Rename"
                                    Click="OpenInlineRename_Click" />
                            <Button Style="{StaticResource Style.Button.Ghost}"
                                    Margin="0,0,4,8"
                                    Content="Export M3U"
                                    Command="{Binding ExportSelectedPlaylistToM3uCommand}" />
                            <Button Style="{StaticResource Style.Button.Ghost}"
                                    Margin="0,0,0,8"
                                    Content="Delete"
                                    Command="{Binding DeleteSavedPlaylistCommand}"
                                    CommandParameter="{Binding SelectedPlaylist}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>

                <!-- Empty Playlist State -->
                <Border Padding="28,24"
                        CornerRadius="{StaticResource Radius.Sheet}"
                        Background="{StaticResource Brush.Surface}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1"
                        Visibility="{Binding SelectedPlaylistTracks.Count, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=Inverse}">
                    <TextBlock Text="This playlist is empty. Drag tracks or albums from Home, Songs, Albums, or Artists onto this playlist in the left sidebar."
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               TextWrapping="Wrap" />
                </Border>

                <!-- Playlist Tracklist (40px rows with 32x32 Art + Remove Button) -->
                <Border BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding SelectedPlaylistTracks.Count, Converter={StaticResource NumberToVisibilityConverter}}">
                    <ListBox x:Name="PlaylistTracksList"
                             Style="{StaticResource Style.ListBox.Inline}"
                             ItemsSource="{Binding SelectedPlaylistTracks}"
                             AlternationCount="2"
                             PreviewKeyDown="PlaylistTracksList_PreviewKeyDown"
                             MouseDoubleClick="PlaylistTracksList_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="PlaylistTracksList_PreviewMouseLeftButtonDown"
                             MouseMove="PlaylistTracksList_MouseMove">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Height" Value="{StaticResource Height.Row}" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusVisual.Monochrome}" />
                                <Setter Property="Tag" Value="{Binding DataContext, ElementName=Root}" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Play"
                                                      Command="{Binding PlacementTarget.Tag.PlaySelectedPlaylistTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Play Next"
                                                      Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Add to Queue"
                                                      Command="{Binding PlacementTarget.Tag.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Add to Playlist..."
                                                      Command="{Binding PlacementTarget.Tag.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Go to Artist"
                                                      Command="{Binding PlacementTarget.Tag.NavigateToArtistLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Go to Album"
                                                      Command="{Binding PlacementTarget.Tag.NavigateToAlbumLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Get Info"
                                                      InputGestureText="Ctrl+I"
                                                      Command="{Binding PlacementTarget.Tag.OpenInfoForTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Inspect Audio Authenticity"
                                                      Command="{Binding PlacementTarget.Tag.InspectTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Show in Explorer"
                                                      Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                            <Separator />
                                            <MenuItem Header="Remove from Playlist"
                                                      InputGestureText="Del"
                                                      Command="{Binding PlacementTarget.Tag.RemoveTrackFromCurrentPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                    BorderThickness="0,0,0,0.5"
                                                    CornerRadius="{StaticResource Radius.Small}"
                                                    Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Border x:Name="SelBar"
                                                            Width="3"
                                                            HorizontalAlignment="Left"
                                                            Margin="-8,4,0,4"
                                                            CornerRadius="1.5"
                                                            Background="{StaticResource Brush.Border.Strong}"
                                                            Visibility="Collapsed" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                                    <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.Overlay.ZebraRow}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.Hover.Dark}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.SelectedRow}" />
                                                    <Setter TargetName="SelBar" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Index / BouncyBar / Hover Play -->
                                    <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <controls:BouncyBarControl>
                                            <controls:BouncyBarControl.IsActive>
                                                <MultiBinding Converter="{StaticResource ActiveTrackPlayingMultiConverter}">
                                                    <Binding Path="FilePath" />
                                                    <Binding Path="DataContext.CurrentTrack.FilePath" ElementName="Root" />
                                                    <Binding Path="DataContext.IsPlaying" ElementName="Root" />
                                                </MultiBinding>
                                            </controls:BouncyBarControl.IsActive>
                                            <controls:BouncyBarControl.Visibility>
                                                <MultiBinding Converter="{StaticResource ActiveTrackPlayingMultiConverter}">
                                                    <Binding Path="FilePath" />
                                                    <Binding Path="DataContext.CurrentTrack.FilePath" ElementName="Root" />
                                                    <Binding Path="DataContext.IsPlaying" ElementName="Root" />
                                                </MultiBinding>
                                            </controls:BouncyBarControl.Visibility>
                                        </controls:BouncyBarControl>

                                        <TextBlock x:Name="IdxTxt"
                                                   Text="{Binding TrackNumber}"
                                                   Style="{StaticResource Text.TabularMono}"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Visibility>
                                                <MultiBinding Converter="{StaticResource ActiveTrackPlayingMultiConverter}" ConverterParameter="Inverse">
                                                    <Binding Path="FilePath" />
                                                    <Binding Path="DataContext.CurrentTrack.FilePath" ElementName="Root" />
                                                    <Binding Path="DataContext.IsPlaying" ElementName="Root" />
                                                </MultiBinding>
                                            </TextBlock.Visibility>
                                        </TextBlock>

                                        <Button x:Name="HoverPlayBtn"
                                                Style="{StaticResource Style.Button.Icon}"
                                                Width="26" Height="26"
                                                Visibility="Collapsed"
                                                Command="{Binding DataContext.PlaySelectedPlaylistTrackCommand, ElementName=Root}"
                                                CommandParameter="{Binding}">
                                            <Path Width="10" Height="11" Margin="2,0,0,0" Stretch="Uniform"
                                                  Fill="{StaticResource Brush.Icon.Active}"
                                                  Data="M1,0.5 L10,5.5 L1,10.5 Z" />
                                        </Button>
                                    </Grid>

                                    <!-- 32x32 Rounded 4px Art -->
                                    <Grid Grid.Column="1" Width="32" Height="32">
                                        <Border CornerRadius="{StaticResource Radius.Small}"
                                                Background="{StaticResource Brush.Elevated}"
                                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                BorderThickness="1" />
                                        <Border CornerRadius="{StaticResource Radius.Small}"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                BorderThickness="1">
                                            <Border.Background>
                                                <ImageBrush Stretch="UniformToFill"
                                                            ImageSource="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>

                                    <!-- Title -->
                                    <TextBlock x:Name="TitleTxt"
                                               Grid.Column="2"
                                               Margin="10,0,8,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Title}"
                                               Style="{StaticResource Text.Body}" />

                                    <!-- Artist -->
                                    <TextBlock Grid.Column="3"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Artist}"
                                               Style="{StaticResource Text.Callout}" />

                                    <!-- Album -->
                                    <TextBlock Grid.Column="4"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Album}"
                                               Style="{StaticResource Text.Callout}"
                                               Foreground="{StaticResource Brush.Text.Tertiary}" />

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding FormattedDuration}"
                                               Style="{StaticResource Text.TabularMono}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />

                                    <!-- Hover Remove Button -->
                                    <Button x:Name="RemoveBtn"
                                            Grid.Column="6"
                                            Style="{StaticResource Style.Button.Icon}"
                                            Width="26" Height="26"
                                            Visibility="Collapsed"
                                            Command="{Binding DataContext.RemoveTrackFromCurrentPlaylistCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove from Playlist (Del)">
                                        <Path Width="8" Height="8" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5"
                                              Data="M1,1 L7,7 M7,1 L1,7" />
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="IdxTxt" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="HoverPlayBtn" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="RemoveBtn" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource StringEqualsMultiConverter}">
                                                <Binding Path="FilePath" />
                                                <Binding Path="DataContext.CurrentTrack.FilePath" ElementName="Root" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter TargetName="TitleTxt" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                        <Setter TargetName="TitleTxt" Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- ContainerDetailTracklistFooter (Spec B.5) -->
                <TextBlock Text="{Binding SelectedPlaylistSummaryText}"
                           Style="{StaticResource Text.Callout}"
                           Foreground="{StaticResource Brush.Text.Tertiary}"
                           Margin="4,24,0,0"
                           Visibility="{Binding SelectedPlaylistTracks.Count, Converter={StaticResource NumberToVisibilityConverter}}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Sticky Compact Header (Appears cleanly when scrolled past 270x270 hero) -->
        <Border x:Name="StickyHeaderBar"
                Height="48"
                VerticalAlignment="Top"
                Opacity="0"
                Visibility="Collapsed"
                Padding="30,0"
                Background="{StaticResource Brush.DockBackground}"
                BorderBrush="{StaticResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1">
            <Grid MaxWidth="{StaticResource Width.MaxContent}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding SelectedPlaylist.Name}"
                           Style="{StaticResource Text.Headline}"
                           Foreground="{StaticResource Brush.Text.Peak}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Style="{StaticResource Style.Button.Primary}"
                        Height="30"
                        Padding="14,0"
                        Content="Play"
                        Command="{Binding PlaySavedPlaylistCommand}"
                        CommandParameter="{Binding SelectedPlaylist}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
