<UserControl x:Class="AuraAudio.UI.Views.AlbumDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:AuraAudio.Core.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Back Button & Hero Album Banner -->
            <RowDefinition Height="*" />    <!-- Tracklist Table -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. BACK BUTTON & HERO ALBUM BANNER                                        -->
        <!-- ========================================================================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <!-- Back Button -->
            <Button Command="{Binding BackFromAlbumDetailCommand}" 
                    Style="{StaticResource Style.Button.Transport}" 
                    HorizontalAlignment="Left" 
                    Padding="10,6" Margin="0,0,0,14" 
                    ToolTip="Kembali ke tampilan sebelumnya">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource Icon.ArrowLeft}" Stroke="{StaticResource Brush.Accent.Gold}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Str_Btn_Back}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Hero Banner Card -->
            <Border Background="{StaticResource Brush.Background.Card}" 
                    BorderBrush="{StaticResource Brush.Border.Subtle}" 
                    BorderThickness="1" 
                    CornerRadius="12" 
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Large Album Cover -->
                    <Border Grid.Column="0" Width="150" Height="150" 
                            CornerRadius="8" 
                            Background="{StaticResource Brush.Background.Sidebar}" 
                            BorderBrush="{StaticResource Brush.Border.Subtle}" 
                            BorderThickness="1" 
                            ClipToBounds="True" 
                            Margin="0,0,22,0">
                        <Grid>
                            <Path Data="{StaticResource Icon.Disc}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                            <Image Source="{Binding SelectedAlbumDetail.CoverArtCacheKey, Converter={StaticResource CoverArtConverter}}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>

                    <!-- Album Metadata -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Border HorizontalAlignment="Left" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Accent.Gold}" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,0,6"
                                Visibility="{Binding SelectedAlbumDetail.IsHiRes, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{DynamicResource Str_AlbumDetail_HiRes}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Gold}" />
                        </Border>

                        <!-- Album Title -->
                        <TextBlock Text="{Binding SelectedAlbumDetail.Title}" 
                                   FontSize="24" FontWeight="Bold" 
                                   Foreground="{StaticResource Brush.Text.Primary}" 
                                   TextTrimming="CharacterEllipsis" 
                                   ToolTip="{Binding SelectedAlbumDetail.Title}" />

                        <!-- Artist Name -->
                        <TextBlock Text="{Binding SelectedAlbumDetail.Artist}" 
                                   FontSize="15" FontWeight="SemiBold" 
                                   Foreground="{StaticResource Brush.Accent.Gold}" 
                                   Margin="0,4,0,0" 
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Summary (Tracks count, total duration, year) -->
                        <TextBlock Text="{Binding AlbumDetailSummaryText}" 
                                   FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" 
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Play & Shuffle Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Style.Button.Transport}" 
                                Command="{Binding ShuffleCurrentAlbumDetailCommand}" 
                                Padding="14,8" Height="36" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Shuffle}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str_AlbumDetail_ShuffleAlbum}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding PlayCurrentAlbumDetailCommand}" 
                                Style="{StaticResource Style.Button.Primary}"
                                Padding="18,0" Height="36">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#111114" Data="{StaticResource Icon.Play}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource Str_AlbumDetail_PlayAlbum}" FontSize="12" FontWeight="Bold" Foreground="#111114" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- ========================================================================= -->
        <!-- 2. DAFTAR LAGU DALAM ALBUM (TABLE VIEW)                                   -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" 
                Background="{StaticResource Brush.Background.Card}" 
                BorderBrush="{StaticResource Brush.Border.Subtle}" 
                BorderThickness="1" 
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" /> <!-- Table Headers -->
                    <RowDefinition Height="*" />  <!-- ListBox Tracks -->
                </Grid.RowDefinitions>

                <!-- Table Column Headers -->
                <Border Grid.Row="0" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Str_Table_TrackNo}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                        <TextBlock Grid.Column="1" Text="{DynamicResource Str_Table_Title}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                        <TextBlock Grid.Column="2" Text="{DynamicResource Str_Table_Format}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                        <TextBlock Grid.Column="3" Text="{DynamicResource Str_Table_Duration}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <!-- ListBox Tracks -->
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding SelectedAlbumDetailTracks}" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto" 
                         MouseDoubleClick="AlbumDetailListBox_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#22222B" />
                            <Setter Property="Height" Value="44" />
                            <Setter Property="Padding" Value="16,0" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnListBoxItemPreviewMouseRightButtonDown" />
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{DynamicResource Str_Ctx_PlayNow}" Command="{Binding PlayAlbumDetailTrackCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="{DynamicResource Str_Ctx_PlayNext}" Command="{Binding PlayNextCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="{DynamicResource Str_Ctx_AddToQueue}" Command="{Binding AddToQueueCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="{DynamicResource Str_Ctx_AddToPlaylist}" Command="{Binding AddToPlaylistCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="{StaticResource Brush.Accent.Gold}" />
                                        <Separator />
                                        <MenuItem Header="{DynamicResource Str_Ctx_InspectAuthenticity}" Command="{Binding InspectTrackCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="{StaticResource Brush.Accent.Gold}" />
                                        <MenuItem Header="{DynamicResource Str_Ctx_OpenFileLocation}" Command="{Binding OpenFileLocationCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="itemBorder" 
                                                Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource Brush.Background.CardHover}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="itemBorder" Property="Background" Value="#25252E" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Track}">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="4*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <!-- Track Number -->
                                <TextBlock Grid.Column="0" Text="{Binding TrackNumber}" FontSize="12" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" />

                                <!-- Judul Lagu & Artis (jika berbeda dari artis album) -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Tertiary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                </StackPanel>

                                <!-- Format Badge -->
                                <Border Grid.Column="2" 
                                        Background="{StaticResource Brush.Background.CardHover}" 
                                        BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        HorizontalAlignment="Left" 
                                        VerticalAlignment="Center" 
                                        Padding="6,2">
                                    <TextBlock Text="{Binding StreamSpec.FormattedBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Gold}" />
                                </Border>

                                <!-- Durasi -->
                                <TextBlock Grid.Column="3" 
                                           Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}" 
                                           FontSize="11.5" 
                                           Foreground="{StaticResource Brush.Text.Tertiary}" 
                                           HorizontalAlignment="Right" 
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
