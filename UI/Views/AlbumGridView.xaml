<UserControl x:Class="AuraAudio.UI.Views.AlbumGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:AuraAudio.Core.Models"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding DisplayedAlbums}" Margin="8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:Album}">
                    <!-- Kartu Album Modern (Apple Music / Spotify Style) -->
                    <Border x:Name="AlbumCard" 
                            Width="192" Height="265" 
                            Margin="10,10,12,14" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Cursor="Hand"
                            RenderTransformOrigin="0.5,0.5"
                            MouseLeftButtonDown="AlbumCard_MouseLeftButtonDown">
                        <Border.Background>
                            <SolidColorBrush Color="#17171C" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#282832" />
                        </Border.BorderBrush>
                        <Border.RenderTransform>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                        </Border.RenderTransform>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="182" /> <!-- Cover Art Box -->
                                <RowDefinition Height="*" />   <!-- Title & Metadata -->
                            </Grid.RowDefinitions>

                            <!-- 1. KOTAK COVER ART DENGAN THUMBNAIL CACHE & FLOATING PLAY BUTTON -->
                            <Grid Grid.Row="0">
                                <Border CornerRadius="9,9,0,0" Background="#141418" ClipToBounds="True">
                                    <Grid>
                                        <!-- Placeholder Ikon Vinyl jika Belum Ada Cover -->
                                        <Path Data="{StaticResource Icon.Disc}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />

                                        <!-- Gambar Cover Art Nyata Dari Cache (L1 RAM / L2 Disk) -->
                                        <Image Source="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}}" 
                                               Stretch="UniformToFill" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" />

                                        <!-- Badge Hi-Res 24-bit Gold di Pojok Kanan Atas -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                Margin="0,8,8,0" 
                                                Background="#D9111114" 
                                                BorderBrush="{StaticResource Brush.Accent.Gold}" 
                                                BorderThickness="1" 
                                                CornerRadius="4" 
                                                Padding="6,2"
                                                Visibility="{Binding IsHiRes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="HI-RES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Brush.Accent.Gold}" />
                                        </Border>

                                        <!-- Floating Play Button (Muncul Saat Hover Kursor) -->
                                        <Border x:Name="PlayOverlayBtn" 
                                                Width="38" Height="38" 
                                                CornerRadius="19" 
                                                Background="{StaticResource Brush.Accent.Gold}" 
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Bottom" 
                                                Margin="0,0,10,10" 
                                                Opacity="0"
                                                MouseLeftButtonDown="PlayButton_MouseLeftButtonDown">
                                            <Path Fill="#111114" Data="{StaticResource Icon.Play}" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 2. DESKRIPSI TEKS & METADATA -->
                            <StackPanel Grid.Row="1" Margin="10,8,10,6" VerticalAlignment="Center">
                                <!-- Judul Album -->
                                <TextBlock Text="{Binding Title}" 
                                           FontSize="13" 
                                           FontWeight="SemiBold" 
                                           Foreground="{StaticResource Brush.Text.Primary}" 
                                           TextTrimming="CharacterEllipsis" 
                                           ToolTip="{Binding Title}" />

                                <!-- Nama Artis Album -->
                                <TextBlock Text="{Binding Artist}" 
                                           FontSize="11" 
                                           Foreground="{StaticResource Brush.Text.Secondary}" 
                                           Margin="0,2,0,2" 
                                           TextTrimming="CharacterEllipsis" />

                                <TextBlock Text="{Binding GridSubtitleText}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource Brush.Text.Tertiary}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Triggers Animasi Hover Kartu -->
                    <DataTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="AlbumCard"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#1E1E25" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="AlbumCard"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#6E6C7A" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="AlbumCard"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.02" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="AlbumCard"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.02" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="PlayOverlayBtn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1.0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="AlbumCard"
                                                        Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                        To="#17171C" Duration="0:0:0.15" />
                                        <ColorAnimation Storyboard.TargetName="AlbumCard"
                                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                        To="#282832" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="AlbumCard"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="AlbumCard"
                                                         Storyboard.TargetProperty="(Border.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="PlayOverlayBtn"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
