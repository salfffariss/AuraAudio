<UserControl x:Class="AuraAudio.UI.Views.ArtistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:AuraAudio.Core.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Background="Transparent">
        <!-- ========================================================================= -->
        <!-- STATE 1: KATALOG SEMUA ARTIS (GRID CATALOG)                               -->
        <!-- ========================================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsArtistDetailView, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
            <ItemsControl ItemsSource="{Binding DisplayedArtists}" Margin="4,8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:Artist}">
                        <Border Width="184" Height="220" Margin="10,8,12,14" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Cursor="Hand">
                            <Border.Background>
                                <SolidColorBrush Color="#17171C" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#282832" />
                            </Border.BorderBrush>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" 
                                              Command="{Binding DataContext.OpenArtistDetailCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                              CommandParameter="{Binding}" />
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#1E1E25" Duration="0:0:0.12" />
                                                        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                        To="#E5A23C" Duration="0:0:0.12" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#17171C" Duration="0:0:0.12" />
                                                        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                        To="#282832" Duration="0:0:0.12" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /> <!-- Avatar -->
                                    <RowDefinition Height="*" />    <!-- Name & Stats -->
                                </Grid.RowDefinitions>

                                <!-- Circular Artist Avatar -->
                                <Border Grid.Row="0" Width="104" Height="104" 
                                        CornerRadius="52" 
                                        Background="{StaticResource Brush.Background.Sidebar}" 
                                        BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                        BorderThickness="2" 
                                        ClipToBounds="True" 
                                        HorizontalAlignment="Center" 
                                        Margin="0,4,0,10">
                                    <Grid>
                                        <Path Data="{StaticResource Icon.Artist}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                                        <Image Source="{Binding SampleCoverKey, Converter={StaticResource CoverArtConverter}}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <!-- Artist Metadata -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="14" 
                                               FontWeight="Bold" 
                                               Foreground="{StaticResource Brush.Text.Primary}" 
                                               TextAlignment="Center" 
                                               TextTrimming="CharacterEllipsis" 
                                               MaxWidth="160" />
                                    <TextBlock Text="{Binding SummaryText}" 
                                               FontSize="11.5" 
                                               Foreground="{StaticResource Brush.Text.Tertiary}" 
                                               TextAlignment="Center" 
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ========================================================================= -->
        <!-- STATE 2: DISKOGRAFI DETAIL ARTIS (APPLE MUSIC STYLE GROUPED VIEW)         -->
        <!-- ========================================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsArtistDetailView, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="14,12,14,24">
                <!-- 1. BACK BUTTON & HERO BANNER -->
                <StackPanel Margin="0,0,0,16">
                    <!-- Back Button -->
                    <Button Command="{Binding BackToArtistsCommand}" 
                            Style="{StaticResource Style.Button.Transport}" 
                            HorizontalAlignment="Left" 
                            Padding="10,6" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.ArrowLeft}" Stroke="{StaticResource Brush.Accent.Gold}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Str_Artist_BackToArtists}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Hero Banner Card -->
                    <Border Background="{StaticResource Brush.Background.Card}" 
                            BorderBrush="{StaticResource Brush.Border.Subtle}" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Large Avatar Circle -->
                            <Border Grid.Column="0" Width="100" Height="100" 
                                    CornerRadius="50" 
                                    Background="{StaticResource Brush.Background.Sidebar}" 
                                    BorderBrush="{StaticResource Brush.Accent.Gold}" 
                                    BorderThickness="2" 
                                    ClipToBounds="True" 
                                    Margin="0,0,20,0">
                                <Grid>
                                    <Path Data="{StaticResource Icon.Artist}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="40" Height="40" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                                    <Image Source="{Binding SelectedArtist.SampleCoverKey, Converter={StaticResource CoverArtConverter}}" Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <!-- Title & Stats -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedArtist.Name}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ArtistStatsSummary}" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Play & Shuffle Action Buttons -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource Style.Button.Transport}" 
                                        Command="{Binding ShuffleArtistAllCommand}" 
                                        Padding="14,8" Height="36" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Shuffle}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Str_Btn_ShuffleAll}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding PlayArtistAllCommand}" 
                                        Style="{StaticResource Style.Button.Primary}"
                                        Padding="18,0" Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Fill="#111114" Data="{StaticResource Icon.Play}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource Str_Btn_PlayAll}" FontSize="12" FontWeight="Bold" Foreground="#111114" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 2. SECTION: KOLEKSI ALBUM TERKAIT (HORIZONTAL CAROUSEL) -->
                <Border Margin="0,0,0,20" 
                        Visibility="{Binding ArtistAlbums.Count, Converter={StaticResource NumberToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_Artist_RelatedAlbums}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="2,0,0,10" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding ArtistAlbums}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Album}">
                                        <Border Width="144" Margin="0,0,14,0" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Cursor="Hand"
                                                MouseLeftButtonDown="AlbumItem_MouseLeftButtonDown"
                                                ToolTip="Buka detail lagu album ini"
                                                Padding="8">
                                            <Border.Background>
                                                <SolidColorBrush Color="#17171C" />
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="#282832" />
                                            </Border.BorderBrush>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Trigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                        To="#1E1E25" Duration="0:0:0.12" />
                                                                        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                                        To="#E5A23C" Duration="0:0:0.12" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.EnterActions>
                                                            <Trigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                        To="#17171C" Duration="0:0:0.12" />
                                                                        <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                                                        To="#282832" Duration="0:0:0.12" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </Trigger.ExitActions>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <Border Width="128" Height="128" CornerRadius="6" ClipToBounds="True" Background="{StaticResource Brush.Background.Sidebar}" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Path Data="{StaticResource Icon.Disc}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                                                        <Image Source="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                                <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- 3. SECTION: DISKOGRAFI LAGU PER ALBUM (APPLE MUSIC STYLE) -->
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_Artist_CompleteDiscography}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Secondary}" Margin="2,0,0,12" />
                    
                    <ItemsControl ItemsSource="{Binding ArtistAlbumGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ArtistAlbumGroup}">
                                <Border Background="{StaticResource Brush.Background.Card}" 
                                        BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                        BorderThickness="1" 
                                        CornerRadius="10" 
                                        Margin="0,0,0,16" 
                                        Padding="16">
                                    <StackPanel>
                                        <!-- Header Grup Album -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Mini Album Cover -->
                                            <Border Grid.Column="0" Width="52" Height="52" 
                                                    CornerRadius="6" ClipToBounds="True" 
                                                    Background="{StaticResource Brush.Background.Sidebar}" Margin="0,0,14,0"
                                                    Cursor="Hand"
                                                    MouseLeftButtonDown="AlbumGroupHeader_MouseLeftButtonDown">
                                                <Grid>
                                                    <Path Data="{StaticResource Icon.Disc}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                                                    <Image Source="{Binding Album.CoverArtCacheKey, Converter={StaticResource CoverArtConverter}}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <!-- Album Title & Meta -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Album.Title}" 
                                                           FontSize="15" FontWeight="Bold" 
                                                           Foreground="{StaticResource Brush.Text.Primary}" 
                                                           Cursor="Hand"
                                                           MouseLeftButtonDown="AlbumGroupHeader_MouseLeftButtonDown"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding SummaryText, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Tertiary}" Margin="0,3,0,0" />
                                            </StackPanel>

                                            <!-- Group Action Buttons -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Putar Album -->
                                                <Button Style="{StaticResource Style.Button.Transport}" 
                                                        Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding Album}" 
                                                        Padding="10,6" Height="32" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Fill="{StaticResource Brush.Accent.Gold}" Data="{StaticResource Icon.Play}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource Str_Btn_Play}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Acak Album -->
                                                <Button Style="{StaticResource Style.Button.Transport}" 
                                                        Command="{Binding DataContext.ShuffleAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding Album}" 
                                                        Padding="10,6" Height="32" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.Shuffle}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{DynamicResource Str_Btn_Shuffle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <!-- Buka Detail Album -->
                                                <Button Style="{StaticResource Style.Button.Transport}" 
                                                        Command="{Binding DataContext.OpenAlbumDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding Album}" 
                                                        Padding="10,6" Height="32">
                                                    <TextBlock Text="{DynamicResource Str_Btn_Details}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Gold}" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Divider line -->
                                        <Border Height="1" Background="{StaticResource Brush.Border.Subtle}" Margin="0,0,0,6" />

                                        <!-- Track list for this album -->
                                        <ItemsControl ItemsSource="{Binding Tracks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:Track}">
                                                    <Border Height="40" 
                                                            Padding="8,0" 
                                                            CornerRadius="6" 
                                                            Cursor="Hand"
                                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            MouseLeftButtonDown="TrackRow_MouseLeftButtonDown">
                                                        <Border.Background>
                                                            <SolidColorBrush Color="#00000000" />
                                                        </Border.Background>
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Trigger.EnterActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                                    To="#1E1E25" Duration="0:0:0.1" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.EnterActions>
                                                                        <Trigger.ExitActions>
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                                    To="#00000000" Duration="0:0:0.1" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </Trigger.ExitActions>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{DynamicResource Str_Ctx_PlayNow}" 
                                                                          Command="{Binding PlacementTarget.Tag.PlayAlbumDetailTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="{DynamicResource Str_Ctx_PlayNext}" 
                                                                          Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="{DynamicResource Str_Ctx_AddToQueue}" 
                                                                          Command="{Binding PlacementTarget.Tag.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="{DynamicResource Str_Ctx_AddToPlaylist}" 
                                                                          Command="{Binding PlacementTarget.Tag.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                          Foreground="{StaticResource Brush.Accent.Gold}" />
                                                                <Separator />
                                                                <MenuItem Header="{DynamicResource Str_Ctx_InspectAuthenticity}" 
                                                                          Command="{Binding PlacementTarget.Tag.InspectTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                          Foreground="{StaticResource Brush.Accent.Gold}" />
                                                                <MenuItem Header="{DynamicResource Str_Ctx_OpenFileLocation}" 
                                                                          Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            </ContextMenu>
                                                        </Border.ContextMenu>

                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="36" />
                                                                <ColumnDefinition Width="4*" />
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="65" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Track # -->
                                                            <TextBlock Grid.Column="0" Text="{Binding TrackNumber}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" />

                                                            <!-- Title & Artist -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource Brush.Text.Tertiary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                            </StackPanel>

                                                            <!-- Format badge -->
                                                            <Border Grid.Column="2" 
                                                                    Background="{StaticResource Brush.Background.CardHover}" 
                                                                    BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                                                    BorderThickness="1" 
                                                                    CornerRadius="4" 
                                                                    HorizontalAlignment="Left" 
                                                                    VerticalAlignment="Center" 
                                                                    Padding="6,2">
                                                                <TextBlock Text="{Binding StreamSpec.FormattedBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Gold}" />
                                                            </Border>

                                                            <!-- Duration -->
                                                            <TextBlock Grid.Column="3" 
                                                                       Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}" 
                                                                       FontSize="11" 
                                                                       Foreground="{StaticResource Brush.Text.Tertiary}" 
                                                                       HorizontalAlignment="Right" 
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
