<UserControl x:Class="AuraAudio.UI.Views.QueuePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraAudio.UI.Controls"
             xmlns:views="clr-namespace:AuraAudio.UI.Views"
             x:Name="Root"
             Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Optional Compact Segmented Header (shown when hosted in Mini-Player tray) -->
        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="3"
                HorizontalAlignment="Stretch"
                CornerRadius="{StaticResource Radius.Card}"
                Background="{StaticResource Brush.Rail}"
                BorderBrush="{StaticResource Brush.Border.Hairline}"
                BorderThickness="1"
                Visibility="{Binding ShowHeaderTabs, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0"
                             Style="{StaticResource Style.Toggle.Segmented}"
                             GroupName="MiniQueueTabs"
                             Content="Playing Next"
                             IsChecked="{Binding Presentation.IsPlayingNextTab, Mode=TwoWay}" />
                <RadioButton Grid.Column="1"
                             Style="{StaticResource Style.Toggle.Segmented}"
                             GroupName="MiniQueueTabs"
                             Content="History"
                             IsChecked="{Binding Presentation.IsHistoryTab, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- =================================================================
             TAB 1: PLAYING NEXT (Drag-to-Reorder, Hover Swap, Keyboard Actions)
             ================================================================= -->
        <Grid Grid.Row="1"
              Visibility="{Binding Presentation.IsPlayingNextTab, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Summary Subheader -->
            <Grid Grid.Row="0" Margin="2,0,2,8">
                <TextBlock Text="Up Next"
                           Style="{StaticResource Text.Eyebrow}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding QueueSummaryText}"
                           Style="{StaticResource Text.Callout}"
                           FontSize="11"
                           Foreground="{StaticResource Brush.Text.Tertiary}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Empty Queue State -->
            <Border Grid.Row="1"
                    VerticalAlignment="Top"
                    Padding="18,16"
                    CornerRadius="{StaticResource Radius.Card}"
                    Background="{StaticResource Brush.Rail}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    Visibility="{Binding QueueTracks.Count, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=Inverse}">
                <StackPanel>
                    <TextBlock Text="Queue is empty"
                               Style="{StaticResource Text.Subheadline}"
                               Foreground="{StaticResource Brush.Text.Primary}" />
                    <TextBlock Text="Play a track, album, or playlist to build Playing Next."
                               Style="{StaticResource Text.Callout}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Virtualized Reorderable Playing Next List -->
            <ListBox x:Name="QueueListBox"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     AllowDrop="True"
                     ItemsSource="{Binding QueueTracks}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     PreviewKeyDown="QueueListBox_PreviewKeyDown"
                     Visibility="{Binding QueueTracks.Count, Converter={StaticResource NumberToVisibilityConverter}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="AllowDrop" Value="True" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusVisual.Monochrome}" />
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="QueueItem_PreviewMouseLeftButtonDown" />
                        <EventSetter Event="MouseMove" Handler="QueueItem_MouseMove" />
                        <EventSetter Event="DragOver" Handler="QueueItem_DragOver" />
                        <EventSetter Event="DragLeave" Handler="QueueItem_DragLeave" />
                        <EventSetter Event="Drop" Handler="QueueItem_Drop" />
                        <EventSetter Event="MouseDoubleClick" Handler="QueueItem_MouseDoubleClick" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <!-- Top 2px Monochrome Drop-Target Line during Drag Reorder -->
                                        <Border x:Name="DropLine"
                                                Height="2"
                                                VerticalAlignment="Top"
                                                CornerRadius="1"
                                                Background="{StaticResource Brush.Border.Strong}"
                                                Visibility="Collapsed"
                                                Panel.ZIndex="4" />

                                        <Border x:Name="RowBd"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="{StaticResource Radius.Card}"
                                                Padding="6,6,6,0"
                                                SnapsToDevicePixels="True">
                                            <StackPanel>
                                                <ContentPresenter />
                                                <!-- 1px Inset Hairline Separator Under Text -->
                                                <Border Height="1"
                                                        Margin="50,6,2,0"
                                                        Background="{StaticResource Brush.Border.Hairline}"
                                                        Opacity="0.6" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.Hover.Dark}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.SelectedRow}" />
                                        </Trigger>
                                        <Trigger Property="views:QueuePaneView.IsDropTarget" Value="True">
                                            <Setter TargetName="DropLine" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="RowGrid"
                              Height="42"
                              Background="Transparent"
                              Tag="{Binding DataContext, ElementName=Root}">
                            <Grid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Play Now"
                                              Command="{Binding PlacementTarget.Tag.PlayQueueItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Move Up"
                                              InputGestureText="Alt+Up"
                                              Command="{Binding PlacementTarget.Tag.MoveQueueItemUpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Move Down"
                                              InputGestureText="Alt+Down"
                                              Command="{Binding PlacementTarget.Tag.MoveQueueItemDownCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Remove from Queue"
                                              InputGestureText="Del"
                                              Command="{Binding PlacementTarget.Tag.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Go to Artist"
                                              Command="{Binding PlacementTarget.Tag.NavigateToArtistLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Track}" />
                                    <MenuItem Header="Go to Album"
                                              Command="{Binding PlacementTarget.Tag.NavigateToAlbumLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Track}" />
                                    <MenuItem Header="Add to Playlist..."
                                              Command="{Binding PlacementTarget.Tag.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Track}" />
                                    <Separator />
                                    <MenuItem Header="Get Info"
                                              InputGestureText="Ctrl+I"
                                              Command="{Binding PlacementTarget.Tag.OpenInfoForTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Track}" />
                                    <MenuItem Header="Inspect Audio Authenticity"
                                              Command="{Binding PlacementTarget.Tag.InspectTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Track}" />
                                    <MenuItem Header="Show in Explorer"
                                              Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding Track}" />
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 40x40 Rounded ImageBrush Artwork + Active BouncyBar / Hover 20x20 Play -->
                            <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                                <Border CornerRadius="{StaticResource Radius.Small}"
                                        Background="{StaticResource Brush.Elevated}"
                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                        BorderThickness="1">
                                    <Path Width="14" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{StaticResource Brush.Icon.Muted}"
                                          StrokeThickness="1.4"
                                          Data="M5,12 A1.8,1.8 0 1 1 1.4,12 A1.8,1.8 0 1 1 5,12 M5,12 L5,2.5 L12.5,1 L12.5,10.5 M12.5,10.5 A1.8,1.8 0 1 1 8.9,10.5 A1.8,1.8 0 1 1 12.5,10.5" />
                                </Border>

                                <Border CornerRadius="{StaticResource Radius.Small}"
                                        RenderOptions.BitmapScalingMode="Linear"
                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                    </Border.Background>
                                </Border>

                                <!-- Active Playing Equalizer Overlay -->
                                <Border x:Name="ActiveArtOverlay"
                                        CornerRadius="{StaticResource Radius.Small}"
                                        Background="{StaticResource Brush.Overlay.Scrim}"
                                        Visibility="{Binding IsCurrentlyPlaying, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <controls:BouncyBarControl HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsActive="{Binding DataContext.IsPlaying, ElementName=Root}" />
                                </Border>

                                <!-- Hover 20x20 Artwork Play Overlay -->
                                <Border x:Name="HoverPlayOverlay"
                                        CornerRadius="{StaticResource Radius.Small}"
                                        Background="{StaticResource Brush.Overlay.Scrim}"
                                        Visibility="Collapsed">
                                    <Button Width="22" Height="22"
                                            Style="{StaticResource Style.Button.RoundPlay}"
                                            Command="{Binding DataContext.PlayQueueItemCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Play Now">
                                        <Path Width="8" Height="9" Margin="1.5,0,0,0" Stretch="Uniform"
                                              Fill="{StaticResource Brush.Icon.OnWhite}"
                                              Data="M1,0.5 L8,4.5 L1,8.5 Z" />
                                    </Button>
                                </Border>
                            </Grid>

                            <!-- Title & Artist -->
                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="QueueTitle"
                                           Text="{Binding Title}"
                                           Style="{StaticResource Text.Subheadline}"
                                           Foreground="{StaticResource Brush.Text.Primary}" />
                                <TextBlock Text="{Binding Artist}"
                                           Style="{StaticResource Text.Callout}"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Margin="0,1,0,0" />
                            </StackPanel>

                            <!-- Right Hover Swap: Duration <-> More (...) & Quick Remove (x) -->
                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="DurationText"
                                           Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}"
                                           Style="{StaticResource Text.TabularMono}"
                                           Margin="4,0,4,0"
                                           VerticalAlignment="Center" />

                                <StackPanel x:Name="HoverActions"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed">
                                    <Button Width="26" Height="26"
                                            Style="{StaticResource Style.Button.Icon}"
                                            Click="QueueMoreButton_Click"
                                            ToolTip="More Options">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1,0" />
                                            <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1,0" />
                                            <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1,0" />
                                        </StackPanel>
                                    </Button>
                                    <Button Width="26" Height="26"
                                            Style="{StaticResource Style.Button.Icon}"
                                            Command="{Binding DataContext.RemoveQueueItemCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Remove from Queue (Del)">
                                        <Path Width="8" Height="8" Stretch="Uniform"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5"
                                              Data="M1,1 L7,7 M7,1 L1,7" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                                <Setter TargetName="QueueTitle" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                <Setter TargetName="QueueTitle" Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="DurationText" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="HoverActions" Property="Visibility" Value="Visible" />
                                <Setter TargetName="HoverPlayOverlay" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ActiveArtOverlay" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Footer Actions: Save as Playlist + Clear -->
            <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="0,10,0,0"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Button Height="30"
                            Padding="10,0"
                            HorizontalAlignment="Left"
                            Content="Save as Playlist"
                            Command="{Binding SaveQueueAsPlaylistCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Ghost}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding QueueTracks.Count}" Value="0">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Style="{StaticResource Style.Button.Secondary}"
                            Height="30"
                            Padding="14,0"
                            HorizontalAlignment="Right"
                            AutomationProperties.AutomationId="{Binding ClearButtonAutomationId, ElementName=Root}"
                            Content="Clear"
                            Command="{Binding ClearQueueCommand}" />
                </Grid>
            </Border>
        </Grid>

        <!-- =================================================================
             TAB 2: PLAYBACK HISTORY (SQLite play_history — Single-Click Replay)
             ================================================================= -->
        <Grid Grid.Row="1"
              Visibility="{Binding Presentation.IsHistoryTab, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="2,0,2,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Recently Played"
                               Style="{StaticResource Text.Eyebrow}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PlayHistoryTracks.Count, StringFormat=' · {0} tracks'}"
                               Style="{StaticResource Text.Callout}"
                               FontSize="11"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Height="26"
                        Padding="10,0"
                        FontSize="11"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Aura.Queue.ClearHistory"
                        Content="Reset"
                        Command="{Binding ClearPlayHistoryCommand}"
                        ToolTip="Clear listening history">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Style.Button.Ghost}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlayHistoryTracks.Count}" Value="0">
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Empty History State -->
            <Border Grid.Row="1"
                    VerticalAlignment="Top"
                    Padding="18,16"
                    CornerRadius="{StaticResource Radius.Card}"
                    Background="{StaticResource Brush.Rail}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1"
                    Visibility="{Binding PlayHistoryTracks.Count, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=Inverse}">
                <StackPanel>
                    <TextBlock Text="No listening history yet"
                               Style="{StaticResource Text.Subheadline}"
                               Foreground="{StaticResource Brush.Text.Primary}" />
                    <TextBlock Text="Tracks you play are recorded here for one-click replay."
                               Style="{StaticResource Text.Callout}"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Virtualized History List (Single-Click Replays Track Immediately) -->
            <ListBox x:Name="HistoryListBox"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ItemsSource="{Binding PlayHistoryTracks}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     Visibility="{Binding PlayHistoryTracks.Count, Converter={StaticResource NumberToVisibilityConverter}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.FocusVisual.Monochrome}" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="HistoryItem_MouseLeftButtonUp" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="RowBd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="{StaticResource Radius.Card}"
                                            Padding="6,6,6,0"
                                            SnapsToDevicePixels="True">
                                        <StackPanel>
                                            <ContentPresenter />
                                            <Border Height="1"
                                                    Margin="50,6,2,0"
                                                    Background="{StaticResource Brush.Border.Hairline}"
                                                    Opacity="0.6" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.Hover.Dark}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBd" Property="Background" Value="{StaticResource Brush.SelectedRow}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="42"
                              Background="Transparent"
                              Tag="{Binding DataContext, ElementName=Root}">
                            <Grid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Play"
                                              Command="{Binding PlacementTarget.Tag.PlaySelectedTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Play Next"
                                              Command="{Binding PlacementTarget.Tag.PlayNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Add to Queue"
                                              Command="{Binding PlacementTarget.Tag.AddToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Add to Playlist..."
                                              Command="{Binding PlacementTarget.Tag.AddToPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Go to Artist"
                                              Command="{Binding PlacementTarget.Tag.NavigateToArtistLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Go to Album"
                                              Command="{Binding PlacementTarget.Tag.NavigateToAlbumLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <Separator />
                                    <MenuItem Header="Get Info"
                                              InputGestureText="Ctrl+I"
                                              Command="{Binding PlacementTarget.Tag.OpenInfoForTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Inspect Audio Authenticity"
                                              Command="{Binding PlacementTarget.Tag.InspectTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                    <MenuItem Header="Show in Explorer"
                                              Command="{Binding PlacementTarget.Tag.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 40x40 Rounded ImageBrush Artwork + Hover Replay Glyph -->
                            <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                                <Border CornerRadius="{StaticResource Radius.Small}"
                                        Background="{StaticResource Brush.Elevated}"
                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                        BorderThickness="1">
                                    <Path Width="14" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{StaticResource Brush.Icon.Muted}"
                                          StrokeThickness="1.4"
                                          Data="M5,12 A1.8,1.8 0 1 1 1.4,12 A1.8,1.8 0 1 1 5,12 M5,12 L5,2.5 L12.5,1 L12.5,10.5 M12.5,10.5 A1.8,1.8 0 1 1 8.9,10.5 A1.8,1.8 0 1 1 12.5,10.5" />
                                </Border>

                                <Border CornerRadius="{StaticResource Radius.Small}"
                                        RenderOptions.BitmapScalingMode="Linear"
                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                        BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill"
                                                    ImageSource="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                    </Border.Background>
                                </Border>

                                <Border x:Name="HistoryHoverPlay"
                                        CornerRadius="{StaticResource Radius.Small}"
                                        Background="{StaticResource Brush.Overlay.Scrim}"
                                        Visibility="Collapsed">
                                    <Border Width="22" Height="22"
                                            CornerRadius="11"
                                            Background="{StaticResource Brush.Button.PrimaryFill}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Path Width="8" Height="9" Margin="1.5,0,0,0" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Fill="{StaticResource Brush.Icon.OnWhite}"
                                              Data="M1,0.5 L8,4.5 L1,8.5 Z" />
                                    </Border>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}"
                                           Style="{StaticResource Text.Subheadline}"
                                           Foreground="{StaticResource Brush.Text.Primary}" />
                                <TextBlock Text="{Binding Artist}"
                                           Style="{StaticResource Text.Callout}"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Margin="0,1,0,0" />
                            </StackPanel>

                            <Grid Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="HistoryDuration"
                                           Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}"
                                           Style="{StaticResource Text.TabularMono}"
                                           Margin="4,0,4,0"
                                           VerticalAlignment="Center" />
                                <Button x:Name="HistoryMoreBtn"
                                        Width="26" Height="26"
                                        Style="{StaticResource Style.Button.Icon}"
                                        Visibility="Collapsed"
                                        Click="QueueMoreButton_Click"
                                        ToolTip="More Options">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1,0" />
                                        <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1,0" />
                                        <Ellipse Width="2.5" Height="2.5" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="1,0" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="HistoryDuration" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="HistoryMoreBtn" Property="Visibility" Value="Visible" />
                                <Setter TargetName="HistoryHoverPlay" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
