<Window x:Class="AuraAudio.UI.Views.AuthenticityInspectorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AuraAudio.UI.Views"
        mc:Ignorable="d"
        Title="{DynamicResource Str_Inspect_Title}" 
        Height="720" Width="1020"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource Brush.Background.Window}"
        Foreground="{StaticResource Brush.Text.Primary}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="-1" 
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" /> <!-- Custom Window Titlebar -->
                <RowDefinition Height="*" />  <!-- Main Inspector Content -->
            </Grid.RowDefinitions>

            <!-- Custom Dragable Titlebar -->
            <Grid Grid.Row="0" Background="{StaticResource Brush.Background.Sidebar}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Path Data="{StaticResource Icon.WaveformCheck}" Stroke="{StaticResource Brush.Accent.Gold}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="15" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource Str_Inspect_Title}" 
                               FontSize="12.5" 
                               FontWeight="SemiBold" 
                               Foreground="{StaticResource Brush.Text.Primary}" 
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Tombol Tutup Window -->
                <Button Style="{StaticResource Style.Button.WindowClose}" 
                        Click="BtnClose_Click" 
                        HorizontalAlignment="Right" 
                        Width="44" Height="38"
                        AutomationProperties.Name="{DynamicResource Str_Btn_Close}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="{StaticResource Icon.Close}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- Main Inspector View Content -->
            <views:AuthenticityInspectorView Grid.Row="1" />
        </Grid>
    </Border>
</Window>
