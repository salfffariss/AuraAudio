<UserControl x:Class="AuraAudio.UI.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:AuraAudio.Core.Models"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header Card & Action Bar -->
            <RowDefinition Height="*" />    <!-- Content Columns: Queue vs Saved Playlists -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- HEADER CARD & ACTION BAR                                                  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" 
                Background="{StaticResource Brush.Background.Card}" 
                BorderBrush="{StaticResource Brush.Border.Subtle}" 
                BorderThickness="1" 
                CornerRadius="12" 
                Padding="20,16" 
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Summary -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str_Queue_Title}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" />
                    <TextBlock Text="{Binding QueueSummaryText}" FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Right: Action Buttons (Save, Export, Import, Clear) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Simpan sebagai Playlist -->
                    <Button Style="{StaticResource Style.Button.Transport}" 
                            Command="{Binding SaveQueueAsPlaylistCommand}" 
                            Padding="12,7" Height="36" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Save}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Str_Queue_SavePlaylist}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Ekspor M3U8 -->
                    <Button Style="{StaticResource Style.Button.Transport}" 
                            Command="{Binding ExportQueueToM3uCommand}" 
                            Padding="12,7" Height="36" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Export}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Str_Queue_ExportM3u}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Impor M3U/M3U8 -->
                    <Button Style="{StaticResource Style.Button.Transport}" 
                            Command="{Binding ImportM3uPlaylistCommand}" 
                            Padding="12,7" Height="36" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Import}" Stroke="{StaticResource Brush.Text.Secondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Str_Queue_ImportM3u}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Bersihkan Antrean -->
                    <Button Style="{StaticResource Style.Button.Transport}" 
                            Command="{Binding ClearQueueCommand}" 
                            Padding="12,7" Height="36">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Trash}" Stroke="{StaticResource Brush.Accent.Red}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Str_Queue_Clear}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Red}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- CONTENT: DAFTAR ANTREAN MUSIK (FULL WIDTH)                                -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" 
                Background="{StaticResource Brush.Background.Card}" 
                BorderBrush="{StaticResource Brush.Border.Subtle}" 
                BorderThickness="1" 
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" /> <!-- Header Kolom -->
                        <RowDefinition Height="*" />  <!-- ListBox Antrean -->
                    </Grid.RowDefinitions>

                    <!-- Table Column Headers -->
                    <Border Grid.Row="0" Background="{StaticResource Brush.Background.Sidebar}" BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="65" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource Str_Table_TrackNo}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource Str_Table_Art}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                            <TextBlock Grid.Column="2" Text="{DynamicResource Str_Table_TitleAndArtist}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                            <TextBlock Grid.Column="3" Text="{DynamicResource Str_Table_Album}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                            <TextBlock Grid.Column="4" Text="{DynamicResource Str_Table_Format}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" />
                            <TextBlock Grid.Column="5" Text="{DynamicResource Str_Table_Duration}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="6" Text="{DynamicResource Str_Table_Order}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- ListBox Antrean Musik -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding QueueTracks}" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto" 
                             MouseDoubleClick="QueueListBox_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#22222B" />
                                <Setter Property="Height" Value="52" />
                                <Setter Property="Padding" Value="16,0" />
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnListBoxItemPreviewMouseRightButtonDown" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{DynamicResource Str_Ctx_PlayNow}" Command="{Binding PlayQueueItemCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{DynamicResource Str_Ctx_MoveUp}" Command="{Binding MoveQueueItemUpCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="{DynamicResource Str_Ctx_MoveDown}" Command="{Binding MoveQueueItemDownCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Separator />
                                            <MenuItem Header="{DynamicResource Str_Ctx_RemoveFromQueue}" Command="{Binding RemoveQueueItemCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="{StaticResource Brush.Accent.Red}" />
                                            <MenuItem Header="{DynamicResource Str_Ctx_InspectAuthenticity}" Command="{Binding InspectTrackCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="{StaticResource Brush.Accent.Gold}" />
                                            <MenuItem Header="{DynamicResource Str_Ctx_OpenFileLocation}" Command="{Binding OpenFileLocationCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="itemBorder" 
                                                    Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource Brush.Background.CardHover}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#25252E" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrentlyPlaying}" Value="True">
                                                    <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent.Gold}" />
                                                    <Setter TargetName="itemBorder" Property="BorderThickness" Value="3,0,0,1" />
                                                    <Setter TargetName="itemBorder" Property="Background" Value="#211D17" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:QueueTrackItem}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="65" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Icon / Nomor Antrean (1, 2, 3...) -->
                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <!-- Nomor biasa jika tidak sedang diputar -->
                                        <TextBlock Text="{Binding DisplayNumber}" FontSize="12" 
                                                   Foreground="{StaticResource Brush.Text.Tertiary}" 
                                                   Visibility="{Binding IsCurrentlyPlaying, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                        <!-- Ikon putar jika lagu aktif -->
                                        <Path Fill="{StaticResource Brush.Accent.Gold}" Data="{StaticResource Icon.Play}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                                              Visibility="{Binding IsCurrentlyPlaying, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>

                                    <!-- Cover Thumbnail -->
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="4" ClipToBounds="True" Background="{StaticResource Brush.Background.Sidebar}" HorizontalAlignment="Left">
                                        <Grid>
                                            <Path Data="{StaticResource Icon.MusicNote}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55" />
                                            <Image Source="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>

                                    <!-- Judul & Artis -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" FontSize="11.5" Foreground="{StaticResource Brush.Text.Tertiary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Album -->
                                    <TextBlock Grid.Column="3" Text="{Binding Album}" FontSize="12" Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />

                                    <!-- Format Badge -->
                                    <Border Grid.Column="4" 
                                            Background="{StaticResource Brush.Background.CardHover}" 
                                            BorderBrush="{StaticResource Brush.Border.Subtle}" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            HorizontalAlignment="Left" 
                                            VerticalAlignment="Center" 
                                            Padding="6,2">
                                        <TextBlock Text="{Binding StreamSpec.FormattedBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent.Gold}" />
                                    </Border>

                                    <!-- Durasi -->
                                    <TextBlock Grid.Column="5" 
                                               Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}" 
                                               FontSize="11.5" 
                                               Foreground="{StaticResource Brush.Text.Tertiary}" 
                                               HorizontalAlignment="Right" 
                                               VerticalAlignment="Center" />

                                    <!-- Reorder & Remove Action Buttons -->
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Move Up -->
                                        <Button Style="{StaticResource Style.Button.PlayerIcon}" 
                                                Width="24" Height="24" 
                                                Command="{Binding DataContext.MoveQueueItemUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                CommandParameter="{Binding}" 
                                                AutomationProperties.Name="{DynamicResource Str_Ctx_MoveUp}"
                                                ToolTip="{DynamicResource Str_Ctx_MoveUp}">
                                            <Path Data="{StaticResource Icon.ChevronUp}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                                        </Button>

                                        <!-- Move Down -->
                                        <Button Style="{StaticResource Style.Button.PlayerIcon}" 
                                                Width="24" Height="24" 
                                                Command="{Binding DataContext.MoveQueueItemDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                CommandParameter="{Binding}" 
                                                AutomationProperties.Name="{DynamicResource Str_Ctx_MoveDown}"
                                                ToolTip="{DynamicResource Str_Ctx_MoveDown}">
                                            <Path Data="{StaticResource Icon.ChevronDown}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" />
                                        </Button>

                                        <!-- Remove -->
                                        <Button Width="24" Height="24" 
                                                Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" 
                                                CommandParameter="{Binding}" 
                                                AutomationProperties.Name="{DynamicResource Str_Ctx_RemoveFromQueue}"
                                                ToolTip="{DynamicResource Str_Ctx_RemoveFromQueue}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Style.Button.PlayerIcon}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent.Red}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Data="{StaticResource Icon.Close}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="9" Height="9" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Pesan jika antrean kosong -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding QueueTracks.Count, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Path Data="{StaticResource Icon.Queue}" Stroke="{StaticResource Brush.Text.Tertiary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="{DynamicResource Str_Queue_EmptyTitle}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Primary}" HorizontalAlignment="Center" TextAlignment="Center" />
                        <TextBlock Text="{DynamicResource Str_Queue_EmptyDesc}" 
                                   FontSize="12.5" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap" />
                        <Button Style="{StaticResource Style.Button.Primary}"
                                Command="{Binding NavigateCommand}"
                                CommandParameter="Library"
                                Padding="18,8" Margin="0,16,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str_Queue_BrowseLibraryBtn}" FontSize="12" FontWeight="SemiBold" Foreground="#111114" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
    </Grid>
</UserControl>
