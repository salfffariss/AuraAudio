<UserControl x:Class="AuraAudio.UI.Views.AlbumsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AuraAudio.UI.Controls"
             xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers"
             x:Name="Root"
             Background="{StaticResource Brush.Canvas}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar: Title + Sort Selector + Quick Filter (Flush with virtualized grid viewport) -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="HeaderScrollbarSpacer" Width="12" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ContentHost"
                        Grid.Column="0"
                        MaxWidth="{StaticResource Width.MaxContent}"
                        Margin="24,24,24,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Albums" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Style="{StaticResource Text.Callout}"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                   Margin="0,2,0,0"
                                   Text="{Binding DisplayedAlbums.Count, StringFormat={}{0} albums}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick Filter Input -->
                        <Border Width="210"
                                Height="34"
                                Margin="0,0,10,0"
                                CornerRadius="{StaticResource Radius.SearchPill}"
                                Background="{StaticResource Brush.Elevated}"
                                BorderBrush="{StaticResource Brush.Border.Control}"
                                BorderThickness="1">
                            <Grid Margin="10,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Filter albums..."
                                           Style="{StaticResource Text.Callout}"
                                           Foreground="{StaticResource Brush.Text.Tertiary}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding AlbumFilterQuery, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}" />
                                <TextBox Grid.Column="0"
                                         Style="{StaticResource Style.TextBox.SearchPill}"
                                         Text="{Binding AlbumFilterQuery, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource Style.Button.Icon}"
                                        Width="20" Height="20"
                                        Click="ClearAlbumFilter_Click"
                                        Visibility="{Binding AlbumFilterQuery, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Path Width="7" Height="7" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5"
                                          Data="M1,1 L6,6 M6,1 L1,6" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Sort Selector -->
                        <ComboBox Width="164"
                                  SelectedValuePath="Tag"
                                  SelectedValue="{Binding AlbumSortMode, Mode=TwoWay}">
                            <ComboBoxItem Content="Sort: Title A–Z" Tag="Title" />
                            <ComboBoxItem Content="Sort: Recently Added" Tag="RecentlyAdded" />
                            <ComboBoxItem Content="Sort: Artist" Tag="Artist" />
                            <ComboBoxItem Content="Sort: Year" Tag="Year" />
                            <ComboBoxItem Content="Sort: Hi-Res First" Tag="HiResFirst" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Width Probe (measures exact inner viewport width matching virtualized grid) -->
                <Border x:Name="GridWidthProbe"
                        Height="0"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <!-- Empty State -->
        <Border Grid.Row="1"
                VerticalAlignment="Top"
                MaxWidth="{StaticResource Width.MaxContent}"
                Margin="24,0,24,24"
                Padding="28,24"
                CornerRadius="{StaticResource Radius.Sheet}"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border.Hairline}"
                BorderThickness="1"
                Visibility="{Binding DisplayedAlbums.Count, Converter={StaticResource NumberToVisibilityConverter}, ConverterParameter=Inverse}">
            <TextBlock Text="No albums match your current filter."
                       Style="{StaticResource Text.Body}"
                       Foreground="{StaticResource Brush.Text.Secondary}" />
        </Border>

        <!-- Virtualized Responsive GridG (6 / 5 / 4 / 3 Frameless Editorial SquareLockups, Single-Pass VirtualizingUniformGrid) -->
        <ItemsControl x:Name="AlbumsItemsControl"
                      Grid.Row="1"
                      AutomationProperties.AutomationId="Aura.Albums.Grid"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ItemsSource="{Binding DisplayedAlbums}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      Visibility="{Binding DisplayedAlbums.Count, Converter={StaticResource NumberToVisibilityConverter}}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="PART_AlbumsScrollViewer"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Visible">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <controls:VirtualizingUniformGrid HorizontalPadding="24"
                                                      BottomPadding="104"
                                                      MaxContentWidth="{StaticResource Width.MaxContent}"
                                                      ItemHorizontalGap="20"
                                                      CaptionReservedHeight="94" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,0,10,24"
                          HorizontalAlignment="Stretch"
                          Background="Transparent"
                          Cursor="Hand"
                          Tag="{Binding DataContext, ElementName=Root}"
                          PreviewMouseLeftButtonDown="AlbumTile_PreviewMouseLeftButtonDown"
                          MouseMove="AlbumTile_MouseMove"
                          MouseLeftButtonUp="AlbumTile_MouseLeftButtonUp">
                        <Grid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Play Album"
                                          Command="{Binding PlacementTarget.Tag.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Shuffle Album"
                                          Command="{Binding PlacementTarget.Tag.ShuffleAlbumCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Play Next"
                                          Command="{Binding PlacementTarget.Tag.PlayAlbumNextCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Add to Queue"
                                          Command="{Binding PlacementTarget.Tag.AddAlbumToQueueCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <Separator />
                                <MenuItem Header="Open Album"
                                          Command="{Binding PlacementTarget.Tag.OpenAlbumDetailCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Go to Artist"
                                          Command="{Binding PlacementTarget.Tag.NavigateToArtistLinkCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding Artist}" />
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Exact 1:1 Square Artwork (Set directly by VirtualizingUniformGrid in single Measure pass) -->
                        <Grid Grid.Row="0"
                              HorizontalAlignment="Stretch"
                              Height="210"
                              helpers:FluidBehaviors.EnablePressScale="True">
                            <Border CornerRadius="{StaticResource Radius.Card}"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1">
                                <Path Width="36" Height="36" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{StaticResource Brush.Icon.Muted}"
                                      StrokeThickness="1.3"
                                      Data="M8,22 A3.5,3.5 0 1 1 1,22 A3.5,3.5 0 1 1 8,22 M8,22 L8,4 L24,1.5 L24,19.5 M24,19.5 A3.5,3.5 0 1 1 17,19.5 A3.5,3.5 0 1 1 24,19.5" />
                            </Border>

                            <Border x:Name="ArtBorder"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    RenderOptions.BitmapScalingMode="Linear"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill"
                                                ImageSource="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Grid}" />
                                </Border.Background>
                            </Border>

                            <!-- Dual-Corner Hover Overlay: Collapsed until hovered to keep non-hovered layout cost zero -->
                            <Border x:Name="HoverOverlay"
                                    CornerRadius="{StaticResource Radius.Card}"
                                    Background="{StaticResource Brush.Overlay.ArtworkScrim}"
                                    Visibility="Collapsed">
                                <Grid Margin="10">
                                    <Button Width="32" Height="32"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource Style.Button.RoundPlay}"
                                            Command="{Binding DataContext.PlayAlbumCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Play Album">
                                        <Path Width="11" Height="12" Margin="2,0,0,0" Stretch="Uniform"
                                              Fill="{StaticResource Brush.Icon.OnWhite}"
                                              Data="M1,0.5 L11,6 L1,11.5 Z" />
                                    </Button>

                                    <Button Width="32" Height="32"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Cursor="Hand"
                                            FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                                            Click="MoreButton_Click"
                                            ToolTip="More Options">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="MoreBd"
                                                        CornerRadius="16"
                                                        Background="{StaticResource Brush.Surface}"
                                                        BorderBrush="{StaticResource Brush.Border.Control}"
                                                        BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Active}" Margin="1,0" />
                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Active}" Margin="1,0" />
                                                        <Ellipse Width="3" Height="3" Fill="{StaticResource Brush.Icon.Active}" Margin="1,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="MoreBd" Property="Background" Value="{StaticResource Brush.Elevated}" />
                                                        <Setter TargetName="MoreBd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Frameless Editorial Caption Below Artwork -->
                        <StackPanel Grid.Row="1" Margin="2,8,2,0">
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource Text.BodyEmph}"
                                       Foreground="{StaticResource Brush.Text.Primary}" />
                            <Button HorizontalAlignment="Left"
                                    Margin="0,2,0,0"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.NavigateToArtistLinkCommand, ElementName=Root}"
                                    CommandParameter="{Binding Artist}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <TextBlock x:Name="ArtLink"
                                                   Text="{Binding Artist}"
                                                   Style="{StaticResource Text.Callout}"
                                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ArtLink" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                                                <Setter TargetName="ArtLink" Property="TextDecorations" Value="Underline" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding GridSubtitleText}"
                                           Style="{StaticResource Text.Footnote}"
                                           VerticalAlignment="Center" />
                                <Border Margin="6,0,0,0"
                                        Padding="4,1"
                                        CornerRadius="{StaticResource Radius.Badge}"
                                        BorderBrush="{StaticResource Brush.Border.Control}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True"
                                        Visibility="{Binding IsHiRes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="HI-RES"
                                               Style="{StaticResource Text.Footnote}"
                                               FontSize="9"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.Text.Secondary}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <DataTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverOverlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ArtBorder" Property="BorderBrush" Value="{StaticResource Brush.Border.Control}" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
