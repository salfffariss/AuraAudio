<Window x:Class="AuraAudio.UI.Windows.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers"
        xmlns:views="clr-namespace:AuraAudio.UI.Views"
        Title="AuraAudio v2.0.1 Mini-Player"
        Width="350"
        Height="160"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        Focusable="True"
        FocusVisualStyle="{x:Null}"
        Background="{StaticResource Brush.Rail}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource Brush.Rail}"
            BorderBrush="{StaticResource Brush.Border.Control}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PlayerStageRow" Height="158" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- =================================================================
                 ROW 0: COMPACT (350x160) OR ALBUM VIEW (350x350) STAGE
                 ================================================================= -->
            <Grid x:Name="MiniStageHost"
                  Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="MiniHeader_MouseLeftButtonDown">

                <!-- MODE A: DEFAULT COMPACT VIEW (350x160) -->
                <Grid Margin="12,10,12,8"
                      Visibility="{Binding Presentation.IsMiniPlayerAlbumView, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="60" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Track Artwork (60x60) + Title / Artist (Reserves 64px right for shared controls) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Width="56" Height="56"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                Cursor="Hand"
                                FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                                Command="{Binding Presentation.ToggleMiniPlayerViewModeCommand}"
                                ToolTip="Switch to Album View">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid Width="56" Height="56">
                                        <Border CornerRadius="{StaticResource Radius.Card}"
                                                Background="{StaticResource Brush.Surface}"
                                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                BorderThickness="1">
                                            <Path Width="18" Height="18" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{StaticResource Brush.Icon.Muted}"
                                                  StrokeThickness="1.5"
                                                  Data="M6,14 A2,2 0 1 1 2,14 A2,2 0 1 1 6,14 M6,14 L6,3 L15,1.5 L15,12 M15,12 A2,2 0 1 1 11,12 A2,2 0 1 1 15,12" />
                                        </Border>
                                        <Border CornerRadius="{StaticResource Radius.Card}"
                                                RenderOptions.BitmapScalingMode="HighQuality"
                                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                BorderThickness="1">
                                            <Border.Background>
                                                <ImageBrush Stretch="UniformToFill"
                                                            ImageSource="{Binding CurrentTrack.CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentTrack.Title, TargetNullValue='AuraAudio Ready', FallbackValue='AuraAudio Ready'}"
                                       Style="{StaticResource Text.Subheadline}"
                                       Foreground="{StaticResource Brush.Text.Peak}" />
                            <TextBlock Text="{Binding CurrentTrack.Artist, TargetNullValue='Bit-Perfect Playback', FallbackValue='Bit-Perfect Playback'}"
                                       Style="{StaticResource Text.Callout}"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       Margin="0,1,0,2" />
                            <Border HorizontalAlignment="Left"
                                    Padding="5,1"
                                    CornerRadius="{StaticResource Radius.Badge}"
                                    Background="{StaticResource Brush.Surface}"
                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding LcdSpecBadge}"
                                           Style="{StaticResource Text.TabularMono}"
                                           FontSize="9"
                                           Foreground="{StaticResource Brush.Text.Secondary}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Scrubber Row -->
                    <Grid Grid.Row="1" Margin="0,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource Text.TabularMono}"
                                   FontSize="10"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding CurrentTime, Converter={StaticResource TimeSpanToStringConverter}}" />

                        <Slider x:Name="CompactScrubber"
                                Grid.Column="1"
                                Style="{StaticResource Style.Slider.MonochromeScrubber}"
                                helpers:FluidBehaviors.EnableDirectScrub="True"
                                Minimum="0"
                                Maximum="{Binding SeekSliderMaximum}"
                                Value="{Binding SeekSliderValue, Mode=TwoWay}"
                                Thumb.DragStarted="MiniScrubber_DragStarted"
                                Thumb.DragCompleted="MiniScrubber_DragCompleted"
                                PreviewMouseLeftButtonDown="MiniScrubber_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="MiniScrubber_PreviewMouseLeftButtonUp" />

                        <TextBlock Grid.Column="2"
                                   Style="{StaticResource Text.TabularMono}"
                                   FontSize="10"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding TotalTime, Converter={StaticResource TimeSpanToStringConverter}}" />
                    </Grid>

                    <!-- Bottom Controls Row: Volume | Transport | Lyrics & Queue Toggles -->
                    <Grid Grid.Row="2" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Compact Volume -->
                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Style="{StaticResource Style.Button.Icon}"
                                    Width="24" Height="24"
                                    Command="{Binding ToggleMuteCommand}"
                                    ToolTip="Mute / Unmute">
                                <Path Width="12" Height="10" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.3"
                                      Data="M1,3.5 L3.8,3.5 L7.5,1 L7.5,9.5 L3.8,7 L1,7 Z" />
                            </Button>
                            <Slider Grid.Column="1"
                                    Margin="4,0,4,0"
                                    Style="{StaticResource Style.Slider.MonochromeVolume}"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="{Binding Volume, Mode=TwoWay}" />
                        </Grid>

                        <!-- Center Transport -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource Style.Button.Icon}"
                                    Width="28" Height="28"
                                    Command="{Binding PreviousTrackCommand}"
                                    ToolTip="Previous Track">
                                <Path Width="12" Height="10" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M0,1 L2,1 L2,10 L0,10 Z M12,1 L3.5,5.5 L12,10 Z" />
                            </Button>

                            <Button Style="{StaticResource Style.Button.RoundPlay}"
                                    Width="32" Height="32"
                                    Margin="6,0"
                                    Command="{Binding TogglePlayPauseCommand}"
                                    ToolTip="Play / Pause (Space)">
                                <Grid>
                                    <Path Width="11" Height="12" Margin="2,0,0,0" Stretch="Uniform"
                                          Fill="{StaticResource Brush.Icon.OnWhite}"
                                          Data="M1,0.5 L11,6 L1,11.5 Z"
                                          Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                    <Path Width="10" Height="12" Stretch="Uniform"
                                          Fill="{StaticResource Brush.Icon.OnWhite}"
                                          Data="M1,1 L4,1 L4,11 L1,11 Z M6.5,1 L9.5,1 L9.5,11 L6.5,11 Z"
                                          Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource Style.Button.Icon}"
                                    Width="28" Height="28"
                                    Command="{Binding NextTrackCommand}"
                                    ToolTip="Next Track">
                                <Path Width="12" Height="10" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M0,1 L8.5,5.5 L0,10 Z M10,1 L12,1 L12,10 L10,10 Z" />
                            </Button>
                        </StackPanel>

                        <!-- Lyrics & Queue Expandable Tray Toggles -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource Style.Toggle.Dock}"
                                          Width="28" Height="28"
                                          AutomationProperties.AutomationId="Aura.MiniPlayer.LyricsTray"
                                          IsChecked="{Binding Presentation.IsMiniPlayerLyricsActive, Mode=TwoWay}"
                                          ToolTip="Toggle Lyrics Tray">
                                <Path Width="13" Height="12" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.3"
                                      Data="M2,2 L13,2 L13,9.5 L6.5,9.5 L4,11.5 L4,9.5 L2,9.5 Z M4.5,5 L10.5,5 M4.5,7.2 L8.8,7.2" />
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource Style.Toggle.Dock}"
                                          Width="28" Height="28"
                                          Margin="4,0,0,0"
                                          AutomationProperties.AutomationId="Aura.MiniPlayer.QueueTray"
                                          IsChecked="{Binding Presentation.IsMiniPlayerQueueActive, Mode=TwoWay}"
                                          ToolTip="Toggle Queue Tray">
                                <Path Width="13" Height="11" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.3"
                                      Data="M1,2 L12,2 M1,5.5 L12,5.5 M1,9 L8,9 M10,7.5 L12.5,9 L10,10.5 Z" />
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- MODE B: ALBUM VIEW (350x350 Full Cover Art + Hover Scrim Controls) -->
                <Grid x:Name="AlbumViewStage"
                      Visibility="{Binding Presentation.IsMiniPlayerAlbumView, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="{StaticResource Brush.Surface}">
                        <Path Width="56" Height="56" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stroke="{StaticResource Brush.Icon.Muted}"
                              StrokeThickness="1.3"
                              Data="M14,38 A6,6 0 1 1 2,38 A6,6 0 1 1 14,38 M14,38 L14,7 L40,2.5 L40,33.5 M40,33.5 A6,6 0 1 1 28,33.5 A6,6 0 1 1 40,33.5" />
                    </Border>

                    <Border RenderOptions.BitmapScalingMode="HighQuality">
                        <Border.Background>
                            <ImageBrush Stretch="UniformToFill"
                                        ImageSource="{Binding CurrentTrack.CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Large}" />
                        </Border.Background>
                    </Border>

                    <!-- Hover-Revealed Monochrome Scrim Overlay -->
                    <Border x:Name="AlbumHoverScrim"
                            VerticalAlignment="Bottom"
                            Padding="14,26,14,12"
                            Background="{StaticResource Brush.Overlay.ArtworkScrim}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.92" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=AlbumViewStage}" Value="True">
                                        <Setter Property="Opacity" Value="1.0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <Border Padding="12,10"
                                CornerRadius="{StaticResource Radius.Sheet}"
                                Background="{StaticResource Brush.DockBackground}"
                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentTrack.Title, TargetNullValue='AuraAudio Ready', FallbackValue='AuraAudio Ready'}"
                                           Style="{StaticResource Text.Subheadline}"
                                           Foreground="{StaticResource Brush.Text.Peak}" />
                                <TextBlock Text="{Binding CurrentTrack.Artist, TargetNullValue='Bit-Perfect Playback', FallbackValue='Bit-Perfect Playback'}"
                                           Style="{StaticResource Text.Callout}"
                                           FontSize="11"
                                           Foreground="{StaticResource Brush.Text.Secondary}"
                                           Margin="0,1,0,6" />

                                <!-- AlbumView Scrubber -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource Text.TabularMono}"
                                               FontSize="10"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding CurrentTime, Converter={StaticResource TimeSpanToStringConverter}}" />
                                    <Slider x:Name="AlbumScrubber"
                                            Grid.Column="1"
                                            Style="{StaticResource Style.Slider.MonochromeScrubber}"
                                            helpers:FluidBehaviors.EnableDirectScrub="True"
                                            Minimum="0"
                                            Maximum="{Binding SeekSliderMaximum}"
                                            Value="{Binding SeekSliderValue, Mode=TwoWay}"
                                            Thumb.DragStarted="MiniScrubber_DragStarted"
                                            Thumb.DragCompleted="MiniScrubber_DragCompleted"
                                            PreviewMouseLeftButtonDown="MiniScrubber_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="MiniScrubber_PreviewMouseLeftButtonUp" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource Text.TabularMono}"
                                               FontSize="10"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding TotalTime, Converter={StaticResource TimeSpanToStringConverter}}" />
                                </Grid>

                                <!-- AlbumView Transport & Tray Toggles -->
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <ToggleButton Style="{StaticResource Style.Toggle.Dock}"
                                                      Width="28" Height="28"
                                                      IsChecked="{Binding Presentation.IsMiniPlayerLyricsActive, Mode=TwoWay}"
                                                      ToolTip="Toggle Lyrics Tray">
                                            <Path Width="13" Height="12" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                  StrokeThickness="1.3"
                                                  Data="M2,2 L13,2 L13,9.5 L6.5,9.5 L4,11.5 L4,9.5 L2,9.5 Z M4.5,5 L10.5,5 M4.5,7.2 L8.8,7.2" />
                                        </ToggleButton>
                                        <ToggleButton Style="{StaticResource Style.Toggle.Dock}"
                                                      Width="28" Height="28"
                                                      Margin="4,0,0,0"
                                                      IsChecked="{Binding Presentation.IsMiniPlayerQueueActive, Mode=TwoWay}"
                                                      ToolTip="Toggle Queue Tray">
                                            <Path Width="13" Height="11" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                  StrokeThickness="1.3"
                                                  Data="M1,2 L12,2 M1,5.5 L12,5.5 M1,9 L8,9 M10,7.5 L12.5,9 L10,10.5 Z" />
                                        </ToggleButton>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Style.Button.Icon}"
                                                Width="28" Height="28"
                                                Command="{Binding PreviousTrackCommand}">
                                            <Path Width="12" Height="10" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M0,1 L2,1 L2,10 L0,10 Z M12,1 L3.5,5.5 L12,10 Z" />
                                        </Button>
                                        <Button Style="{StaticResource Style.Button.RoundPlay}"
                                                Width="34" Height="34"
                                                Margin="8,0"
                                                Command="{Binding TogglePlayPauseCommand}">
                                            <Grid>
                                                <Path Width="11" Height="12" Margin="2,0,0,0" Stretch="Uniform"
                                                      Fill="{StaticResource Brush.Icon.OnWhite}"
                                                      Data="M1,0.5 L11,6 L1,11.5 Z"
                                                      Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                                <Path Width="10" Height="12" Stretch="Uniform"
                                                      Fill="{StaticResource Brush.Icon.OnWhite}"
                                                      Data="M1,1 L4,1 L4,11 L1,11 Z M6.5,1 L9.5,1 L9.5,11 L6.5,11 Z"
                                                      Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource Style.Button.Icon}"
                                                Width="28" Height="28"
                                                Command="{Binding NextTrackCommand}">
                                            <Path Width="12" Height="10" Stretch="Uniform"
                                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  Data="M0,1 L8.5,5.5 L0,10 Z M10,1 L12,1 L12,10 L10,10 Z" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <!-- SHARED TOP-RIGHT CHROME CAPSULE (Always visible in both Compact & AlbumView) -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,8,8,0"
                        Padding="2"
                        CornerRadius="{StaticResource Radius.Card}"
                        Background="{StaticResource Brush.DockBackground}"
                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Style.Button.Icon}"
                                Width="26" Height="26"
                                AutomationProperties.AutomationId="Aura.MiniPlayer.ToggleMode"
                                Command="{Binding Presentation.ToggleMiniPlayerViewModeCommand}"
                                ToolTip="Toggle Compact / Album View">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.3"
                                  Data="M1.5,1.5 L10.5,1.5 L10.5,10.5 L1.5,10.5 Z M1.5,7.5 L4.5,5 L7,7.5 L8.5,6 L10.5,8" />
                        </Button>

                        <Button Style="{StaticResource Style.Button.Icon}"
                                Width="26" Height="26"
                                Margin="2,0,0,0"
                                AutomationProperties.AutomationId="Aura.MiniPlayer.Return"
                                Command="{Binding Presentation.CloseMiniPlayerCommand}"
                                ToolTip="Return to Full Window (Esc)">
                            <Path Width="12" Height="12" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  Data="M1.5,4.5 L1.5,1.5 L4.5,1.5 M7.5,1.5 L10.5,1.5 L10.5,4.5 M10.5,7.5 L10.5,10.5 L7.5,10.5 M4.5,10.5 L1.5,10.5 L1.5,7.5" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =================================================================
                 ROW 1: EXPANDABLE 260px QUEUE / LYRICS TRAY
                 ================================================================= -->
            <Border x:Name="MiniTrayBorder"
                    Grid.Row="1"
                    Height="0"
                    ClipToBounds="True"
                    Padding="12,10"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="0,1,0,0"
                    Visibility="Collapsed">
                <Grid Height="240" VerticalAlignment="Top">
                    <views:QueuePaneView ShowHeaderTabs="True"
                                         ClearButtonAutomationId="Aura.MiniPlayer.QueueClear"
                                         Visibility="{Binding Presentation.IsMiniPlayerQueueActive, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <views:LyricsView IsFullScreenMode="False"
                                      AutomationProperties.AutomationId="Aura.MiniPlayer.LyricsList"
                                      Visibility="{Binding Presentation.IsMiniPlayerLyricsActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
