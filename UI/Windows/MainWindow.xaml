<Window x:Class="AuraAudio.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:AuraAudio.UI.Controls"
        xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers"
        xmlns:views="clr-namespace:AuraAudio.UI.Views"
        Title="AuraAudio v2.0.1"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Focusable="True"
        FocusVisualStyle="{x:Null}"
        Background="{StaticResource Brush.Canvas}"
        Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Primary}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="ShellRoot" Background="{StaticResource Brush.Canvas}">
        <Grid.RowDefinitions>
            <!-- ROW 0: Top 48px Navigation / Breadcrumb / Search / Window Chrome Bar -->
            <RowDefinition Height="{StaticResource GridHeight.TopBar}" />
            <!-- ROW 1: Main Workspace (Rail | Content | Right Split Pane + Floating Bottom Dock Capsule) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================================================================
             ROW 0: TOP NAVIGATION & HEADER BAR (48px, Neutral.05)
             =================================================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.TopBar}"
                BorderBrush="{StaticResource Brush.Border.Hairline}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Cluster: Sidebar Toggle + Back / Forward -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,12,0">
                    <Button Style="{StaticResource Style.Button.Icon}"
                            AutomationProperties.AutomationId="Aura.TopBar.RailToggle"
                            Command="{Binding Presentation.ToggleSidebarCommand}"
                            ToolTip="Toggle Sidebar">
                        <Path Width="15" Height="13" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              Data="M1,2 L15,2 M1,6.5 L15,6.5 M1,11 L15,11" />
                    </Button>

                    <Button Style="{StaticResource Style.Button.Icon}"
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="Aura.TopBar.Back"
                            Command="{Binding NavigateBackCommand}"
                            IsEnabled="{Binding CanNavigateBack}"
                            ToolTip="Back (Alt+Left)">
                        <Path Width="7" Height="12" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              Data="M6,1 L1,6 L6,11" />
                    </Button>

                    <Button Style="{StaticResource Style.Button.Icon}"
                            Margin="2,0,0,0"
                            AutomationProperties.AutomationId="Aura.TopBar.Forward"
                            Command="{Binding NavigateForwardCommand}"
                            IsEnabled="{Binding CanNavigateForward}"
                            ToolTip="Forward (Alt+Right)">
                        <Path Width="7" Height="12" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.6"
                              Data="M1,1 L6,6 L1,11" />
                    </Button>
                </StackPanel>

                <!-- Route Title & Breadcrumb -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="4,0,12,0">
                    <TextBlock Text="{Binding CurrentBreadcrumbRoot}"
                               Style="{StaticResource Text.Headline}"
                               Foreground="{StaticResource Brush.Text.Peak}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="›"
                               Margin="8,0"
                               FontSize="15"
                               Foreground="{StaticResource Brush.Text.Tertiary}"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasBreadcrumbDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding CurrentBreadcrumbDetail}"
                               Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               VerticalAlignment="Center"
                               MaxWidth="360"
                               Visibility="{Binding HasBreadcrumbDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <!-- Global Search Pill (280px, Ctrl+F) + Live SearchHints Dropdown -->
                <Grid Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border x:Name="SearchPillBorder"
                            Width="{StaticResource Width.SearchBox}"
                            Height="32"
                            Background="{StaticResource Brush.Elevated}"
                            BorderBrush="{StaticResource Brush.Border.Control}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.SearchPill}">
                        <Grid Margin="10,0,6,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Width="13" Height="13"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Stroke="{StaticResource Brush.Icon.Muted}"
                                  StrokeThickness="1.5"
                                  Data="M6,1 A5,5 0 1 1 6,11 A5,5 0 1 1 6,1 M9.8,9.8 L13,13" />

                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Search library (Ctrl+F)"
                                           Style="{StaticResource Text.Callout}"
                                           Foreground="{StaticResource Brush.Text.Tertiary}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Search.HasQuery, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                <TextBox x:Name="GlobalSearchBox"
                                         Style="{StaticResource Style.TextBox.SearchPill}"
                                         AutomationProperties.AutomationId="Aura.TopBar.SearchBox"
                                         Text="{Binding Search.Query, UpdateSourceTrigger=PropertyChanged}"
                                         GotKeyboardFocus="GlobalSearchBox_GotFocus"
                                         LostKeyboardFocus="GlobalSearchBox_LostFocus"
                                         PreviewKeyDown="GlobalSearchBox_KeyDown" />
                            </Grid>

                            <Button Grid.Column="2"
                                    Style="{StaticResource Style.Button.Icon}"
                                    Width="22" Height="22"
                                    Command="{Binding Search.ClearSearchCommand}"
                                    Visibility="{Binding Search.HasQuery, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="Clear search">
                                <Path Width="8" Height="8" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5"
                                      Data="M1,1 L7,7 M7,1 L1,7" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Top-Bar Live SearchHints Dropdown -->
                    <Popup x:Name="SearchHintsPopup"
                           IsOpen="{Binding Search.IsHintsOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=SearchPillBorder}"
                           Placement="Bottom"
                           HorizontalOffset="-60"
                           VerticalOffset="6"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Width="340"
                                Padding="6"
                                CornerRadius="{StaticResource Radius.Sheet}"
                                Background="{StaticResource Brush.Elevated}"
                                BorderBrush="{StaticResource Brush.Border.Control}"
                                BorderThickness="1"
                                AutomationProperties.AutomationId="Aura.Search.HintsPopup">
                            <StackPanel>
                                <ListBox x:Name="SearchHintsList"
                                         ItemsSource="{Binding Search.QuickHints}"
                                         MaxHeight="340"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         PreviewMouseLeftButtonUp="SearchHintsList_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Width="40" Height="40">
                                                    <Border CornerRadius="{StaticResource Radius.Control}"
                                                            Background="{StaticResource Brush.Surface}"
                                                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                            BorderThickness="1">
                                                        <Path Width="14" Height="14" Stretch="Uniform"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Stroke="{StaticResource Brush.Icon.Muted}"
                                                              StrokeThickness="1.4"
                                                              Data="M6,13 A2,2 0 1 1 2,13 A2,2 0 1 1 6,13 M6,13 L6,3 L14,1.5 L14,11.5" />
                                                    </Border>
                                                    <Border CornerRadius="{StaticResource Radius.Control}"
                                                            RenderOptions.BitmapScalingMode="HighQuality"
                                                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                            BorderThickness="1">
                                                        <Border.Background>
                                                            <ImageBrush Stretch="UniformToFill"
                                                                        ImageSource="{Binding CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                                    <TextBlock Text="{Binding Title}"
                                                               Style="{StaticResource Text.Subheadline}"
                                                               Foreground="{StaticResource Brush.Text.Peak}" />
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Style="{StaticResource Text.Callout}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Brush.Text.Secondary}" />
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Padding="6,2"
                                                        CornerRadius="{StaticResource Radius.Badge}"
                                                        Background="{StaticResource Brush.Surface}"
                                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding Kind}"
                                                               Style="{StaticResource Text.Footnote}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Margin="4,6,4,2"
                                        Padding="0,6,0,0"
                                        BorderBrush="{StaticResource Brush.Border.Hairline}"
                                        BorderThickness="0,1,0,0">
                                    <Button Style="{StaticResource Style.Button.Ghost}"
                                            HorizontalContentAlignment="Left"
                                            Padding="10,7"
                                            AutomationProperties.AutomationId="Aura.Search.SeeAllHints"
                                            Command="{Binding Search.CommitSearchCommand}">
                                        <TextBlock Style="{StaticResource Text.Subheadline}"
                                                   Foreground="{StaticResource Brush.Text.Primary}">
                                            <Run Text="See all results for &quot;" />
                                            <Run Text="{Binding Search.Query, Mode=OneWay}" />
                                            <Run Text="&quot; ›" />
                                        </TextBlock>
                                    </Button>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Monochrome Window Caption Buttons (Min / Max / White-Inversion Close) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource Style.Button.WindowCaption}"
                            AutomationProperties.AutomationId="Aura.TopBar.Minimize"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize">
                        <Path Width="10" Height="1" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.2" Data="M0,0.5 L10,0.5" />
                    </Button>

                    <Button Style="{StaticResource Style.Button.WindowCaption}"
                            AutomationProperties.AutomationId="Aura.TopBar.Maximize"
                            Click="MaximizeRestoreButton_Click"
                            ToolTip="Maximize / Restore">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizeIconPath"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z" />
                            <Path x:Name="RestoreIconPath"
                                  Visibility="Collapsed"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Data="M2.5,0.5 L9.5,0.5 L9.5,7.5 M0.5,2.5 L7.5,2.5 L7.5,9.5 L0.5,9.5 Z" />
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource Style.Button.WindowClose}"
                            AutomationProperties.AutomationId="Aura.TopBar.Close"
                            Click="CloseButton_Click"
                            ToolTip="Close">
                        <Path Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3"
                              Data="M1,1 L9,9 M9,1 L1,9" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================================================================
             ROW 1: MAIN WORKSPACE (Left Rail | Center Content | Right Split Pane)
             =================================================================== -->
        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- ===============================================================
                 LEFT COLLAPSIBLE NAVIGATION RAIL (248px <-> 56px, Neutral.05)
                 =============================================================== -->
            <Border x:Name="LeftRailBorder"
                    Grid.Column="0"
                    Width="{StaticResource Width.RailExpanded}"
                    ClipToBounds="True"
                    Background="{StaticResource Brush.Rail}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="0,0,1,0">
                <Grid x:Name="LeftRailContent">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Pinned Primary & Library Navigation (never scrolled away by playlists) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Bounded Virtualized Scrollable Playlists Section (hidden in 56px compact mode) -->
                        <RowDefinition Height="*" />
                        <!-- Row 2: Pinned Bottom TOOLS Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,12,0,4">
                        <!-- Primary Landing: Home -->
                        <RadioButton Style="{StaticResource Style.NavRailItem}"
                                     GroupName="MainNav"
                                     AutomationProperties.AutomationId="Aura.Nav.Home"
                                     IsChecked="{Binding CurrentView, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Home}"
                                     ToolTip="Home">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5"
                                      Data="M1,8 L8,1.5 L15,8 M3,7 L3,14.5 L6.5,14.5 L6.5,10.5 L9.5,10.5 L9.5,14.5 L13,14.5 L13,7" />
                                <TextBlock Text="Home"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Presentation.IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Group: LIBRARY -->
                        <TextBlock Text="LIBRARY"
                                   Style="{StaticResource Text.Eyebrow}"
                                   Margin="18,16,12,6"
                                   Visibility="{Binding Presentation.IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <RadioButton Style="{StaticResource Style.NavRailItem}"
                                     GroupName="MainNav"
                                     AutomationProperties.AutomationId="Aura.Nav.Songs"
                                     IsChecked="{Binding CurrentView, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Songs|Library}"
                                     ToolTip="Songs">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5"
                                      Data="M6,13 A2,2 0 1 1 2,13 A2,2 0 1 1 6,13 M6,13 L6,3 L14,1.5 L14,11.5 M14,11.5 A2,2 0 1 1 10,11.5 A2,2 0 1 1 14,11.5" />
                                <TextBlock Text="Songs"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Presentation.IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource Style.NavRailItem}"
                                     GroupName="MainNav"
                                     AutomationProperties.AutomationId="Aura.Nav.Albums"
                                     IsChecked="{Binding CurrentView, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Albums|AlbumDetail}"
                                     ToolTip="Albums">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5"
                                      Data="M2,2 L14,2 L14,14 L2,14 Z M8,5.5 A2.5,2.5 0 1 1 8,10.5 A2.5,2.5 0 1 1 8,5.5" />
                                <TextBlock Text="Albums"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Presentation.IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource Style.NavRailItem}"
                                     GroupName="MainNav"
                                     AutomationProperties.AutomationId="Aura.Nav.Artists"
                                     IsChecked="{Binding CurrentView, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Artists|ArtistDetail}"
                                     ToolTip="Artists">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5"
                                      Data="M8,2 A3,3 0 1 1 8,8 A3,3 0 1 1 8,2 M2.5,14.5 C2.5,11.2 5,9.5 8,9.5 C11,9.5 13.5,11.2 13.5,14.5" />
                                <TextBlock Text="Artists"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Presentation.IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource Style.NavRailItem}"
                                     GroupName="MainNav"
                                     AutomationProperties.AutomationId="Aura.Nav.Playlists"
                                     IsChecked="{Binding CurrentView, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Playlists}"
                                     ToolTip="All Playlists">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5"
                                      Data="M2,3.5 L14,3.5 M2,8 L14,8 M2,12.5 L9.5,12.5" />
                                <TextBlock Text="All Playlists"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Presentation.IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Row 1: Bounded Virtualized PLAYLISTS Pane (Collapsible, Scales to 100+ Playlists, Hidden in 56px Compact Mode) -->
                    <Grid Grid.Row="1"
                          Margin="0,8,0,6"
                          Visibility="{Binding Presentation.IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="12,4,10,6"
                                Padding="6,8,0,0"
                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <ToggleButton x:Name="PlaylistsFoldToggle"
                                              IsChecked="True"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Cursor="Hand"
                                              FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                                              AutomationProperties.AutomationId="Aura.Nav.PlaylistsFold"
                                              ToolTip="Expand / Collapse Playlists">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                                <Path x:Name="Chevron"
                                                      Width="7" Height="5"
                                                      Margin="0,0,6,0"
                                                      VerticalAlignment="Center"
                                                      Stretch="Uniform"
                                                      Stroke="{StaticResource Brush.Text.Tertiary}"
                                                      StrokeThickness="1.4"
                                                      Data="M0.5,0.5 L3.5,3.5 L6.5,0.5" />
                                                <TextBlock Text="PLAYLISTS"
                                                           Style="{StaticResource Text.Eyebrow}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SavedPlaylists.Count, StringFormat=' ({0})'}"
                                                           Style="{StaticResource Text.Eyebrow}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="Chevron" Property="Data" Value="M1.5,0.5 L4.5,3.5 L1.5,6.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Button Style="{StaticResource Style.Button.Icon}"
                                        Width="22" Height="22"
                                        HorizontalAlignment="Right"
                                        Click="SidebarNewPlaylist_Click"
                                        ToolTip="New Playlist">
                                    <Path Width="10" Height="10" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5"
                                          Data="M5,1 L5,9 M1,5 L9,5" />
                                </Button>
                            </Grid>
                        </Border>

                        <ListBox x:Name="SidebarPlaylistsList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding SavedPlaylists}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,0,0,4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Visibility="{Binding IsChecked, ElementName=PlaylistsFoldToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Style.Button.Ghost}"
                                            Height="34"
                                            Margin="8,1"
                                            Padding="8,0"
                                            HorizontalContentAlignment="Stretch"
                                            AllowDrop="True"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                            DragOver="PlaylistNavItem_DragOver"
                                            DragLeave="PlaylistNavItem_DragLeave"
                                            Drop="PlaylistNavItem_Drop"
                                            AutomationProperties.AutomationId="{Binding Id, StringFormat='Aura.Nav.PlaylistItem.{0}'}"
                                            Command="{Binding DataContext.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Name}">
                                        <Button.ContextMenu>
                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                <MenuItem Header="Play Playlist"
                                                          Command="{Binding PlacementTarget.Tag.PlaySavedPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Shuffle Playlist"
                                                          Command="{Binding PlacementTarget.Tag.ShuffleSavedPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Open Playlist"
                                                          Command="{Binding PlacementTarget.Tag.OpenPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <MenuItem Header="Rename Playlist"
                                                          Command="{Binding PlacementTarget.Tag.RenamePlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                                <Separator />
                                                <MenuItem Header="Delete Playlist"
                                                          Command="{Binding PlacementTarget.Tag.DeleteSavedPlaylistCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="22" Height="22"
                                                    CornerRadius="{StaticResource Radius.Badge}"
                                                    Background="{StaticResource Brush.Surface}"
                                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                    BorderThickness="1">
                                                <Path Width="10" Height="10" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Stroke="{StaticResource Brush.Icon.Default}"
                                                      StrokeThickness="1.3"
                                                      Data="M1,2 L9,2 M1,5 L9,5 M1,8 L6,8" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}"
                                                       Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Bottom TOOLS Footer (Audio Inspector + Settings) -->
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="0,1,0,0"
                            Padding="0,8,0,8">
                        <StackPanel>
                            <TextBlock Text="TOOLS"
                                       Style="{StaticResource Text.Eyebrow}"
                                       Margin="18,2,12,6"
                                       Visibility="{Binding Presentation.IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <RadioButton Style="{StaticResource Style.NavRailItem}"
                                         GroupName="MainNav"
                                         AutomationProperties.AutomationId="Aura.Nav.Inspector"
                                         IsChecked="{Binding CurrentView, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Inspector}"
                                         ToolTip="Audio Inspector">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5"
                                          Data="M1.5,11 L4.5,11 L6.5,4 L9.5,13 L11.5,8 L14.5,8" />
                                    <TextBlock Text="Audio Inspector"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Presentation.IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource Style.NavRailItem}"
                                         GroupName="MainNav"
                                         AutomationProperties.AutomationId="Aura.Nav.Settings"
                                         IsChecked="{Binding CurrentView, Mode=TwoWay, Converter={StaticResource StringMatchToBoolConverter}, ConverterParameter=Settings}"
                                         ToolTip="Settings (Ctrl+,)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          StrokeThickness="1.5"
                                          Data="M8,5.2 A2.8,2.8 0 1 1 8,10.8 A2.8,2.8 0 1 1 8,5.2 M8,1.5 L8,3.2 M8,12.8 L8,14.5 M1.5,8 L3.2,8 M12.8,8 L14.5,8 M3.4,3.4 L4.6,4.6 M11.4,11.4 L12.6,12.6 M12.6,3.4 L11.4,4.6 M4.6,11.4 L3.4,12.6" />
                                    <TextBlock Text="Settings"
                                               Margin="12,0,0,0"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Presentation.IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ===============================================================
                 CENTER CONTENT VIEWPORT (All v2.0.0 Live Views — Zero Stubs)
                 =============================================================== -->
            <Grid x:Name="ContentStageHost"
                  Grid.Column="1"
                  Background="{StaticResource Brush.Canvas}">

                <!-- Stage 2 Live View: Home -->
                <views:HomeView Visibility="{Binding CurrentView, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Home}" />

                <!-- Stage 2 Live View: Songs (120 FPS Virtualized DataGrid + ColumnBrowser) -->
                <views:SongsView Visibility="{Binding CurrentView, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Songs|Library}" />

                <!-- Stage 2 Live View: Albums (Responsive GridG Frameless SquareLockups) -->
                <views:AlbumsView Visibility="{Binding CurrentView, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Albums}" />

                <!-- Stage 2 Live View: Artists (Master-Detail SideBySide Split) -->
                <views:ArtistsView Visibility="{Binding CurrentView, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Artists}" />

                <!-- Stage 2 Live View: All Playlists Overview -->
                <views:PlaylistsOverviewView x:Name="PlaylistsOverviewControl"
                                             Visibility="{Binding CurrentView, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Playlists}" />

                <!-- Stage 2 Live View: Playlist Detail (270x270 Hero + Sticky Header + Tracklist) -->
                <views:PlaylistDetailView Visibility="{Binding CurrentView, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=PlaylistDetail}" />

                <!-- Stage 3 Live View: Album Detail (270x270 Hero + Sticky Header + Tracklist + Footer) -->
                <views:AlbumDetailView Visibility="{Binding CurrentView, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=AlbumDetail}" />

                <!-- Stage 3 Live View: Artist Detail (220px Full-Bleed Hero + Latest Release + Featured Tracks + Albums Shelf) -->
                <views:ArtistDetailView Visibility="{Binding CurrentView, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=ArtistDetail}" />

                <!-- Stage 5 Live View: Search (Browse Bricks + Scoped Results) -->
                <views:SearchView Visibility="{Binding CurrentView, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Search}" />

                <!-- Stage 5 Live View: Full-Page Audio Inspector (Monochrome FFT Workstation) -->
                <views:InspectorView Visibility="{Binding CurrentView, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Inspector}" />

                <!-- Stage 5 Live View: Settings (34px BreadcrumbBar + 5 Categories) -->
                <views:SettingsView Visibility="{Binding CurrentView, Converter={StaticResource StringMatchToVisibilityConverter}, ConverterParameter=Settings}" />
            </Grid>

            <!-- Overlay Scrim for Right Split Pane when < 1440px -->
            <Border x:Name="RightPaneOverlayScrim"
                    Grid.Column="1"
                    Panel.ZIndex="18"
                    Background="{StaticResource Brush.Overlay.EdgeScrim}"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="RightPaneOverlayScrim_MouseLeftButtonDown" />

            <!-- ===============================================================
                 RIGHT ADAPTIVE SPLIT PANE (360px, Queue | Lyrics, Inline / Overlay)
                 =============================================================== -->
            <Border x:Name="RightSplitPaneBorder"
                    Grid.Column="2"
                    Panel.ZIndex="20"
                    Width="0"
                    ClipToBounds="True"
                    Visibility="Collapsed"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                    BorderThickness="1,0,0,0">
                <Grid x:Name="RightPaneInnerGrid"
                      Width="328"
                      HorizontalAlignment="Left"
                      Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Right Pane Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Queue Segmented Header (Playing Next | History) -->
                        <Border Grid.Column="0"
                                HorizontalAlignment="Left"
                                Padding="3"
                                CornerRadius="{StaticResource Radius.Card}"
                                Background="{StaticResource Brush.Rail}"
                                BorderBrush="{StaticResource Brush.Border.Hairline}"
                                BorderThickness="1"
                                Visibility="{Binding Presentation.IsQueuePaneActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Style.Toggle.Segmented}"
                                             GroupName="QueueTabs"
                                             AutomationProperties.AutomationId="Aura.Queue.TabPlayingNext"
                                             Content="Playing Next"
                                             IsChecked="{Binding Presentation.IsPlayingNextTab, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource Style.Toggle.Segmented}"
                                             GroupName="QueueTabs"
                                             AutomationProperties.AutomationId="Aura.Queue.TabHistory"
                                             Content="History"
                                             IsChecked="{Binding Presentation.IsHistoryTab, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <!-- Lyrics Header -->
                        <TextBlock Grid.Column="0"
                                   Text="Lyrics"
                                   Style="{StaticResource Text.Title2}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Presentation.IsLyricsPaneActive, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button Grid.Column="1"
                                Style="{StaticResource Style.Button.Icon}"
                                AutomationProperties.AutomationId="Aura.RightPane.Close"
                                Command="{Binding Presentation.CloseRightPaneCommand}"
                                ToolTip="Close Pane (Esc)">
                            <Path Width="10" Height="10" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5"
                                  Data="M1,1 L9,9 M9,1 L1,9" />
                        </Button>
                    </Grid>

                    <!-- Stage 4 Live Right-Pane Views: QueuePaneView & LyricsView -->
                    <Grid x:Name="RightPaneContentHost" Grid.Row="1">
                        <views:QueuePaneView Visibility="{Binding Presentation.IsQueuePaneActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <views:LyricsView IsFullScreenMode="False"
                                          AutomationProperties.AutomationId="Aura.Lyrics.List"
                                          Visibility="{Binding Presentation.IsLyricsPaneActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ===============================================================
                 FLOATING INSET ROUNDED BOTTOM DOCK CAPSULE (Decision 1)
                 Scoped strictly to Column 1 (content area right of Left Rail):
                 Margin=16,0,16,16 | Height=72 | CornerRadius=20
                 =============================================================== -->
            <Border x:Name="FloatingDockCapsule"
                    Grid.Column="1"
                    Panel.ZIndex="15"
                    VerticalAlignment="Bottom"
                    Height="{StaticResource Height.BottomDock}"
                    Margin="{StaticResource Margin.DockCapsule}"
                    CornerRadius="{StaticResource Radius.DockCapsule}"
                    Background="{StaticResource Brush.DockBackground}"
                    BorderBrush="{StaticResource Brush.Border.Control}"
                    BorderThickness="1">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- COL 0 (3*): TRANSPORT CLUSTER (Shuffle | Prev | Play/Pause | Next | Repeat) -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0">

                        <!-- Shuffle with 3x3 active indicator dot -->
                        <Button Style="{StaticResource Style.Button.Icon}"
                                AutomationProperties.AutomationId="Aura.Dock.Shuffle"
                                Command="{Binding ToggleShuffleCommand}"
                                ToolTip="{Binding ShuffleToolTip}">
                            <Grid>
                                <Path Width="15" Height="13" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      Data="M1,3 L4.5,3 L10.5,10 L14,10 M11.5,7.8 L14,10 L11.5,12.2 M1,10 L4.5,10 L6.5,7.6 M8.8,5 L10.5,3 L14,3 M11.5,0.8 L14,3 L11.5,5.2" />
                                <Ellipse Width="3" Height="3"
                                         Margin="0,0,0,-8"
                                         VerticalAlignment="Bottom"
                                         HorizontalAlignment="Center"
                                         Fill="{StaticResource Brush.Icon.Active}"
                                         Visibility="{Binding IsShuffleEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>

                        <!-- Previous -->
                        <Button Style="{StaticResource Style.Button.Icon}"
                                Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Aura.Dock.Previous"
                                Command="{Binding PreviousTrackCommand}"
                                ToolTip="Previous Track (Ctrl+Left)">
                            <Path Width="14" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M0,1 L2,1 L2,11 L0,11 Z M13,1 L4,6 L13,11 Z" />
                        </Button>

                        <!-- Primary Play / Pause (36x36 Solid White Circle / Pure Black Icon) -->
                        <Button Style="{StaticResource Style.Button.RoundPlay}"
                                Margin="8,0"
                                AutomationProperties.AutomationId="Aura.Dock.PlayPause"
                                Command="{Binding TogglePlayPauseCommand}"
                                ToolTip="Play / Pause (Space)">
                            <Grid>
                                <Path Width="13" Height="14" Margin="2,0,0,0" Stretch="Uniform"
                                      Fill="{StaticResource Brush.Icon.OnWhite}"
                                      Data="M1,0.5 L12,7 L1,13.5 Z"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />
                                <Path Width="12" Height="14" Stretch="Uniform"
                                      Fill="{StaticResource Brush.Icon.OnWhite}"
                                      Data="M1,1 L4.5,1 L4.5,13 L1,13 Z M7.5,1 L11,1 L11,13 L7.5,13 Z"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>

                        <!-- Next -->
                        <Button Style="{StaticResource Style.Button.Icon}"
                                Margin="0,0,4,0"
                                AutomationProperties.AutomationId="Aura.Dock.Next"
                                Command="{Binding NextTrackCommand}"
                                ToolTip="Next Track (Ctrl+Right)">
                            <Path Width="14" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M1,1 L10,6 L1,11 Z M12,1 L14,1 L14,11 L12,11 Z" />
                        </Button>

                        <!-- Repeat with 3x3 active indicator dot & Repeat-1 badge -->
                        <Button Style="{StaticResource Style.Button.Icon}"
                                AutomationProperties.AutomationId="Aura.Dock.Repeat"
                                Command="{Binding ToggleRepeatCommand}"
                                ToolTip="{Binding RepeatToolTip}">
                            <Grid>
                                <Path Width="15" Height="13" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.4"
                                      Data="M11.5,1 L14,3.2 L11.5,5.4 M2,6.5 L2,4.5 C2,3.7 2.7,3.2 3.5,3.2 L13.5,3.2 M3.5,12 L1,9.8 L3.5,7.6 M13,6.5 L13,8.5 C13,9.3 12.3,9.8 11.5,9.8 L1.5,9.8" />
                                <TextBlock Text="1"
                                           FontSize="7"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.Icon.Active}"
                                           Visibility="{Binding IsRepeatOne, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Ellipse Width="3" Height="3"
                                         Margin="0,0,0,-8"
                                         VerticalAlignment="Bottom"
                                         HorizontalAlignment="Center"
                                         Fill="{StaticResource Brush.Icon.Active}"
                                         Visibility="{Binding IsRepeatActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- COL 1 (*): MONOCHROME LCD CAPSULE (54x54 Rounded Art + Track + AudioBadge + Elastic Scrubber) -->
                    <Border Grid.Column="1"
                            Height="60"
                            MaxWidth="560"
                            Margin="14,0"
                            Padding="3"
                            VerticalAlignment="Center"
                            CornerRadius="{StaticResource Radius.Sheet}"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border.Hairline}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 54x54 Album Artwork Button (Concentric CornerRadius=9 via ImageBrush, retains full natural color) -->
                            <Button Grid.Column="0"
                                    Width="54" Height="54"
                                    Padding="0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                                    AutomationProperties.AutomationId="Aura.Dock.LcdArtwork"
                                    Command="{Binding Presentation.ToggleFullScreenCommand}"
                                    ToolTip="Open Full-Screen Player (Ctrl+Shift+F)">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Grid Width="54" Height="54">
                                            <!-- Rounded fallback container -->
                                            <Border CornerRadius="9"
                                                    Background="{StaticResource Brush.Elevated}"
                                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                    BorderThickness="1">
                                                <Path Width="18" Height="18" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Stroke="{StaticResource Brush.Icon.Muted}"
                                                      StrokeThickness="1.5"
                                                      Data="M6,14 A2,2 0 1 1 2,14 A2,2 0 1 1 6,14 M6,14 L6,3 L15,1.5 L15,12 M15,12 A2,2 0 1 1 11,12 A2,2 0 1 1 15,12" />
                                            </Border>
                                            <!-- True anti-aliased rounded artwork fill (ImageBrush respects CornerRadius!) -->
                                            <Border CornerRadius="9"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    BorderBrush="{StaticResource Brush.Border.Hairline}"
                                                    BorderThickness="1">
                                                <Border.Background>
                                                    <ImageBrush Stretch="UniformToFill"
                                                                ImageSource="{Binding CurrentTrack.CoverArtCacheKey, Converter={StaticResource CoverArtConverter}, ConverterParameter=Mini}" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Track Title/Artist + Compact AudioBadge + Elastic Scrubber -->
                            <Grid Grid.Column="1" Margin="10,2,8,2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource Text.Subheadline}"
                                                   Foreground="{StaticResource Brush.Text.Peak}"
                                                   Text="{Binding CurrentTrack.Title, TargetNullValue='AuraAudio Ready', FallbackValue='AuraAudio Ready'}" />
                                        <TextBlock Style="{StaticResource Text.Callout}"
                                                   FontSize="11"
                                                   Text="{Binding CurrentTrack.Artist, TargetNullValue='Select a track to begin bit-perfect playback', FallbackValue='Select a track to begin bit-perfect playback'}" />
                                    </StackPanel>

                                    <!-- Compact Monochrome AudioBadge + SignalPathFlyout Popover -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Button x:Name="DockAudioBadgeButton"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="Aura.Dock.AudioBadge"
                                                Command="{Binding Presentation.ToggleSignalPathFlyoutCommand}"
                                                ToolTip="Bit-Perfect Signal Path"
                                                Cursor="Hand"
                                                FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BadgeBd"
                                                            Padding="6,2"
                                                            CornerRadius="{StaticResource Radius.Badge}"
                                                            Background="{StaticResource Brush.Elevated}"
                                                            BorderBrush="{StaticResource Brush.Border.Control}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding LcdSpecBadge}"
                                                                   Style="{StaticResource Text.TabularMono}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.Text.Primary}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BadgeBd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Popup IsOpen="{Binding Presentation.IsSignalPathFlyoutOpen, Mode=TwoWay}"
                                               PlacementTarget="{Binding ElementName=DockAudioBadgeButton}"
                                               Placement="Top"
                                               VerticalOffset="-12"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <controls:SignalPathFlyout DataContext="{Binding}" />
                                        </Popup>
                                    </Grid>
                                </Grid>

                                <!-- Elapsed | Elastic Monochrome Scrubber | Total -->
                                <Grid Grid.Row="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource Text.TabularMono}"
                                               FontSize="10"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding CurrentTime, Converter={StaticResource TimeSpanToStringConverter}}" />

                                    <Slider x:Name="DockScrubber"
                                            Grid.Column="1"
                                            Style="{StaticResource Style.Slider.MonochromeScrubber}"
                                            AutomationProperties.AutomationId="Aura.Dock.Scrubber"
                                            helpers:FluidBehaviors.EnableDirectScrub="True"
                                            Minimum="0"
                                            Maximum="{Binding SeekSliderMaximum}"
                                            Value="{Binding SeekSliderValue, Mode=TwoWay}"
                                            Thumb.DragStarted="DockScrubber_DragStarted"
                                            Thumb.DragCompleted="DockScrubber_DragCompleted"
                                            PreviewMouseLeftButtonDown="DockScrubber_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="DockScrubber_PreviewMouseLeftButtonUp" />

                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource Text.TabularMono}"
                                               FontSize="10"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Text="{Binding TotalTime, Converter={StaticResource TimeSpanToStringConverter}}" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- COL 2 (3*): UTILITY CLUSTER (Volume | Info | Lyrics | Queue | Mini | Full-Screen) -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0">

                        <!-- Volume Toggle + Pure Monochrome Flyout Popup -->
                        <Grid>
                            <ToggleButton x:Name="VolumeToggleBtn"
                                          Style="{StaticResource Style.Toggle.Dock}"
                                          AutomationProperties.AutomationId="Aura.Dock.Volume"
                                          ToolTip="Volume">
                                <Path Width="15" Height="13" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                      StrokeThickness="1.4">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M1,4.5 L4,4.5 L8,1.5 L8,11.5 L4,8.5 L1,8.5 Z M11,4 C12.5,5.3 12.5,7.7 11,9 M13,2 C15.5,4.3 15.5,8.7 13,11" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSoundMuted}" Value="True">
                                                    <Setter Property="Data" Value="M1,4.5 L4,4.5 L8,1.5 L8,11.5 L4,8.5 L1,8.5 Z M10.5,4.2 L14.5,8.8 M14.5,4.2 L10.5,8.8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </ToggleButton>

                            <Popup IsOpen="{Binding IsChecked, ElementName=VolumeToggleBtn, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=VolumeToggleBtn}"
                                   Placement="Top"
                                   VerticalOffset="-10"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Width="196"
                                        Padding="12,10"
                                        CornerRadius="{StaticResource Radius.Sheet}"
                                        Background="{StaticResource Brush.Elevated}"
                                        BorderBrush="{StaticResource Brush.Border.Control}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource Style.Button.Icon}"
                                                Width="26" Height="26"
                                                Command="{Binding ToggleMuteCommand}"
                                                ToolTip="Mute / Unmute (M)">
                                            <Path Width="13" Height="11" Stretch="Uniform"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.4"
                                                  Data="M1,3.5 L3.8,3.5 L7.5,1 L7.5,10 L3.8,7.5 L1,7.5 Z" />
                                        </Button>
                                        <Slider Grid.Column="1"
                                                Margin="8,0"
                                                Style="{StaticResource Style.Slider.MonochromeVolume}"
                                                Minimum="0"
                                                Maximum="1"
                                                Value="{Binding Volume, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource Text.TabularMono}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Volume, StringFormat={}{0:P0}}" />
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Get Info (Ctrl+I) -->
                        <Button Style="{StaticResource Style.Button.Icon}"
                                Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Aura.Dock.Info"
                                Command="{Binding OpenInfoForTrackCommand}"
                                ToolTip="Get Info (Ctrl+I)">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  Data="M8,1.5 A6.5,6.5 0 1 1 8,14.5 A6.5,6.5 0 1 1 8,1.5 M8,7 L8,11.2 M8,4.6 L8,5.2" />
                        </Button>

                        <!-- Lyrics Right Pane Toggle (Ctrl+Shift+L) -->
                        <ToggleButton Style="{StaticResource Style.Toggle.Dock}"
                                      Margin="4,0,0,0"
                                      AutomationProperties.AutomationId="Aura.Dock.Lyrics"
                                      IsChecked="{Binding Presentation.IsLyricsPaneActive, Mode=TwoWay}"
                                      ToolTip="Lyrics (Ctrl+Shift+L)">
                            <Path Width="15" Height="14" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.4"
                                  Data="M2,2 L14,2 L14,10.5 L7,10.5 L4,13 L4,10.5 L2,10.5 Z M5,5.2 L11,5.2 M5,7.8 L9.5,7.8" />
                        </ToggleButton>

                        <!-- Queue Right Pane Toggle (Ctrl+U) -->
                        <ToggleButton Style="{StaticResource Style.Toggle.Dock}"
                                      Margin="4,0,0,0"
                                      AutomationProperties.AutomationId="Aura.Dock.Queue"
                                      IsChecked="{Binding Presentation.IsQueuePaneActive, Mode=TwoWay}"
                                      ToolTip="Playing Next Queue (Ctrl+U)">
                            <Path Width="15" Height="13" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                  StrokeThickness="1.4"
                                  Data="M1,2.5 L14,2.5 M1,6.5 L14,6.5 M1,10.5 L9,10.5 M11.5,8.5 L14.5,10.5 L11.5,12.5 Z" />
                        </ToggleButton>

                        <!-- Mini-Player (Ctrl+Shift+M) -->
                        <Button Style="{StaticResource Style.Button.Icon}"
                                Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Aura.Dock.MiniPlayer"
                                Command="{Binding Presentation.ToggleMiniPlayerCommand}"
                                ToolTip="Mini-Player (Ctrl+Shift+M)">
                            <Path Width="15" Height="13" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  Data="M1.5,2 L14.5,2 L14.5,11.5 L1.5,11.5 Z M8,6.5 L13,6.5 L13,10 L8,10 Z" />
                        </Button>

                        <!-- Full-Screen Stage (Ctrl+Shift+F) -->
                        <Button Style="{StaticResource Style.Button.Icon}"
                                Margin="4,0,0,0"
                                AutomationProperties.AutomationId="Aura.Dock.FullScreen"
                                Command="{Binding Presentation.ToggleFullScreenCommand}"
                                ToolTip="Full-Screen Player (Ctrl+Shift+F)">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4"
                                  Data="M1,5 L1,1 L5,1 M9,1 L13,1 L13,5 M13,9 L13,13 L9,13 M5,13 L1,13 L1,9" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================================================================
             OVERLAY LAYER 1: FULL-SCREEN NOW PLAYING STAGE (Hides All Chrome)
             =================================================================== -->
        <views:FullScreenPlayerView x:Name="FullScreenStageOverlay"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Panel.ZIndex="40"
                                    Visibility="Collapsed" />

        <!-- ===================================================================
             OVERLAY LAYER 2: MONOCHROME MODAL SHEETS (Above Full-Screen Stage!)
             =================================================================== -->
        <views:InfoInspectorSheet x:Name="InfoInspectorSheetOverlay"
                                  Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Panel.ZIndex="60"
                                  Visibility="Collapsed" />

        <views:AddToPlaylistSheet x:Name="AddToPlaylistSheetOverlay"
                                  Grid.Row="0"
                                  Grid.RowSpan="2"
                                  Panel.ZIndex="61"
                                  Visibility="Collapsed" />

        <views:RenamePlaylistSheet x:Name="RenamePlaylistSheetOverlay"
                                   Grid.Row="0"
                                   Grid.RowSpan="2"
                                   Panel.ZIndex="62"
                                   Visibility="Collapsed" />
    </Grid>
</Window>
