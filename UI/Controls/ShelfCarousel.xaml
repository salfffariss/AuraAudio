<UserControl x:Class="AuraAudio.UI.Controls.ShelfCarousel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Clickable Chevron Section Header (Title2 17px Bold + '›') -->
        <Button Grid.Row="0"
                HorizontalAlignment="Left"
                Margin="0,0,0,12"
                Cursor="Hand"
                FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                Command="{Binding HeaderCommand, ElementName=Root}"
                CommandParameter="{Binding HeaderCommandParameter, ElementName=Root}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="TitleText"
                                   Text="{Binding HeaderTitle, ElementName=Root}"
                                   Style="{StaticResource Text.Title2}"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ChevronText"
                                   Text="›"
                                   Margin="6,-1,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text.Tertiary}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                            <Setter TargetName="TitleText" Property="TextDecorations" Value="Underline" />
                            <Setter TargetName="ChevronText" Property="Foreground" Value="{StaticResource Brush.Text.Peak}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Horizontal Virtualized Carousel + Hover-Revealed Edge Paging Arrows -->
        <Grid Grid.Row="1"
              MouseEnter="CarouselArea_MouseEnter"
              MouseLeave="CarouselArea_MouseLeave">
            <ScrollViewer x:Name="ShelfScroll"
                          Focusable="False"
                          FocusVisualStyle="{x:Null}"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          ScrollChanged="ShelfScroll_ScrollChanged"
                          PreviewMouseWheel="ShelfScroll_PreviewMouseWheel">
                <ItemsControl Padding="0,0,0,4"
                              ItemsSource="{Binding ItemsSource, ElementName=Root}"
                              ItemTemplate="{Binding ItemTemplate, ElementName=Root}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"
                                                    IsVirtualizing="True"
                                                    VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <!-- Left Paging Arrow -->
            <Button x:Name="LeftArrowBtn"
                    Width="32" Height="32"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="6,0,0,28"
                    Opacity="0"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                    helpers:FluidBehaviors.EnablePressScale="True"
                    Click="ScrollLeft_Click"
                    ToolTip="Scroll Left">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="16"
                                Background="{StaticResource Brush.Elevated}"
                                BorderBrush="{StaticResource Brush.Border.Control}"
                                BorderThickness="1">
                            <Path Width="7" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{StaticResource Brush.Icon.Active}"
                                  StrokeThickness="1.6"
                                  Data="M6,1 L1,6 L6,11" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SelectedRow}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Right Paging Arrow -->
            <Button x:Name="RightArrowBtn"
                    Width="32" Height="32"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,6,28"
                    Opacity="0"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    FocusVisualStyle="{StaticResource Style.FocusVisual.Monochrome}"
                    helpers:FluidBehaviors.EnablePressScale="True"
                    Click="ScrollRight_Click"
                    ToolTip="Scroll Right">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="16"
                                Background="{StaticResource Brush.Elevated}"
                                BorderBrush="{StaticResource Brush.Border.Control}"
                                BorderThickness="1">
                            <Path Width="7" Height="12" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{StaticResource Brush.Icon.Active}"
                                  StrokeThickness="1.6"
                                  Data="M1,1 L6,6 L1,11" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.SelectedRow}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>
