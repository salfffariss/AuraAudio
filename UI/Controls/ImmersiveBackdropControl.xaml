<UserControl x:Class="AuraAudio.UI.Controls.ImmersiveBackdropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False"
             Focusable="False"
             ClipToBounds="True"
             UseLayoutRounding="False"
             Background="{StaticResource Brush.Rail}">

    <Grid x:Name="BackdropRoot" ClipToBounds="True" UseLayoutRounding="False">
        <!-- Layer A (A/B Cross-Fade Pair) -->
        <Grid x:Name="LayerA" Opacity="1.0" ClipToBounds="True" UseLayoutRounding="False">
            <Rectangle x:Name="BaseRectA" Fill="{StaticResource Brush.Rail}" />
            <Canvas x:Name="BlobsCanvasA" ClipToBounds="True" UseLayoutRounding="False">
                <Ellipse x:Name="BlobA1" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BlobA1Scale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="BlobA1Rotate" Angle="0" />
                            <TranslateTransform x:Name="BlobA1Translate" X="0" Y="0" />
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BlobA2" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BlobA2Scale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="BlobA2Rotate" Angle="0" />
                            <TranslateTransform x:Name="BlobA2Translate" X="0" Y="0" />
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BlobA3" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BlobA3Scale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="BlobA3Rotate" Angle="0" />
                            <TranslateTransform x:Name="BlobA3Translate" X="0" Y="0" />
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Layer B (A/B Cross-Fade Pair) -->
        <Grid x:Name="LayerB" Opacity="0.0" ClipToBounds="True" UseLayoutRounding="False">
            <Rectangle x:Name="BaseRectB" Fill="{StaticResource Brush.Rail}" />
            <Canvas x:Name="BlobsCanvasB" ClipToBounds="True" UseLayoutRounding="False">
                <Ellipse x:Name="BlobB1" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BlobB1Scale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="BlobB1Rotate" Angle="0" />
                            <TranslateTransform x:Name="BlobB1Translate" X="0" Y="0" />
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BlobB2" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BlobB2Scale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="BlobB2Rotate" Angle="0" />
                            <TranslateTransform x:Name="BlobB2Translate" X="0" Y="0" />
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BlobB3" RenderTransformOrigin="0.5,0.5" UseLayoutRounding="False">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BlobB3Scale" ScaleX="1" ScaleY="1" />
                            <RotateTransform x:Name="BlobB3Rotate" Angle="0" />
                            <TranslateTransform x:Name="BlobB3Translate" X="0" Y="0" />
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- Pure-Neutral Black Readability Scrim (Strictly Above Blobs, Below All UI) -->
        <Rectangle x:Name="ScrimOverlay"
                   Fill="{StaticResource Brush.Overlay.BackdropScrim}"
                   IsHitTestVisible="False" />

        <!-- Optional Spatially Varying Pure-Black Scrim Layers (Collapsed under SafeDefault / uniform presets) -->
        <Rectangle x:Name="SpatialScrimTop"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />
        <Rectangle x:Name="SpatialScrimLyrics"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />
        <Rectangle x:Name="SpatialScrimBottom"
                   Visibility="Collapsed"
                   IsHitTestVisible="False" />
    </Grid>
</UserControl>
