<UserControl x:Class="AuraAudio.UI.Controls.BouncyBarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="16"
             Height="14"
             IsHitTestVisible="False">
    <Grid VerticalAlignment="Bottom" Height="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Bar1" Grid.Column="0" Width="2.5" Height="6" VerticalAlignment="Bottom" CornerRadius="1"
                Background="{StaticResource Brush.Icon.Active}" />
        <Border x:Name="Bar2" Grid.Column="1" Width="2.5" Height="12" VerticalAlignment="Bottom" CornerRadius="1"
                Background="{StaticResource Brush.Icon.Active}" />
        <Border x:Name="Bar3" Grid.Column="2" Width="2.5" Height="8" VerticalAlignment="Bottom" CornerRadius="1"
                Background="{StaticResource Brush.Icon.Active}" />
        <Border x:Name="Bar4" Grid.Column="3" Width="2.5" Height="10" VerticalAlignment="Bottom" CornerRadius="1"
                Background="{StaticResource Brush.Icon.Active}" />
    </Grid>
</UserControl>
