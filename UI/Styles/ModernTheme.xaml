<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers">

    <!-- Value Converters -->
    <helpers:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
    <helpers:HexToBrushConverter x:Key="HexToBrushConverter" />
    <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <helpers:CoverArtConverter x:Key="CoverArtConverter" />
    <helpers:StringMatchToVisibilityConverter x:Key="StringMatchToVisibilityConverter" />
    <helpers:BooleanToStringConverter x:Key="BooleanToStringConverter" />
    <helpers:StringMatchToBrushConverter x:Key="StringMatchToBrushConverter" />
    <helpers:NumberToVisibilityConverter x:Key="NumberToVisibilityConverter" />
    <helpers:OneBasedIndexConverter x:Key="OneBasedIndexConverter" />
    <helpers:StringEqualsMultiConverter x:Key="StringEqualsMultiConverter" />

    <!-- Fonts -->
    <FontFamily x:Key="FontFamily.Primary">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamily.Mono">Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- Studio Precision Palette (WCAG AA Verified) -->
    <SolidColorBrush x:Key="Brush.Background.Window" Color="#111114" />
    <SolidColorBrush x:Key="Brush.Background.Sidebar" Color="#141418" />
    <SolidColorBrush x:Key="Brush.Background.PlayerBar" Color="#141418" />
    <SolidColorBrush x:Key="Brush.Background.Card" Color="#17171C" />
    <SolidColorBrush x:Key="Brush.Background.CardHover" Color="#1E1E25" />
    <SolidColorBrush x:Key="Brush.Background.Input" Color="#15151A" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#282832" />
    <SolidColorBrush x:Key="Brush.Border.Light" Color="#6E6C7A" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#F5F2EB" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#B8B4AA" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#949087" />

    <!-- Single Deliberate Amber Accent & Semantic Status Brushes -->
    <SolidColorBrush x:Key="Brush.Accent.Gold" Color="#E5A23C" />
    <SolidColorBrush x:Key="Brush.Accent.GoldHover" Color="#F0B24F" />
    <SolidColorBrush x:Key="Brush.Accent.Cyan" Color="#93C5FD" />
    <SolidColorBrush x:Key="Brush.Accent.Teal" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Accent.Red" Color="#F87171" />
    <SolidColorBrush x:Key="Brush.Accent.Green" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Accent.Warning" Color="#FBBF24" />

    <!-- Clean Monochrome Vector Icon Geometries (1.5px stroke or crisp fill) -->
    <StreamGeometry x:Key="Icon.MusicNote">M9,18V5l12-2v13 M9,18a3,3 0 1,1-6,0 3,3 0 0,1 6,0z M21,16a3,3 0 1,1-6,0 3,3 0 0,1 6,0z</StreamGeometry>
