    <StreamGeometry x:Key="Icon.Globe">M12,2a10,10 0 1,0 0,20 10,10 0 1,0 0,-20z M2,12h20 M12,2a14,14 0 0,1 0,20 M12,2a14,14 0 0,0 0,20</StreamGeometry>
    <StreamGeometry x:Key="Icon.Refresh">M21,12a9,9 0 1,1-2.64-6.36 M21,3v6h-6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Play">M5,3 L19,12 L5,21 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Pause">M6,4 L10,4 L10,20 L6,20 Z M14,4 L18,4 L18,20 L14,20 Z</StreamGeometry>
