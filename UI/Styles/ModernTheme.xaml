    <StreamGeometry x:Key="Icon.Prev">M19,4 L9,12 L19,20 Z M5,4 L7,4 L7,20 L5,20 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.Next">M5,4 L15,12 L5,20 Z M17,4 L19,4 L19,20 L17,20 Z</StreamGeometry>
