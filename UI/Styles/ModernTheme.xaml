    <StreamGeometry x:Key="Icon.Artist">M12,12a4,4 0 1,0 0-8 4,4 0 0,0 0,8z M4,20c0-3.3 3.6-6 8-6s8,2.7 8,6</StreamGeometry>
    <StreamGeometry x:Key="Icon.Queue">M4,6h16 M4,12h12 M4,18h8 M17,14v6l4-3-4-3z</StreamGeometry>
