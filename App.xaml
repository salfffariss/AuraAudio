<Application x:Class="AuraAudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:AuraAudio.UI.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Single Source of Monochrome Color Truth (R = G = B) -->
                <ResourceDictionary Source="/UI/Tokens/NeutralTokens.xaml" />
                <!-- 2. App-Scope SystemColors & Focus Overrides (Zero Windows Accent Bleed) -->
                <ResourceDictionary Source="/UI/Tokens/SystemOverrides.xaml" />
                <!-- 3. Spatial Metrics, Radii & Shell Dimensions -->
                <ResourceDictionary Source="/UI/Tokens/Metrics.xaml" />
                <!-- 4. Typography Scale -->
                <ResourceDictionary Source="/UI/Tokens/Typography.xaml" />
                <!-- 5. Motion & Spring Timing Tokens -->
                <ResourceDictionary Source="/UI/Tokens/Motion.xaml" />
                <!-- 6. Pure-Monochrome Control Templates -->
                <ResourceDictionary Source="/UI/Styles/Controls.xaml" />
                <!-- 7. Localization Dictionary (URI contains "Strings." for LocalizationManager) -->
                <ResourceDictionary Source="/UI/Resources/Strings.id.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Pure Logic Value Converters (Zero Brush Converters) -->
            <helpers:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
            <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <helpers:StringMatchToVisibilityConverter x:Key="StringMatchToVisibilityConverter" />
            <helpers:StringMatchToBoolConverter x:Key="StringMatchToBoolConverter" />
            <helpers:InvertBoolConverter x:Key="InvertBoolConverter" />
            <helpers:BooleanToStringConverter x:Key="BooleanToStringConverter" />
            <helpers:NumberToVisibilityConverter x:Key="NumberToVisibilityConverter" />
            <helpers:OneBasedIndexConverter x:Key="OneBasedIndexConverter" />
            <helpers:StringEqualsMultiConverter x:Key="StringEqualsMultiConverter" />
            <helpers:SortIndicatorVisibilityConverter x:Key="SortIndicatorVisibilityConverter" />
            <helpers:ActiveTrackPlayingMultiConverter x:Key="ActiveTrackPlayingMultiConverter" />
            <helpers:CoverArtConverter x:Key="CoverArtConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
