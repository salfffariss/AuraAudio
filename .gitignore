## =========================================================================
## .gitignore for AuraAudio (.NET 9 / WPF / SQLite)
## =========================================================================

# Build Outputs & Compilation Binaries
[Bb]in/
[Oo]bj/
publish*/
dist/
artifacts/
*.exe
*.zip
!Assets/*.ico

# Internal Process & Research Docs (Kept Locally Only)
docs/internal/
REVIEW_CONTEXT_*.md

# Visual Studio, Rider, VS Code & User IDE State
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# Agent & Scratch Directories
.gemini/
.claude/
.cursor/
scratch/

# Local User Databases, Cache & Runtime Data
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
Cache/

# Logs, Crash Dumps & Temporary Test Artifacts
*.log
*.dmp
crash.log
aura_crash.log
aura_startup_error.log
test_lib_result.txt
test_output.txt
hasil_test*.txt
*.bak
*.txt.bak
Program.cs.bak
icon_preview.png
inspect_*.ps1

# Local Copyrighted / Personal Audio Test Corpora
tests/authenticity/source/

# OS Generated Files
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
